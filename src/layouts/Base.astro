---
// Base.astro — the HTML shell used by every page (§10.1).
// Props mirror §13.1 core meta: unique <title>, description, canonical,
// Open Graph (default og:image = /assets/worksheets-icon.png), optional
// robots override (noindex for /search), optional JSON-LD script(s), and an
// optional leaderboard flag (home/libraries/worksheet-detail only, §14).
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ADSENSE_PUBLISHER_ID, GA_ID, SITE_NAME } from '../data/site';
import { absoluteUrl, escapeJsonLd, makeTitle } from '../lib/seo';

interface Props {
    /** e.g. "Free Printable Worksheets & Question Papers for Kids". */
    pageTitle: string;
    /** Unique meta description. */
    description: string;
    /** Canonical path WITHOUT trailing slash, e.g. "/", "/worksheets/page/2". */
    path: string;
    /** For /search — robots noindex,follow (§11.4). */
    noindex?: boolean;
    /** og:image path (default: /assets/worksheets-icon.png). */
    ogImage?: string;
    /** Optional raw JSON-LD object(s) to serialize into <script> tags. */
    jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
    /** When a worksheet image is landscape (print CSS). */
    printLandscape?: boolean;
    /** Show the 728×90 leaderboard below the nav (home/lib/detail only). */
    showLeaderboard?: boolean;
}
const {
    pageTitle,
    description,
    path,
    noindex = false,
    ogImage = '/assets/worksheets-icon.png',
    jsonLd,
    printLandscape = false,
    showLeaderboard = false,
} = Astro.props;

const canonical = absoluteUrl(path);
const ogUrl = absoluteUrl(ogImage);
const title = makeTitle(pageTitle);
const ldBlocks: Array<Record<string, unknown>> = Array.isArray(jsonLd)
    ? jsonLd
    : jsonLd
      ? [jsonLd]
      : [];

// Head-theme snippet — applies saved/system theme before first paint (no FOUC).
const headTheme = `(function(){try{var t=localStorage.getItem('fkwTheme');var m=window.matchMedia('(prefers-color-scheme: dark)');var d=t==='dark'||(t!=='light'&&m.matches)?'dark':'light';document.documentElement.setAttribute('data-theme',d);}catch(e){}})();`;
const gaScript = GA_ID
    ? `<script async src="https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(GA_ID)}"><\/script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${encodeURIComponent(GA_ID)}');<\/script>`
    : '';
const adsenseScript = ADSENSE_PUBLISHER_ID
    ? `<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-${encodeURIComponent(ADSENSE_PUBLISHER_ID)}" crossorigin="anonymous"><\/script>`
    : '';
---

<!doctype html>
<html lang="en" class={printLandscape ? 'print-landscape' : undefined}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <!-- Open Graph (§13.1) -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogUrl} />
        <meta name="twitter:card" content="summary_large_image" />

        {noindex && <meta name="robots" content="noindex,follow" />}

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" href="/assets/worksheets-icon.png" />

        <!-- Google Fonts: Baloo 2 (600/700/800) (§2.3) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&display=swap"
            rel="stylesheet"
        />

        <!-- Inline head-theme script: apply saved/system theme pre-paint -->
        <script set:html={headTheme}></script>

        {gaScript && <Fragment set:html={gaScript} />}
        {adsenseScript && <Fragment set:html={adsenseScript} />}

        {ldBlocks.map((block) => (
            <script
                type="application/ld+json"
                set:html={escapeJsonLd(JSON.stringify(block))}
            ></script>
        ))}
    </head>
    <body
        class="flex min-h-screen flex-col bg-slate-50 text-slate-800 dark:bg-slate-900 dark:text-slate-200"
    >
        <SiteNav path={path} />

        {showLeaderboard && (
            <div class="no-print mx-auto mt-4 w-full max-w-7xl px-4">
                <div class="ad-slot h-24 w-full sm:h-20">
                    <span class="ad-label">Advertisement</span>
                    <span class="text-xs">
                        728×90 leaderboard · ad network goes live post-dev
                    </span>
                </div>
            </div>
        )}

        <main class="flex-1">
            <slot />
        </main>

        <SiteFooter />

        <!-- Body-level after-footer hooks: sticky footer ad + popup (§14) -->
        <slot name="after-footer" />
    </body>
</html>
