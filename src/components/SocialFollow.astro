const BRAND_HOVER_STYLES: Record<string, string> = {
    facebook:
        'hover:text-[#1877F2] hover:border-[#1877F2]/50 hover:bg-[#1877F2]/10 dark:hover:text-[#1877F2] dark:hover:border-[#1877F2]/60 dark:hover:bg-[#1877F2]/20 hover:shadow-[0_4px_12px_-2px_rgba(24,119,242,0.25)]',
    instagram:
        'hover:text-[#E4405F] hover:border-[#E4405F]/50 hover:bg-[#E4405F]/10 dark:hover:text-[#E4405F] dark:hover:border-[#E4405F]/60 dark:hover:bg-[#E4405F]/20 hover:shadow-[0_4px_12px_-2px_rgba(228,64,95,0.25)]',
    tiktok:
        'hover:text-neutral-900 hover:border-neutral-900/40 hover:bg-neutral-900/10 dark:hover:text-white dark:hover:border-white/50 dark:hover:bg-white/20 hover:shadow-[0_4px_12px_-2px_rgba(0,0,0,0.2)]',
