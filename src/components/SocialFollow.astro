---
// SocialFollow.astro — interactive social media follow icons for
// Facebook, Instagram, TikTok, YouTube, and Pinterest.
// Styled with Geist tokens, brand hover accents, and accessible tooltips.
import { SOCIAL_LINKS } from '../data/site';

interface Props {
    /** Optional section heading (default: "Follow on"). */
    heading?: string;
    /** Whether to render the heading eyebrow (default: true). */
    showHeading?: boolean;
    /** Icon size: 'sm' (h-4 w-4), 'md' (h-5 w-5), or 'lg' (h-6 w-6). */
    size?: 'sm' | 'md' | 'lg';
    /** Whether to show text labels next to the icons. */
    showLabels?: boolean;
    /** Extra classes on the outer wrapper. */
    class?: string;
}

const {
    heading = 'Follow on',
    showHeading = true,
    size = 'md',
    showLabels = false,
    class: className = '',
} = Astro.props;

const sizeClasses = {
    sm: {
        btn: 'h-8 w-8',
        icon: 'h-3.5 w-3.5',
    },
    md: {
        btn: 'h-9 w-9',
        icon: 'h-4 w-4',
    },
    lg: {
        btn: 'h-10 w-10',
        icon: 'h-5 w-5',
    },
}[size];

// Official brand vector SVG paths (viewBox 0 0 24 24)
