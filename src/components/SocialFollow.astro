    pinterest:
        'hover:text-[#BD081C] hover:border-[#BD081C]/50 hover:bg-[#BD081C]/10 dark:hover:text-[#BD081C] dark:hover:border-[#BD081C]/60 dark:hover:bg-[#BD081C]/20 hover:shadow-[0_4px_12px_-2px_rgba(189,8,28,0.25)]',
};
---

<div class:list={['social-follow', className]}>
    {showHeading && (
        <h3 class="font-mono text-[11px] font-semibold uppercase tracking-widest text-mute dark:text-neutral-500">
            {heading}
        </h3>
    )}

    <div class:list={['flex flex-wrap items-center gap-2', showHeading && 'mt-3']}>
        {SOCIAL_LINKS.map((item) => (
            <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={item.label}
                title={item.label}
                class:list={[
                    'group relative inline-flex items-center justify-center rounded-xl border border-hairline bg-elevated text-mute transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 active:scale-95 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400',
                    BRAND_HOVER_STYLES[item.icon] || 'hover:text-ink',
                    showLabels ? 'gap-2 px-3 py-1.5' : sizeClasses.btn,
                ]}
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class:list={[
                        sizeClasses.icon,
                        'transition-transform duration-200 group-hover:scale-110',
                    ]}
                    aria-hidden="true"
                    set:html={BRAND_SVGS[item.icon]}
                />

                {showLabels && (
                    <span class="text-xs font-medium text-ink transition-colors group-hover:text-current dark:text-neutral-200">
                        {item.name}
                    </span>
                )}

                {!showLabels && (
                    <span
                        role="tooltip"
                        class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-neutral-900 px-2 py-0.5 text-[10px] font-medium text-white opacity-0 shadow-sm transition-all duration-150 group-hover:-top-9 group-hover:opacity-100 dark:bg-neutral-100 dark:text-neutral-900"
                    >
                        {item.label}
                    </span>
                )}
            </a>
        ))}
    </div>
</div>
