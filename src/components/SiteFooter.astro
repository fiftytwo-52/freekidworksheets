---
// SiteFooter.astro — light Geist footer (DESIGN.md §3 "Footer"): canvas
// background with a hairline top border, body-grey text, brand + tagline,
// Explore links, and the four legal/help links plainly visible on every page
// (AdSense requirement, §10.4 / §13). Column headings use mono eyebrows.
import Brand from './Brand.astro';
import { CONTACT_EMAIL, FOOTER_EXPLORE, FOOTER_LEGAL, POPULAR_TOPICS, SITE_NAME, TAGLINE } from '../data/site';
const year = new Date().getFullYear();
const brand = 'freekidworksheets';
---

<footer class="border-t border-hairline bg-canvas dark:border-neutral-800 dark:bg-neutral-950">
    <div class="w-full max-w-none px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4">
            <!-- Column 1: brand + tagline -->
            <div class="max-w-xs">
                <Brand size="sm" />
                <p class="mt-4 text-sm leading-relaxed text-body dark:text-neutral-400">
                    {TAGLINE}. High-quality, printable A4 worksheets — always free, no signup needed.
                </p>
            </div>

            <!-- Column 2: Explore -->
            <nav aria-label="Explore">
                <h3 class="font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
                    Explore
                </h3>
                <ul class="mt-4 space-y-2.5 text-sm">
                    {FOOTER_EXPLORE.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-body transition-colors hover:text-ink dark:text-neutral-400 dark:hover:text-neutral-100"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

            <!-- Column 3: Help & Legal (plainly visible, AdSense) -->
            <nav aria-label="Help and legal">
                <h3 class="font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
                    Help & Legal
                </h3>
                <ul class="mt-4 space-y-2.5 text-sm">
                    {FOOTER_LEGAL.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="text-body transition-colors hover:text-ink dark:text-neutral-400 dark:hover:text-neutral-100"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>

            <!-- Column 4: about the library -->
            <div class="max-w-xs text-sm leading-relaxed text-body dark:text-neutral-400">
                <h3 class="font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
                    The library
                </h3>
                <p class="mt-4">
                    {brand} offers printable activity worksheets
                    for early learners and primary students — tracing,
                    alphabet, math, coloring, and writing.
                </p>
                <p class="mt-3">
                    Worksheets are handmade, AI-generated, or downloaded and edited/altered. If any content
                    matches your own work, please contact me at <a href={`mailto:${CONTACT_EMAIL}`} class="underline hover:text-ink dark:hover:text-neutral-100">{CONTACT_EMAIL}</a> and I will remove
                    it promptly.
                </p>
            </div>
        </div>

        <!-- Worksheet requests -->
        <aside class="mt-8 rounded-2xl border border-pink-200/80 bg-pink-50/70 p-5 shadow-sm dark:border-pink-900/60 dark:bg-pink-950/20" aria-label="Worksheet requests">
            <div class="flex gap-3">
                <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-pink-100 text-pink-600 dark:bg-pink-950 dark:text-pink-300" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z" />
                        <path d="M19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-bold text-neutral-900 dark:text-neutral-100">A small library, growing every week</p>
                    <p class="mt-1 max-w-3xl text-sm leading-relaxed text-body dark:text-neutral-300">
                        I’m building this collection on my own, so new sheets take a little time. Have a topic in mind? Send your suggestion on WhatsApp to <a href="https://wa.me/?text=Hi%20%40getmysheet%2C%20I%27d%20like%20to%20suggest%20a%20worksheet%20topic." target="_blank" rel="noopener noreferrer" class="font-bold text-pink-600 underline decoration-pink-300 underline-offset-2 hover:text-pink-700 dark:text-pink-300 dark:hover:text-pink-200">@getmysheet</a> and I’ll do my best to make it.
                    </p>
                </div>
            </div>
        </aside>

        <!-- Popular Topics Sitewide Links -->
        <div class="mt-8 border-t border-hairline pt-6 dark:border-neutral-800">
            <h3 class="font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
                Popular Worksheet Searches
            </h3>
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs text-body dark:text-neutral-400">
                {POPULAR_TOPICS.map((topic) => (
                    <a
                        href={`/search?q=${encodeURIComponent(topic.query)}`}
                        class="hover:text-ink hover:underline dark:hover:text-neutral-100"
                    >
                        {topic.label}
                    </a>
                ))}
            </div>
        </div>

        <div class="mt-8 border-t border-hairline pt-6 dark:border-neutral-800">
            <div class="flex flex-col items-center justify-between gap-3 text-center text-xs text-mute dark:text-neutral-500 sm:flex-row sm:text-left">
                <p>
                    © {year} {SITE_NAME} — Made with care for curious little minds.
                </p>
                <p>100% free · No signup · Personal & classroom use welcome</p>
            </div>
            <p class="dot-matrix-word mt-8 text-center text-[clamp(4rem,16vw,12rem)]" aria-label="fiftytwo">
                fiftytwo
            </p>
        </div>
    </div>
</footer>
