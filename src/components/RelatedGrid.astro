---
// RelatedGrid.astro — up to 4 same-category siblings shown on the worksheet
// detail page (§11.3.7). Cards reuse WorksheetCard, which already shows the
// age-group sub-line.
import type { CollectionEntry } from 'astro:content';
import WorksheetCard from './WorksheetCard.astro';

interface Props {
    items: Array<CollectionEntry<'worksheets'>>;
    title?: string;
}
const { items, title = 'Related worksheets' } = Astro.props;
---

{items.length > 0 && (
    <section class="mt-12" aria-label={title}>
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-semibold tracking-tight text-ink dark:text-neutral-100">
                {title}
            </h2>
        </div>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {items.map((entry) => (
                <WorksheetCard entry={entry} />
            ))}
        </div>
    </section>
)}
