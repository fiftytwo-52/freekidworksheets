---
// Faq.astro — home FAQ section from src/data/site.ts FAQS (§13.2). Matches
// the FAQPage JSON-LD emitted on the home page. Accessible <details> accordion
// in the Geist hairline-card language (DESIGN.md §3 "Cards & Containers").
import { FAQS } from '../data/site';
---

<section class="mt-14" aria-labelledby="faq-heading">
    <div class="text-center">
        <p class="font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
            Good to know
        </p>
        <h2
            id="faq-heading"
            class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-neutral-100"
        >
            Frequently asked questions
        </h2>
    </div>

    <div class="mx-auto mt-6 max-w-3xl space-y-2">
        {FAQS.map((f) => (
            <details
                class="group overflow-hidden rounded-lg border border-hairline bg-elevated transition-colors open:border-neutral-300 dark:border-neutral-800 dark:bg-neutral-900 dark:open:border-neutral-700"
            >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-[15px] font-medium text-ink dark:text-neutral-100">
                    <span>{f.question}</span>
                    <span
                        aria-hidden="true"
                        class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-hairline text-mute transition-transform duration-200 group-open:rotate-45 dark:border-neutral-700 dark:text-neutral-400"
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            class="h-4 w-4"
                        >
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                    </span>
                </summary>
                <div class="border-t border-hairline px-5 py-4 text-sm leading-relaxed text-body dark:border-neutral-800 dark:text-neutral-300">
                    {f.answer}
                </div>
            </details>
        ))}
    </div>
</section>
