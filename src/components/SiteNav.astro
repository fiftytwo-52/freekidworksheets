---
// SiteNav.astro — sticky top bar: brand left; actions right. Desktop shows the
// full link row + theme toggle. Mobile collapses links into a hamburger drawer
// (#mobile-menu) revealed when html.nav-open is set (toggled by scripts/
// theme.ts via [data-nav-toggle]); the theme toggle stays reachable in the
// mobile action row. Active link is highlighted from the current path.
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { NAV_LINKS } from '../data/site';

interface Props {
    /** Current path, to highlight the active link ('' = home). */
    path?: string;
}
const { path: currentPath = '' } = Astro.props;

function isActive(linkHref: string): boolean {
    return linkHref === '/'
        ? currentPath === '/' || currentPath === ''
        : currentPath === linkHref || currentPath.startsWith(`${linkHref}/`);
}

const DESKTOP_LINK =
    'flex items-center gap-2 rounded-full px-3 py-2 text-sm font-semibold transition-colors';
const DESKTOP_LINK_IDLE =
    'text-slate-600 hover:text-indigo-700 dark:text-slate-200 dark:hover:text-white';
const DESKTOP_LINK_ACTIVE =
    'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300';
const MOBILE_LINK =
    'flex items-center gap-3 rounded-xl px-3 py-3 text-base font-semibold transition-colors';
const MOBILE_LINK_IDLE =
    'text-slate-700 hover:bg-slate-50 dark:text-slate-200 dark:hover:bg-slate-800';
const MOBILE_LINK_ACTIVE =
    'bg-indigo-50 text-indigo-700 dark:bg-indigo-950/50 dark:text-indigo-300';
---

<header
    class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70 dark:border-slate-800 dark:bg-slate-900/90"
>
    <nav
        class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8"
        aria-label="Main navigation"
    >
        <div class="shrink-0">
            <Brand size="md" />
        </div>

        <!-- Desktop links + theme toggle -->
        <div class="hidden items-center gap-1 lg:flex">
            <ul class="flex items-center gap-1">
                {NAV_LINKS.map((link) => {
                    const active = isActive(link.href);
                    return (
                        <li>
                            <a
                                href={link.href}
                                data-nav-link
                                aria-current={active ? 'page' : undefined}
                                class:list={[
                                    DESKTOP_LINK,
                                    active
                                        ? DESKTOP_LINK_ACTIVE
                                        : DESKTOP_LINK_IDLE,
                                ]}
                            >
                                <Icon name={link.icon as 'home'} class="h-4 w-4" />
                                {link.label}
                            </a>
                        </li>
                    );
                })}
            </ul>
            <div class="mx-1 h-5 w-px bg-slate-200 dark:bg-slate-700"></div>
            <button
                type="button"
                data-theme-toggle
                class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 hover:text-amber-500 dark:text-slate-300 dark:hover:bg-slate-800"
                aria-label="Toggle dark or light mode"
                title="Toggle dark or light mode"
            >
                <Icon name="sun" class="theme-icon-sun h-5 w-5" />
                <Icon name="moon" class="theme-icon-moon h-5 w-5" />
            </button>
        </div>

        <!-- Mobile action row: theme toggle + hamburger -->
        <div class="flex items-center gap-1 lg:hidden">
            <button
                type="button"
                data-theme-toggle
                class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 hover:text-amber-500 dark:text-slate-300 dark:hover:bg-slate-800"
                aria-label="Toggle dark or light mode"
                title="Toggle dark or light mode"
            >
                <Icon name="sun" class="theme-icon-sun h-5 w-5" />
                <Icon name="moon" class="theme-icon-moon h-5 w-5" />
            </button>
            <button
                type="button"
                data-nav-toggle
                class="inline-flex h-10 w-10 items-center justify-center rounded-full text-slate-600 transition-colors hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <Icon name="menu" class="h-6 w-6" />
            </button>
        </div>
    </nav>

    <!-- Mobile drawer (revealed by html.nav-open; see global.css) -->
    <div
        id="mobile-menu"
        class="hidden border-t border-slate-200 bg-white px-4 pb-4 pt-2 shadow-lg lg:hidden dark:border-slate-800 dark:bg-slate-900"
    >
        <ul class="flex flex-col gap-1">
            {NAV_LINKS.map((link) => {
                const active = isActive(link.href);
                return (
                    <li>
                        <a
                            href={link.href}
                            data-nav-link
                            aria-current={active ? 'page' : undefined}
                            class:list={[
                                MOBILE_LINK,
                                active ? MOBILE_LINK_ACTIVE : MOBILE_LINK_IDLE,
                            ]}
                        >
                            <Icon name={link.icon as 'home'} class="h-5 w-5" />
                            {link.label}
                        </a>
                    </li>
                );
            })}
        </ul>
    </div>
</header>
