---
// SiteNav.astro — sticky top bar (DESIGN.md §3 "Navigation"): brand left;
// actions right. Desktop shows the full link row + a squared theme toggle.
// Mobile collapses links into a drawer (#mobile-menu) revealed when
// html.nav-open is set (toggled by scripts/theme.ts via [data-nav-toggle]);
// the theme toggle stays reachable in the mobile action row. Active link is
// highlighted from the current path.
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { NAV_LINKS } from '../data/site';

interface Props {
    /** Current path, to highlight the active link ('' = home). */
    path?: string;
}
const { path: currentPath = '' } = Astro.props;

function isActive(linkHref: string): boolean {
    return linkHref === '/'
        ? currentPath === '/' || currentPath === ''
        : currentPath === linkHref || currentPath.startsWith(`${linkHref}/`);
}

const DESKTOP_LINK =
    'flex items-center gap-2 rounded-full px-3 py-2 text-sm font-medium transition-colors';
const DESKTOP_LINK_IDLE =
    'text-body hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-900 dark:hover:text-neutral-100';
const DESKTOP_LINK_ACTIVE =
    'text-ink dark:text-neutral-100';
const MOBILE_LINK =
    'flex items-center gap-3 rounded-md px-3 py-3 text-sm font-medium transition-colors';
const MOBILE_LINK_IDLE =
    'text-body hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-900 dark:hover:text-neutral-100';
const MOBILE_LINK_ACTIVE =
    'bg-neutral-100 text-ink dark:bg-neutral-900 dark:text-neutral-100';

const ICON_IDLE = 'text-mute dark:text-neutral-500';
const ICON_ACTIVE = 'text-accent';
const ICON_BUTTON =
    'inline-flex h-9 w-9 items-center justify-center rounded-md border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100';
---

<header
    class="sticky top-0 z-50 border-b border-hairline bg-elevated/90 backdrop-blur supports-[backdrop-filter]:bg-elevated/75 dark:border-neutral-800 dark:bg-neutral-950/90"
>
    <nav
        class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:w-full lg:max-w-none lg:px-1.5"
        aria-label="Main navigation"
    >
        <div class="shrink-0">
            <Brand size="md" />
        </div>

        <!-- Desktop links + theme toggle -->
        <div class="hidden items-center gap-1 lg:flex">
            <ul class="flex items-center gap-1">
                {NAV_LINKS.map((link) => {
                    const active = isActive(link.href);
                    return (
                        <li>
                            <a
                                href={link.href}
                                data-nav-link
                                aria-current={active ? 'page' : undefined}
                                class:list={[
                                    DESKTOP_LINK,
                                    active ? DESKTOP_LINK_ACTIVE : DESKTOP_LINK_IDLE,
                                ]}
                            >
                                <Icon
                                    name={link.icon as 'home'}
                                    class={[
                                        'h-4 w-4',
                                        active ? ICON_ACTIVE : ICON_IDLE,
                                    ].join(' ')}
                                />
                                {link.label}
                            </a>
                        </li>
                    );
                })}
            </ul>
            <div class="mx-1 h-5 w-px bg-hairline dark:bg-neutral-800"></div>
            <button
                type="button"
                data-theme-toggle
                class={ICON_BUTTON}
                aria-label="Toggle dark or light mode"
                title="Toggle dark or light mode"
            >
                <Icon name="sun" class="theme-icon-sun h-[18px] w-[18px]" />
                <Icon name="moon" class="theme-icon-moon h-[18px] w-[18px]" />
            </button>
        </div>

        <!-- Mobile action row: theme toggle + hamburger -->
        <div class="flex items-center gap-2 lg:hidden">
            <button
                type="button"
                data-theme-toggle
                class={ICON_BUTTON}
                aria-label="Toggle dark or light mode"
                title="Toggle dark or light mode"
            >
                <Icon name="sun" class="theme-icon-sun h-[18px] w-[18px]" />
                <Icon name="moon" class="theme-icon-moon h-[18px] w-[18px]" />
            </button>
            <button
                type="button"
                data-nav-toggle
                class={ICON_BUTTON}
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <Icon name="menu" class="h-5 w-5" />
            </button>
        </div>
    </nav>

    <!-- Mobile drawer (revealed by html.nav-open; see global.css) -->
    <div
        id="mobile-menu"
        class="hidden border-t border-hairline bg-elevated px-4 pb-4 pt-2 shadow-[0_8px_24px_-12px_rgba(0,0,0,0.15)] lg:hidden dark:border-neutral-800 dark:bg-neutral-950"
    >
        <ul class="flex flex-col gap-1">
            {NAV_LINKS.map((link) => {
                const active = isActive(link.href);
                return (
                    <li>
                        <a
                            href={link.href}
                            data-nav-link
                            aria-current={active ? 'page' : undefined}
                            class:list={[
                                MOBILE_LINK,
                                active ? MOBILE_LINK_ACTIVE : MOBILE_LINK_IDLE,
                            ]}
                        >
                            <Icon
                                name={link.icon as 'home'}
                                class={[
                                    'h-5 w-5',
                                    active ? ICON_ACTIVE : ICON_IDLE,
                                ].join(' ')}
                            />
                            {link.label}
                        </a>
                    </li>
                );
            })}
        </ul>
    </div>
</header>
