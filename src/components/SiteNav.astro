---
// SiteNav.astro — sticky top bar (DESIGN.md §3 "Navigation"): brand left;
// actions right. Desktop shows the full link row + a squared theme toggle.
// Mobile collapses links into a drawer (#mobile-menu) revealed when
// html.nav-open is set (toggled by scripts/theme.ts via [data-nav-toggle]);
// the theme toggle stays reachable in the mobile action row. Active link is
// highlighted from the current path.
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import SocialFollow from './SocialFollow.astro';
import { LANGUAGE_LINKS, NAV_LINKS } from '../data/site';

interface Props {
    /** Current path, to highlight the active link ('' = home). */
    path?: string;
}
const { path: currentPath = '' } = Astro.props;

function isActive(linkHref: string): boolean {
    return linkHref === '/'
        ? currentPath === '/' || currentPath === ''
        : currentPath === linkHref || currentPath.startsWith(`${linkHref}/`);
}

/** Label of the language whose page (or a child of it) is currently open. */
function currentLanguageLabel(): string {
    const match = LANGUAGE_LINKS.find((l) => isActive(l.href));
    return match ? match.label : 'English';
}

/** Two-letter initials for each language, in LANGUAGE_LINKS order. */
const LANGUAGE_INITIALS = ['EN', 'NP', 'ES'] as const;

function currentLanguageInitials(): string {
    const index = LANGUAGE_LINKS.findIndex((l) => isActive(l.href));
    return LANGUAGE_INITIALS[index] ?? 'EN';
}

/**
 * The Worksheets nav link points at the library matching the current language
 * version (user requirement): browsing the Nepali version opens the Nepali-only
 * library, the Spanish version the Spanish-only library, everything else the
 * English library. Covers the language homes and their library pages.
 */
function libraryHref(): string {
    if (
        currentPath.startsWith('/nepali') ||
        currentPath.startsWith('/worksheets/nepali')
    ) {
        return '/worksheets/nepali';
    }
    if (
        currentPath.startsWith('/spanish') ||
        currentPath.startsWith('/worksheets/spanish')
    ) {
        return '/worksheets/spanish';
    }
    return '/worksheets';
}
const LIBRARY_HREF = libraryHref();

const DESKTOP_LINK =
    'flex items-center gap-2 rounded-full px-3 py-2 text-sm font-medium transition-colors';
const DESKTOP_LINK_IDLE =
    'text-body hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-900 dark:hover:text-neutral-100';
const DESKTOP_LINK_ACTIVE =
    'text-ink dark:text-neutral-100';
const MOBILE_LINK =
    'flex items-center gap-3 rounded-md px-3 py-3 text-sm font-medium transition-colors';
const MOBILE_LINK_IDLE =
    'text-body hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-900 dark:hover:text-neutral-100';
const MOBILE_LINK_ACTIVE =
    'bg-neutral-100 text-ink dark:bg-neutral-900 dark:text-neutral-100';

const ICON_IDLE = 'text-mute dark:text-neutral-500';
const ICON_ACTIVE = 'text-accent';
const ICON_BUTTON =
    'inline-flex h-9 w-9 items-center justify-center rounded-md border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100';
---

<header
    class="sticky top-0 z-50 border-b border-hairline bg-elevated/90 backdrop-blur supports-[backdrop-filter]:bg-elevated/75 dark:border-neutral-800 dark:bg-neutral-950/90"
>
    <nav
        class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:w-full lg:max-w-none lg:px-1.5"
        aria-label="Main navigation"
    >
        <div class="shrink-0">
            <Brand size="md" />
        </div>

        <!-- Desktop links + theme toggle -->
        <div class="hidden items-center gap-1 lg:flex">
            <ul class="flex items-center gap-1">
                {NAV_LINKS.map((link) => {
                    const href = link.href === '/worksheets' ? LIBRARY_HREF : link.href;
                    const active = isActive(href);
                    return (
                        <li>
                            <a
                                href={href}
                                data-nav-link
                                aria-current={active ? 'page' : undefined}
                                class:list={[
                                    DESKTOP_LINK,
                                    active ? DESKTOP_LINK_ACTIVE : DESKTOP_LINK_IDLE,
                                ]}
                            >
                                <Icon
                                    name={link.icon as 'home'}
                                    class={[
                                        'h-4 w-4',
                                        active ? ICON_ACTIVE : ICON_IDLE,
                                    ].join(' ')}
                                />
                                {link.label}
                            </a>
                        </li>
                    );
                })}
            </ul>

            <!-- Language switcher dropdown -->
            <details class="group relative" data-language-switcher>
                <summary
                    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-2 text-sm font-medium text-body transition-colors hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-900 dark:hover:text-neutral-100 [&::-webkit-details-marker]:hidden"
                    aria-label="Switch language"
                    title="Switch language"
                >
                    <Icon name="globe" class="h-4 w-4 text-mute dark:text-neutral-500" />
                    <span class="font-mono text-[11px] font-bold tracking-wider text-accent">{currentLanguageInitials()}</span>
                    <span>{currentLanguageLabel()}</span>
                    <Icon name="chevron-down" class="h-3.5 w-3.5 text-mute transition-transform group-open:rotate-180 dark:text-neutral-500" />
                </summary>
                <ul class="absolute right-0 top-full z-50 mt-2 w-40 overflow-hidden rounded-xl border border-hairline bg-elevated py-1 shadow-lg dark:border-neutral-800 dark:bg-neutral-900">
                    {LANGUAGE_LINKS.map((lang) => {
                        const active = isActive(lang.href);
                        return (
                            <li>
                                <a
                                        href={lang.href}
                                        data-language-link
                                        aria-current={active ? 'page' : undefined}
                                        class:list={[
                                            'flex items-center justify-between px-4 py-2 text-sm font-medium transition-colors',
                                        active
                                            ? 'bg-neutral-100 text-ink dark:bg-neutral-800 dark:text-neutral-100'
                                            : 'text-body hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-neutral-100',
                                    ]}
                                >
                                    {lang.label}
                                    {active && <Icon name="star" class="h-3.5 w-3.5 text-accent" />}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </details>

            <div class="mx-1 h-5 w-px bg-hairline dark:bg-neutral-800"></div>
            <button
                type="button"
                data-theme-toggle
                class={ICON_BUTTON}
                aria-label="Toggle dark or light mode"
                title="Toggle dark or light mode"
            >
                <Icon name="sun" class="theme-icon-sun h-[18px] w-[18px]" />
                <Icon name="moon" class="theme-icon-moon h-[18px] w-[18px]" />
            </button>
        </div>

        <!-- Mobile action row: language switcher + theme toggle + hamburger -->
        <div class="flex items-center gap-2 lg:hidden">
            <details class="relative" data-language-switcher>
                <summary
                    class="inline-flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-md border border-hairline bg-elevated px-2.5 text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100 [&::-webkit-details-marker]:hidden"
                    aria-label="Switch language"
                    title="Switch language"
                >
                    <Icon name="globe" class="h-[18px] w-[18px]" />
                    <span class="font-mono text-[11px] font-bold tracking-wider text-neutral-600 dark:text-neutral-300">{currentLanguageInitials()}</span>
                </summary>
                <ul class="absolute right-0 top-full z-50 mt-2 w-36 overflow-hidden rounded-xl border border-hairline bg-elevated py-1 shadow-lg dark:border-neutral-800 dark:bg-neutral-900">
                    {LANGUAGE_LINKS.map((lang, langIndex) => {
                        const active = isActive(lang.href);
                        return (
                            <li>
                                <a
                                    href={lang.href}
                                    data-language-link
                                    aria-current={active ? 'page' : undefined}
                                    class:list={[
                                        'flex items-center justify-between px-4 py-2 text-sm font-medium transition-colors',
                                        active
                                            ? 'bg-neutral-100 text-ink dark:bg-neutral-800 dark:text-neutral-100'
                                            : 'text-body hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-neutral-100',
                                    ]}
                                >
                                    <span class="flex items-center gap-2">
                                        <span class="rounded bg-neutral-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-neutral-500 dark:bg-neutral-800 dark:text-neutral-400">{LANGUAGE_INITIALS[langIndex]}</span>
                                        {lang.label}
                                    </span>
                                    {active && <Icon name="star" class="h-3.5 w-3.5 text-accent" />}
                                </a>
                            </li>
                        );
                    })}
                </ul>
            </details>
            <button
                type="button"
                data-theme-toggle
                class={ICON_BUTTON}
                aria-label="Toggle dark or light mode"
                title="Toggle dark or light mode"
            >
                <Icon name="sun" class="theme-icon-sun h-[18px] w-[18px]" />
                <Icon name="moon" class="theme-icon-moon h-[18px] w-[18px]" />
            </button>
            <button
                type="button"
                data-nav-toggle
                class={ICON_BUTTON}
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <Icon name="menu" class="h-5 w-5" />
            </button>
        </div>
    </nav>

    <!-- Mobile drawer (revealed by html.nav-open; see global.css) -->
    <div
        id="mobile-menu"
        class="hidden border-t border-hairline bg-elevated px-4 pb-4 pt-2 shadow-[0_8px_24px_-12px_rgba(0,0,0,0.15)] lg:hidden dark:border-neutral-800 dark:bg-neutral-950"
    >
        <ul class="flex flex-col gap-1">
            {NAV_LINKS.map((link) => {
                const href = link.href === '/worksheets' ? LIBRARY_HREF : link.href;
                const active = isActive(href);
                return (
                    <li>
                        <a
                            href={href}
                            data-nav-link
                            aria-current={active ? 'page' : undefined}
                            class:list={[
                                MOBILE_LINK,
                                active ? MOBILE_LINK_ACTIVE : MOBILE_LINK_IDLE,
                            ]}
                        >
                            <Icon
                                name={link.icon as 'home'}
                                class={[
                                    'h-5 w-5',
                                    active ? ICON_ACTIVE : ICON_IDLE,
                                ].join(' ')}
                            />
                            {link.label}
                        </a>
                    </li>
                );
            })}
        </ul>

        <!-- Language switcher (mobile) -->
        <div class="mt-3 border-t border-hairline pt-3 dark:border-neutral-800">
            <p class="mb-1 px-3 font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
                Language
            </p>
            <ul class="flex flex-col gap-1">
                {LANGUAGE_LINKS.map((lang) => {
                    const active = isActive(lang.href);
                    return (
                        <li>
                            <a
                                href={lang.href}
                                data-language-link
                                aria-current={active ? 'page' : undefined}
                                class:list={[
                                    'flex items-center justify-between px-3 py-2.5 text-sm font-medium transition-colors',
                                    active
                                        ? 'bg-neutral-100 text-ink dark:bg-neutral-900 dark:text-neutral-100'
                                        : 'text-body hover:bg-neutral-100 hover:text-ink dark:text-neutral-300 dark:hover:bg-neutral-900 dark:hover:text-neutral-100',
                                ]}
                            >
                                {lang.label}
                                {active && <Icon name="star" class="h-3.5 w-3.5 text-accent" />}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </div>

        <!-- Social follow (mobile drawer) -->
        <div class="mt-3 border-t border-hairline px-3 pt-3 dark:border-neutral-800">
            <SocialFollow heading="Follow on" size="sm" />
        </div>
    </div>
</header>
