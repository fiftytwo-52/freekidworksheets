---
// WorksheetCard.astro — colorful, kid-friendly library/search/home card
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { cardDataProps } from '../lib/filter';

interface Props {
    entry: CollectionEntry<'worksheets'>;
}
const { entry } = Astro.props;
const { title, category, ageGroup, code, language } = entry.data;
const isNepali = language === 'ne';
const detailHref = `/worksheet/${entry.slug}`;
const attrs = cardDataProps(entry);
---

<article
    class="card-lift group flex flex-col overflow-hidden rounded-2xl border-2 border-yellow-200/80 bg-white shadow-[0_2px_8px_rgba(0,0,0,0.04)] transition-all duration-200 hover:-translate-y-1 hover:border-yellow-400 hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-900"
    {...attrs}
>
    <a
        href={detailHref}
        class="relative block bg-neutral-50 p-2 dark:bg-neutral-800/50"
        tabindex="-1"
        aria-hidden="true"
    >
        <div class="aspect-[4/3] w-full overflow-hidden rounded-xl bg-white dark:bg-neutral-900">
            <Image
                src={entry.data.image}
                alt=""
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain p-1 transition-transform duration-300 group-hover:scale-105"
            />
        </div>
        <span
            class="absolute left-3.5 top-3.5 rounded-full bg-pink-500 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-white shadow-xs"
        >
            Free
        </span>
        {isNepali && (
            <span
                class="absolute left-16 top-3.5 rounded-full bg-emerald-500 px-2 py-0.5 font-mono text-[10px] font-bold text-white shadow-xs"
            >
                नेपाली
            </span>
        )}
        {code && (
            <span
                class="absolute right-3.5 top-3.5 rounded-full bg-neutral-900/85 backdrop-blur-xs px-2.5 py-0.5 font-mono text-[10px] font-bold text-white shadow-xs dark:bg-neutral-800/90"
            >
                #{code}
            </span>
        )}
    </a>

    <div class="flex flex-1 flex-col p-4">
        <p
            class="font-mono text-[11px] font-semibold uppercase tracking-wider text-cyan-700 dark:text-cyan-400"
        >
            {category}
            <span aria-hidden="true"> · </span>
            {ageGroup} yrs
        </p>

        <h3
            class="mt-1.5 text-base font-bold leading-snug tracking-tight text-neutral-900 transition-colors group-hover:text-pink-500 dark:text-neutral-100"
        >
            <a
                href={detailHref}
                class="focus:outline-none focus-visible:underline"
            >
                {title}
            </a>
        </h3>
    </div>
</article>
