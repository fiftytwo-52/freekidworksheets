---
// WorksheetCard.astro — library/search/home card (§11.2):
// lazy-loaded thumbnail (aspect-[4/3], object-contain), title link, meta line
// "Category • Age group", and a small emerald "Free" badge. Cards expose the
// data-* attributes used by the client-side filters (src/lib/filter.ts).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { cardDataAttrs } from '../lib/filter';

interface Props {
    entry: CollectionEntry<'worksheets'>;
}
const { entry } = Astro.props;
const { title, category, ageGroup } = entry.data;
const detailHref = `/worksheet/${entry.id}`;
const dataAttrs = cardDataAttrs(entry);
---

<article
    class="card-lift group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-800"
    {dataAttrs}
>
    <a
        href={detailHref}
        class="relative block bg-slate-100 dark:bg-slate-900"
        tabindex="-1"
        aria-hidden="true"
    >
        <div class="aspect-[4/3] w-full">
            <Image
                src={entry.data.image}
                alt=""
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain transition-transform duration-200 group-hover:scale-[1.02]"
            />
        </div>
        <span
            class="absolute left-2 top-2 rounded-full bg-emerald-500 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-white shadow-sm"
        >
            Free
        </span>
    </a>

    <div class="flex flex-1 flex-col p-3.5">
        <h3 class="font-display text-base font-bold leading-snug text-slate-800 dark:text-slate-100">
            <a
                href={detailHref}
                class="hover:text-indigo-600 focus-visible:text-indigo-600 dark:hover:text-indigo-300"
            >
                {title}
            </a>
        </h3>
        <p class="mt-1 text-xs font-medium text-slate-500 dark:text-slate-400">
            {category}
            <span aria-hidden="true"> • </span>
            {ageGroup} yrs
        </p>
    </div>
</article>
