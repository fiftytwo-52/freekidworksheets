---
// WorksheetCard.astro — minimal thumbnail card: pure worksheet preview with
// its search-code badge only (user requirement: "thumbnail and code only,
// nothing else"). No title/category text is rendered; the data-* attributes
// are kept so scripts/browse-filters.ts can still filter/sort the grid, and
// the title stays available to screen readers via the link's aria-label.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { cardDataProps } from '../lib/filter';

interface Props {
    entry: CollectionEntry<'worksheets'>;
}
const { entry } = Astro.props;
const { title, code, category, ageGroup } = entry.data;
const detailHref = `/worksheet/${entry.slug}`;
const attrs = cardDataProps(entry);
---

<article
    class="card-lift group relative overflow-hidden rounded-xl border border-hairline bg-white shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900"
    {...attrs}
>
    <a
        href={detailHref}
        class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-pink-500"
        aria-label={title}
    >
        <div class="relative aspect-[3/4] w-full bg-neutral-50 p-1.5 dark:bg-neutral-800/50">
            <Image
                src={entry.data.image}
                alt={title}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="h-full w-full rounded-lg object-contain transition-transform duration-300 group-hover:scale-[1.02]"
            />
            <!-- Hover overlay: reveals title + category/age info on pointer devices only -->
            <div
                class="pointer-events-none absolute inset-1.5 hidden flex-col justify-end rounded-lg bg-gradient-to-t from-neutral-900/90 via-neutral-900/40 to-transparent p-3 opacity-0 transition-opacity duration-200 group-hover:opacity-100 [@media(hover:hover)]:flex"
            >
                <h3 class="line-clamp-3 text-sm font-bold leading-snug text-white">
                    {title}
                </h3>
                <p class="mt-1 font-mono text-[10px] font-semibold uppercase tracking-wider text-pink-300">
                    {category} · {ageGroup} yrs
                </p>
            </div>
        </div>
        {code && (
            <span
                class="absolute right-2 top-2 rounded-md bg-neutral-900/85 px-2 py-0.5 font-mono text-[10px] font-bold text-white shadow-xs backdrop-blur-xs dark:bg-neutral-800/90"
            >
                #{code}
            </span>
        )}
    </a>
</article>
