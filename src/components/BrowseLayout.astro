---
// BrowseLayout.astro — shared shell for the library/category pages (§11.2).
// Renders the header (mono eyebrow/title/blurb), the reusable client-side
// filter panel, the card grid, and static pagination. Pages add extra SEO
// content and ad banners as siblings around it.
//
// The FilterPanel + card grid live inside ONE <div data-filter-region> so
// scripts/browse-filters.ts can scope its queries to this page.
import type { CollectionEntry } from 'astro:content';
import FilterPanel from './FilterPanel.astro';
import Icon from './Icon.astro';
import Pagination from './Pagination.astro';
import WorksheetCard from './WorksheetCard.astro';
import { POPULAR_TOPICS } from '../data/site';

interface Props {
    kicker: string;
    title: string;
    blurb: string;
    empty: string;
    items: Array<CollectionEntry<'worksheets'>>;
    basePath: string;
    page: number;
    totalPages: number;
    showLanguage?: boolean;
}
const {
    kicker,
    title,
    blurb,
    empty,
    items,
    basePath,
    page,
    totalPages,
    showLanguage = false,
} = Astro.props;
---

<section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8 text-center">
        <p class="font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
            {kicker}
        </p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-pink-500 sm:text-4xl dark:text-pink-400">
            {title}
        </h1>
        <p class="mx-auto mt-2 max-w-2xl text-[15px] leading-relaxed text-body dark:text-neutral-300">
            {blurb}
        </p>

        <!-- Search bar at top -->
        <form action="/search" method="get" role="search" class="mx-auto mt-6 flex max-w-lg items-center gap-2 rounded-full border border-neutral-300/90 bg-white p-1.5 shadow-sm transition focus-within:border-pink-500 focus-within:ring-4 focus-within:ring-pink-500/10 dark:border-neutral-700 dark:bg-neutral-900">
            <label for="browse-search" class="sr-only">Search worksheets</label>
            <span class="relative flex flex-1 items-center">
                <Icon name="search" class="pointer-events-none ml-3 h-5 w-5 text-neutral-400" />
                <input
                    id="browse-search"
                    type="search"
                    name="q"
                    placeholder="Search by title, topic, or code (e.g., 1001)..."
                    class="w-full bg-transparent px-3 py-1.5 text-sm font-medium text-neutral-800 placeholder:text-neutral-400 focus:outline-none dark:text-neutral-100"
                />
            </span>
            <button
                type="submit"
                class="inline-flex h-10 shrink-0 items-center gap-1.5 rounded-full bg-pink-500 px-5 text-sm font-bold text-white shadow-sm transition hover:bg-pink-600 active:scale-95"
            >
                Search
            </button>
        </form>

        <!-- Popular topic chips -->
        <div class="mx-auto mt-4 flex flex-wrap items-center justify-center gap-1.5 text-xs">
            <span class="mr-1 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">Popular:</span>
            {POPULAR_TOPICS.slice(0, 7).map((topic) => (
                <a
                    href={`/search?q=${encodeURIComponent(topic.query)}`}
                    class="rounded-full border border-neutral-200 bg-white px-3 py-1 text-xs font-semibold text-neutral-700 shadow-2xs transition hover:border-pink-300 hover:bg-pink-50 hover:text-pink-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:hover:text-pink-300"
                >
                    {topic.label}
                </a>
            ))}
        </div>
    </header>

    <div data-filter-region>
        <FilterPanel empty={empty} {showLanguage} />

        <div
            class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
            data-card-grid
        >
            {items.length > 0 ? (
                items.map((entry) => <WorksheetCard entry={entry} />)
            ) : (
                <p class="col-span-full rounded-lg border border-dashed border-hairline px-6 py-10 text-center text-body dark:border-neutral-700 dark:text-neutral-400">
                    No worksheets in this section yet — check back soon.
                </p>
            )}
        </div>
    </div>

    <Pagination {basePath} {page} {totalPages} />
</section>
