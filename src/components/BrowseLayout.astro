---
// BrowseLayout.astro — shared shell for the library/category pages (§11.2).
// Renders the hero header (mono eyebrow/title/blurb on the left, search card
// + popular topics on the right — same 2-column layout as the home heroes,
// tone-matched per language), then the reusable client-side filter panel,
// the card grid, and static pagination. Pages add extra SEO content and ad
// banners as siblings around it.
//
// The FilterPanel + card grid live inside ONE <div data-filter-region> so
// scripts/browse-filters.ts can scope its queries to this page.
import type { CollectionEntry } from 'astro:content';
import FilterPanel from './FilterPanel.astro';
import Icon from './Icon.astro';
import Pagination from './Pagination.astro';
import WorksheetCard from './WorksheetCard.astro';
import { UI_STRINGS, TOPICS_BY_LANG } from '../data/ui-strings';

interface Props {
    kicker: string;
    title: string;
    blurb: string;
    empty: string;
    items: Array<CollectionEntry<'worksheets'>>;
    basePath: string;
    page: number;
    totalPages: number;
    /** Hero gradient tone, matching each language's home hero (default: English pink). */
    tone?: 'pink' | 'green' | 'blue';
    /** UI language for labels/topics (default English). */
    lang?: 'en' | 'ne' | 'es';
}
const {
    kicker,
    title,
    blurb,
    empty,
    items,
    basePath,
    page,
    totalPages,
    tone = 'pink',
    lang = 'en',
} = Astro.props;

/** Hero + search-card accent classes per language tone (mirrors the home heroes). */
const TONES = {
    pink: {
        hero: 'bg-gradient-to-br from-pink-200 via-purple-100 to-amber-100 dark:from-pink-950/70 dark:via-purple-950/60 dark:to-neutral-900',
        accent: 'text-pink-500',
        focus: 'focus-within:border-pink-500 focus-within:ring-4 focus-within:ring-pink-500/10',
        chip: 'hover:border-pink-300 hover:bg-pink-50 hover:text-pink-600 dark:hover:bg-neutral-700 dark:hover:text-pink-300',
    },
    green: {
        hero: 'bg-gradient-to-br from-emerald-200 via-teal-100 to-amber-100 dark:from-emerald-950/70 dark:via-teal-950/60 dark:to-neutral-900',
        accent: 'text-emerald-500',
        focus: 'focus-within:border-emerald-500 focus-within:ring-4 focus-within:ring-emerald-500/10',
        chip: 'hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-600 dark:hover:bg-neutral-700 dark:hover:text-emerald-300',
    },
    blue: {
        hero: 'bg-gradient-to-br from-sky-200 via-blue-100 to-cyan-100 dark:from-sky-950/70 dark:via-blue-950/60 dark:to-neutral-900',
        accent: 'text-sky-500',
        focus: 'focus-within:border-sky-500 focus-within:ring-4 focus-within:ring-sky-500/10',
        chip: 'hover:border-sky-300 hover:bg-sky-50 hover:text-sky-600 dark:hover:bg-neutral-700 dark:hover:text-sky-300',
    },
} as const;
const t = TONES[tone];
const s = UI_STRINGS[lang];
---

<!-- Hero header — same 2-column layout as the home heroes (text left, search card right) -->
<section class={`border-b border-neutral-200/80 ${t.hero}`}>
    <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-12 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
            <!-- Left column: kicker, title, blurb -->
            <div class="text-left lg:col-span-7">
                <p class="font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500">
                    {kicker}
                </p>
                <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl dark:text-white">
                    {title}
                </h1>
                <p class="mt-3 max-w-xl text-base font-normal leading-relaxed text-neutral-600 sm:text-lg dark:text-neutral-300">
                    {blurb}
                </p>
            </div>

            <!-- Right column: search card + popular topics (like the home hero card).
                 Compact on mobile: only the search form shows; heading/hint/chips appear from sm up. -->
            <div class="lg:col-span-5">
                <div class="rounded-3xl border border-neutral-200/80 bg-white/90 p-3 shadow-sm backdrop-blur-sm sm:p-6 dark:border-neutral-800 dark:bg-neutral-900/90">
                    <h2 class="hidden items-center gap-2 text-sm font-bold text-neutral-900 sm:flex dark:text-neutral-100">
                        <Icon name="search" class={`h-4 w-4 ${t.accent}`} />
                        {s.searchHeading}
                    </h2>
                    <p class="mt-1 hidden text-xs text-neutral-500 sm:block dark:text-neutral-400">
                        {s.searchHint}
                    </p>

                    <!-- Search form -->
                    <form action="/search" method="get" role="search" class={`mt-3 flex items-center gap-2 rounded-full border border-neutral-300/90 bg-white p-1.5 shadow-2xs transition dark:border-neutral-700 dark:bg-neutral-800 ${t.focus}`}>
                        <label for="browse-search" class="sr-only">{s.srSearchWorksheets}</label>
                        <input type="hidden" name="lang" value={lang} />
                        <input
                            id="browse-search"
                            type="search"
                            name="q"
                            placeholder={s.searchPlaceholder}
                            class="w-full bg-transparent px-3 py-1 text-sm font-medium text-neutral-800 placeholder:text-neutral-400 focus:outline-none dark:text-neutral-100"
                        />
                        <button
                            type="submit"
                            class="inline-flex h-9 shrink-0 items-center justify-center rounded-full bg-pink-500 px-4 text-xs font-bold text-white shadow-2xs transition hover:bg-pink-600 active:scale-95"
                        >
                            {s.searchButton}
                        </button>
                    </form>

                    <!-- Popular topic chips -->
                    <div class="mt-4 hidden border-t border-neutral-100 pt-3 sm:block dark:border-neutral-800">
                        <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                            {s.popularTopics}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                            {TOPICS_BY_LANG[lang].slice(0, 7).map((topic) => (
                                <a
                                    href={`/search?q=${encodeURIComponent(topic.query)}&lang=${lang}`}
                                    rel="nofollow"
                                    class={`rounded-full border border-neutral-200 bg-neutral-50/80 px-2.5 py-1 text-xs font-medium text-neutral-700 transition dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 ${t.chip}`}
                                >
                                    {topic.label}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Library content: filter panel + card grid + pagination -->
<section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div data-filter-region>
        <FilterPanel empty={empty} lang={lang} />

        <div
            class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4"
            data-card-grid
        >
            {items.length > 0 ? (
                items.map((entry) => <WorksheetCard entry={entry} />)
            ) : (
                <p class="col-span-full rounded-lg border border-dashed border-hairline px-6 py-10 text-center text-body dark:border-neutral-700 dark:text-neutral-400">
                    {s.noResultsInGrid}
                </p>
            )}
        </div>
    </div>

    <Pagination {basePath} {page} {totalPages} />
</section>
