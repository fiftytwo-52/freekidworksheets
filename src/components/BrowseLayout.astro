---
// BrowseLayout.astro — shared shell for the library/category pages (§11.2).
// Renders the header (kicker/title/blurb), the reusable client-side filter
// panel, the card grid, and static pagination. Pages add extra SEO content
// and ad banners as siblings around it.
import type { CollectionEntry } from 'astro:content';
import FilterPanel from './FilterPanel.astro';
import Pagination from './Pagination.astro';
import WorksheetCard from './WorksheetCard.astro';

interface Props {
    kicker: string;
    title: string;
    blurb: string;
    empty: string;
    items: Array<CollectionEntry<'worksheets'>>;
    basePath: string;
    page: number;
    totalPages: number;
    /** Show the Kind control? (category pages only — §11.2). */
    showKind?: boolean;
}
const {
    kicker,
    title,
    blurb,
    empty,
    items,
    basePath,
    page,
    totalPages,
    showKind = false,
} = Astro.props;
const kindWord = title.toLowerCase().includes('question')
    ? 'question papers'
    : 'worksheets';
---

<section class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-6 text-center">
        <p
            class="inline-block rounded-full bg-indigo-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300"
        >
            {kicker}
        </p>
        <h1
            class="mt-3 font-display text-3xl font-extrabold text-slate-900 sm:text-4xl dark:text-white"
        >
            {title}
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            {blurb}
        </p>
    </header>

    <FilterPanel empty={empty} showKind={showKind} />

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-card-grid>
        {items.length > 0 ? (
            items.map((entry) => <WorksheetCard entry={entry} />)
        ) : (
            <p class="col-span-full rounded-2xl border border-dashed border-slate-300 px-6 py-10 text-center text-slate-500 dark:border-slate-700 dark:text-slate-400">
                No {kindWord} in this section yet — check back soon.
            </p>
        )}
    </div>

    <Pagination {basePath} {page} {totalPages} />
</section>
