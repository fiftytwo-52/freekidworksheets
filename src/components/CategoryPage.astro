---
// CategoryPage.astro — shared renderer for /category/{category} (§11.2):
// all worksheets in one category, 20/page. Page 1 lives at the bare path (§9.2).
import Base from '../layouts/Base.astro';
import BrowseLayout from './BrowseLayout.astro';
import { getByCategory, paginate } from '../lib/content';
import { CATEGORY_INTROS, categoryPath } from '../data/site';

interface Props {
    category: string;
    page: number;
}
const { category, page } = Astro.props;

const { items, totalPages } = paginate(await getByCategory(category), page);

const basePath = categoryPath(category);
const path = page === 1 ? basePath : `${basePath}/page/${page}`;
// Title-friendly category name ("Alphabet & Tracing" -> "Alphabet Tracing") keeps
// every paginated <title> inside the 50-60 character target (SEO TASK-05/12).
const titleCategory = category.replace(/\s*&\s*/g, ' ');
const pageTitle =
    page === 1
        ? `${titleCategory} worksheets`
        : `${titleCategory} worksheets - page ${page}`;
const catLower = category.toLowerCase();
const description =
    `Free printable ${catLower} worksheets for kids — browse, download and print ` +
    `A4 activity sheets for young learners at home or in class. ` +
    (page === 1 ? 'No signup needed.' : `Page ${page} of ${totalPages}.`);

const pageKeywords = `${catLower} for kids worksheet, ${catLower} kids worksheet, kids worksheet, kids worksheet pdf, kids worksheets free, kids worksheets printable, ${catLower} worksheets`;

// Unique 150-250 word intro copy above the grid (SEO TASK-08).
const intro = CATEGORY_INTROS[category];

// Related topic-guide pillar page per category (SEO: cluster cross-linking).
const CATEGORY_GUIDES: Record<string, { href: string; label: string }> = {
    'Alphabet & Tracing': { href: '/worksheets/alphabet-tracing', label: 'Alphabet tracing guide & starter pack' },
    Math: { href: '/worksheets/counting-numbers', label: 'Counting & numbers guide & starter pack' },
    Coloring: { href: '/worksheets/coloring-pages', label: 'Coloring guide & favorite pages' },
    Writing: { href: '/worksheets/writing-practice', label: 'Writing practice guide & starter pack' },
};
const categoryGuide = CATEGORY_GUIDES[category];
---

<Base pageTitle={pageTitle} description={description} path={path} keywords={pageKeywords}>
    <BrowseLayout
        kicker="Browse by category"
        title={category}
        blurb={`Every free printable ${category.toLowerCase()} resource in the library — filter by age group, then download and print.`}
        empty={`No ${category.toLowerCase()} worksheets match your filters.`}
        {items}
        basePath={basePath}
        page={page}
        {totalPages}
        {intro}
    />
    {page === 1 && categoryGuide && (
        <section class="mx-auto w-full max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
            <a
                href={categoryGuide.href}
                class="block rounded-2xl border border-pink-200 bg-pink-50/60 p-5 transition-colors hover:border-pink-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-pink-900"
            >
                <p class="font-mono text-[11px] uppercase tracking-widest text-pink-600 dark:text-pink-400">Guide</p>
                <p class="mt-1 font-semibold text-ink dark:text-neutral-100">
                    {categoryGuide.label} →
                </p>
            </a>
        </section>
    )}
</Base>

<script>
    // Category behavior: client-side filter + sort over the card grid (§12.2).
    import '../scripts/browse-filters';
</script>
