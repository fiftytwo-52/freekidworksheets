---
// PopupAd.astro — home-only, once-per-session popup ad (§14). Rendered only
// when POPUP_AD.active is true; behavior (open, dismiss via close / backdrop /
// Escape, sessionStorage) lives in scripts/popup.ts. Never co-rendered with
// the sticky footer ad.
import { POPUP_AD } from '../data/site';
const { active, image, aspectRatio, redirectUrl } = POPUP_AD;

const ratioClass = {
    '1:1': 'aspect-square',
    '9:16': 'aspect-[9/16]',
    '16:9': 'aspect-video',
    '4:3': 'aspect-[4/3]',
    '3:4': 'aspect-[3/4]',
}[aspectRatio] ?? 'aspect-square';
---

{
    active && (
        <div
            id="popup-ad"
            class="popup-backdrop"
            role="dialog"
            aria-modal="true"
            aria-label="Advertisement"
            hidden
            aria-hidden="true"
        >
            <div
                class="popup-panel relative max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-slate-800"
            >
                <button
                    type="button"
                    data-popup-close
                    class="absolute right-2 top-2 z-10 grid h-8 w-8 place-items-center rounded-full bg-slate-900/60 text-white transition-colors hover:bg-slate-900"
                    aria-label="Close advertisement"
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        class="h-5 w-5"
                        aria-hidden="true"
                    >
                        <path d="M6 6l12 12M18 6 6 18"></path>
                    </svg>
                </button>

                {redirectUrl ? (
                    <a href={redirectUrl} rel="noopener noreferrer">
                        <img
                            src={image}
                            alt="Advertisement"
                            class={`w-full ${ratioClass} object-cover`}
                            loading="eager"
                        />
                    </a>
                ) : (
                    <img
                        src={image}
                        alt="Advertisement"
                        class={`w-full ${ratioClass} object-cover`}
                        loading="eager"
                    />
                )}
            </div>
        </div>
    )
}
