---
// LibraryPage.astro — shared renderer for the language-specific worksheet
// libraries (§11.2). Each language version of the site gets its own library:
//   lang="en" (default) → /worksheets           — English worksheets only
//   lang="ne"           → /worksheets/nepali    — Nepali worksheets only
//   lang="es"           → /worksheets/spanish   — Spanish worksheets only
// Fetches + paginates its own data so the thin route files only pass the
// page number and language.
import Base from '../layouts/Base.astro';
import BrowseLayout from './BrowseLayout.astro';
import { BROWSE_PAGES } from '../data/site';
import {
    getEnglishWorksheets,
    getNepaliWorksheets,
    getSpanishWorksheets,
    paginate,
} from '../lib/content';

interface Props {
    /** 1-based page number (page 1 = the bare path, §9.2). */
    page: number;
    /** Library language: 'en' (default), 'ne' (Nepali), or 'es' (Spanish). */
    lang?: 'en' | 'ne' | 'es';
}
const { page, lang = 'en' } = Astro.props;

const configKey = lang === 'ne' ? 'nepali' : lang === 'es' ? 'spanish' : 'worksheets';
const config = BROWSE_PAGES[configKey];
const langItems =
    lang === 'ne'
        ? await getNepaliWorksheets()
        : lang === 'es'
          ? await getSpanishWorksheets()
          : await getEnglishWorksheets();
const { items, totalPages } = paginate(langItems, page);

// Page 1 lives at the bare path so there are no duplicate URLs (§9.2).
const path = page === 1 ? config.path : `${config.path}/page/${page}`;
// config.title is kept short so every paginated <title> stays under 60 chars
// including the site suffix (SEO TASK-13); config.h1 is the longer visible
// heading.
const pageTitle = page === 1 ? config.title : `${config.title} — page ${page}`;
const description =
    page === 1
        ? config.blurb
        : `${config.blurb} Page ${page} of ${totalPages}.`;
---

<Base pageTitle={pageTitle} description={description} path={path} lang={lang === 'en' ? undefined : lang}>
    <BrowseLayout
        kicker={config.kicker}
        title={config.h1 ?? config.title}
        blurb={config.blurb}
        empty={config.empty}
        {items}
        basePath={config.path}
        page={page}
        {totalPages}
        tone={lang === 'ne' ? 'green' : lang === 'es' ? 'blue' : 'pink'}
        {lang}
    />

    <!-- Topic guides strip — only on page 1 of the English library (SEO: pillar
     cluster hubs, purely additive). -->
{page === 1 && lang === 'en' && (
    <section class="mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
        <h2 class="text-xl font-semibold tracking-tight text-ink dark:text-neutral-100">
            Learning guides
        </h2>
        <p class="mt-1 text-sm text-body dark:text-neutral-400">
            Parent &amp; teacher guides with ready-to-print sheet packs.
        </p>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {[
                { href: '/worksheets/alphabet-tracing', label: 'Alphabet Tracing', blurb: 'A–Z tracing order, pencil tips & starter pack' },
                { href: '/worksheets/counting-numbers', label: 'Counting & Numbers', blurb: 'Number sense by age & counting games' },
                { href: '/worksheets/coloring-pages', label: 'Coloring Pages', blurb: 'Picking the right page & coloring tips' },
                { href: '/worksheets/writing-practice', label: 'Writing Practice', blurb: 'Pre-writing skills through play' },
                { href: '/worksheets/shapes-for-kids', label: 'Shapes for Kids', blurb: 'First geometry: trace, count & find' },
                { href: '/dashain-tihar-worksheets', label: 'Dashain & Tihar Pack', blurb: 'Festival activity sheets for kids' },
            ].map((g) => (
                <a
                    href={g.href}
                    class="block rounded-2xl border border-neutral-200 bg-white p-5 transition-colors hover:border-pink-300 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-pink-900"
                >
                    <p class="font-semibold text-ink dark:text-neutral-100">{g.label}</p>
                    <p class="mt-1 text-sm text-body dark:text-neutral-400">{g.blurb}</p>
                </a>
            ))}
        </div>
    </section>
    )}
</Base>

<script>
    // Library behavior: client-side filter + sort over the card grid (§12.2).
    import '../scripts/browse-filters';
</script>
