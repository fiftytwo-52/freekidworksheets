---
// Brand.astro — the FreeKidWorksheets logo lockup (v2, 2026-10-13).
// Mark: smiling-worksheet icon (blue rounded square, /assets/icon-pink.svg).
// Wordmark: Baloo 2, single line — "free" navy #1E3A8A +
// "kidworksheets" orange #F97316.
interface Props {
    /** Size tier: 'md' (header) or 'sm' (footer). */
    size?: 'md' | 'sm';
    /** Extra Tailwind classes. */
    class?: string;
}
const { size = 'md', class: className = '' } = Astro.props;

const mark = size === 'md' ? 'h-10 w-10' : 'h-9 w-9';
const wordmark = size === 'md' ? 'text-[18px] sm:text-[19px]' : 'text-[16px]';
---

<a
    href="/"
    class:list={['site-brand flex items-center gap-2', className]}
    aria-label="Free Kid Worksheets — home"
>
    <!-- Mark: v2 smiling-worksheet icon -->
    <span
        class:list={[
            'grid shrink-0 place-items-center overflow-hidden rounded-xl transition-transform hover:scale-105',
            mark,
        ]}
        aria-hidden="true"
    >
        <img
            src="/assets/icon-pink.svg"
            alt="Free Kid Worksheets logo"
            width="40"
            height="40"
            class="h-full w-full object-contain"
            loading="eager"
            decoding="async"
        />
    </span>

    <!-- Wordmark: single-line "freekidworksheets" in Baloo 2 -->
    <span
        class:list={[
            'font-logo font-extrabold lowercase leading-none tracking-tight whitespace-nowrap',
            wordmark,
        ]}
    >
        <span class="text-brand-navy dark:text-[#fff4e0]">free</span><span
            class="text-brand-orange"
        >
            kidworksheets
        </span>
    </span>
</a>
