---
// Brand.astro — the FreeKidWorksheets logo lockup (v2, 2026-10-13).
// Mark: smiling-worksheet icon (blue rounded square, /assets/icon-pink.svg).
// Wordmark: Baloo 2, stacked two lines — "freekid" navy #1E3A8A over
// "worksheets" orange #F97316, matching logo.svg.
interface Props {
    /** Size tier: 'md' (header) or 'sm' (footer). */
    size?: 'md' | 'sm';
    /** Extra Tailwind classes. */
    class?: string;
}
const { size = 'md', class: className = '' } = Astro.props;

const mark = size === 'md' ? 'h-10 w-10' : 'h-9 w-9';
const line1 = size === 'md' ? 'text-[19px]' : 'text-[17px]';
const line2 = size === 'md' ? 'text-[13px]' : 'text-[12px]';
---

<a
    href="/"
    class:list={['site-brand flex items-center gap-2', className]}
    aria-label="Free Kid Worksheets — home"
>
    <!-- Mark: v2 smiling-worksheet icon -->
    <span
        class:list={[
            'grid shrink-0 place-items-center overflow-hidden rounded-xl transition-transform hover:scale-105',
            mark,
        ]}
        aria-hidden="true"
    >
        <img
            src="/assets/icon-pink.svg"
            alt="Free Kid Worksheets logo"
            width="40"
            height="40"
            class="h-full w-full object-contain"
            loading="eager"
            decoding="async"
        />
    </span>

    <!-- Wordmark: stacked "freekid" / "worksheets" in Baloo 2 -->
    <span class="flex flex-col leading-none">
        <span
            class:list={[
                'font-logo font-extrabold lowercase tracking-tight text-brand-navy dark:text-[#fff4e0]',
                line1,
            ]}
        >
            freekid
        </span>
        <span
            class:list={[
                'font-logo font-bold lowercase tracking-wide text-brand-orange',
                line2,
            ]}
        >
            worksheets
        </span>
    </span>
</a>
