---
// Brand.astro — the FreeKidWorksheets wordmark (DESIGN.md §2.1, on the
// MASTER-INSTRUCTION §10.2 brand). Uses the custom app icon in assets
// beside the "FreeKidWorksheets" wordmark in Geist 600.
interface Props {
    /** Size tier: 'md' (header) or 'sm' (footer). */
    size?: 'md' | 'sm';
    /** Extra Tailwind classes. */
    class?: string;
}
const { size = 'md', class: className = '' } = Astro.props;

const mark = size === 'md' ? 'h-8 w-8' : 'h-7 w-7';
const word = size === 'md' ? 'text-[17px]' : 'text-[15px]';
---

<a
    href="/"
    class:list={['site-brand flex items-center gap-2.5', className]}
    aria-label="Free Kid Worksheets — home"
>
    <!-- Mark: custom app icon from assets -->
    <span
        class:list={[
            'grid shrink-0 place-items-center overflow-hidden rounded-lg transition-transform hover:scale-105',
            mark,
        ]}
        aria-hidden="true"
    >
        <img
            src="/assets/icon-pink.svg"
            alt=""
            width="32"
            height="32"
            class="h-full w-full object-contain"
            loading="eager"
            decoding="async"
        />
    </span>

    <!-- Wordmark: lowercase "freekidworksheets" -->
    <span
        class:list={[
            'whitespace-nowrap font-bold lowercase leading-none tracking-tight',
            word,
        ]}
    >
        <span class="text-ink dark:text-neutral-100">freekid</span><span class="text-pink-500 dark:text-pink-400">worksheets</span>
    </span>
</a>
