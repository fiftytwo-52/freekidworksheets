---
// FilterPanel.astro — client-side filter/sort controls for library & home
// (§11.2). The selects are populated at runtime from the visible cards'
// data-* attributes by scripts/browse-filters.ts, and the whole panel is
// toggled on mobile by scripts/theme.ts ([data-filter-toggle]). No-JS note:
// the panel simply does nothing without the script (page still lists items).
import Icon from './Icon.astro';

interface Props {
    /** Message shown when a filter matches nothing. */
    empty?: string;
    /** Show the Kind (All / Worksheets / Question papers) control? */
    showKind?: boolean;
}
const { empty = 'No worksheets match your filters.', showKind = false } =
    Astro.props;
---

<section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800" aria-label="Filter and sort worksheets">
    <!-- Mobile toggle (theme.ts toggles .filter-open on the panel) -->
    <button
        type="button"
        data-filter-toggle
        aria-expanded="false"
        aria-controls="filter-panel"
        class="flex w-full items-center justify-between rounded-xl bg-indigo-50 px-4 py-2.5 font-semibold text-indigo-700 md:hidden dark:bg-indigo-950/50 dark:text-indigo-300"
    >
        <span class="flex items-center gap-2">
            <Icon name="grid" class="h-4 w-4" />
            Filters & sort
        </span>
        <Icon name="chevron-down" class="h-4 w-4" />
    </button>

    <div id="filter-panel" data-filter-panel class="hidden md:block">
        <form class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5" role="search">
            <label class="block lg:col-span-2">
                <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    Search
                </span>
                <span class="relative block">
                    <Icon name="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
                    <input
                        type="search"
                        data-filter-input
                        placeholder="Search titles, topics…"
                        class="w-full rounded-xl border border-slate-300 bg-slate-50 py-2 pl-9 pr-3 text-sm text-slate-800 placeholder:text-slate-400 focus:border-indigo-500 focus:bg-white focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
                    />
                </span>
            </label>

            <label class="block">
                <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    Category
                </span>
                <select
                    data-filter-select="category"
                    class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
                >
                    <option value="">All categories</option>
                </select>
            </label>

            <label class="block">
                <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    Age group
                </span>
                <select
                    data-filter-select="age"
                    class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
                >
                    <option value="">All ages</option>
                </select>
            </label>

            {showKind && (
                <label class="block">
                    <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                        Kind
                    </span>
                    <select
                        data-filter-select="kind"
                        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
                    >
                        <option value="">All kinds</option>
                        <option value="worksheet">Worksheets</option>
                        <option value="question">Question papers</option>
                    </select>
                </label>
            )}

            <label class="block">
                <span class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                    Sort by
                </span>
                <select
                    data-filter-select="sort"
                    class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-800 focus:border-indigo-500 focus:outline-none dark:border-slate-600 dark:bg-slate-900 dark:text-slate-100"
                >
                    <option value="latest">Latest</option>
                    <option value="az">A to Z</option>
                </select>
            </label>
        </form>

        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
            <span data-result-count>0 results</span>
        </p>
        <p data-empty-state hidden class="mt-2 rounded-xl bg-amber-50 px-3 py-2 text-sm font-medium text-amber-800 dark:bg-amber-950/40 dark:text-amber-300">
            {empty}
        </p>
    </div>
</section>
