---
// AdSlot.astro — clearly-labeled placeholder ad slots (§14). Real AdSense
// units are wired post-dev; during development these render an unobtrusive
// box with a "Sponsored"/"Advertisement" label and correct dimensions.
//
// Sticky and popup slots support a close "×" button (inline removal).
interface Props {
    /** Slot class drives styling: ad-leaderboard | ad-rectangle | ad-banner |
     *  ad-sidebar | ad-sticky. */
    variant:
        | 'leaderboard'
        | 'rectangle'
        | 'banner'
        | 'sidebar'
        | 'sticky';
    /** Show a small "Sponsored" label above the box. */
    label?: boolean;
    /** The sticky bar may be closed with a ×. */
    closable?: boolean;
    class?: string;
}
const { variant, label = true, closable = false, class: className = '' } =
    Astro.props;

// Minimal inline placeholder glyph (label line + dimmed text is enough).
const copy: Record<Props['variant'], { box: string; size: string }> = {
    leaderboard: { box: 'h-20', size: '728×90' },
    rectangle: { box: 'h-[250px] w-[300px]', size: '300×250' },
    banner: { box: 'h-20 w-full max-w-[728px]', size: '728×90' },
    sidebar: { box: 'h-[600px] w-[160px]', size: '160×600' },
    sticky: { box: 'h-[50px] w-full max-w-[320px]', size: '320×50' },
};
---

<div
    class:list={[
        'ad-slot',
        variant === 'sticky' ? 'ad-sticky px-4 py-1' : '',
        className,
    ]}
    data-ad-slot={variant}
>
    {closable && (
        <button
            type="button"
            class="absolute right-2 top-1 grid h-6 w-6 place-items-center rounded-full bg-slate-200 text-slate-600 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-300"
            aria-label="Close advertisement"
            onclick="this.closest('.ad-slot').remove()"
        >
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="h-4 w-4"
                aria-hidden="true"
            >
                <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
        </button>
    )}

    {label && (
        <span class="ad-label">{variant === 'sticky' ? 'Advertisement' : 'Advertisement'}</span>
    )}

    <span class:list={['ad-box', copy[variant].box]} aria-hidden="true">
        <span class="px-2 text-xs">
            {copy[variant].size} · ad network goes live post-dev
        </span>
    </span>
</div>
