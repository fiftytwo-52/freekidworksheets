---
// nepali.astro — dedicated Nepali worksheets page
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import FilterPanel from '../components/FilterPanel.astro';
import Icon from '../components/Icon.astro';
import WorksheetCard from '../components/WorksheetCard.astro';
import { getNepaliWorksheets } from '../lib/content';
import { faqJsonLd, websiteJsonLd } from '../lib/seo';

// Build-time data for Nepali feed
const nepaliWorksheets = await getNepaliWorksheets();

const DESCRIPTION =
    'निःशुल्क नेपाली कार्यपत्रहरू — Free printable Nepali worksheets for kids. Practice Nepali Ka Kha Ga (क ख ग), Nepali Numbers (१ देखि १०), word matching, and handwriting tracing.';

const EYEBROW =
    'font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500';
const PILL_PRIMARY =
    'inline-flex items-center gap-1.5 rounded-full bg-pink-500 px-6 py-2.5 text-sm font-bold text-white transition-transform hover:scale-105 hover:bg-pink-600 shadow-sm dark:bg-pink-600';
const PILL_SECONDARY =
    'inline-flex items-center gap-1.5 rounded-full border-2 border-yellow-300 bg-yellow-50 px-4 py-2 text-sm font-bold text-yellow-900 transition-transform hover:scale-105 hover:bg-yellow-100 dark:border-yellow-600 dark:bg-yellow-900/40 dark:text-yellow-200';
---

<Base
    pageTitle="Nepali Worksheets for Kids - नेपाली कार्यपत्रहरू"
    description={DESCRIPTION}
    path="/nepali"
    jsonLd={[websiteJsonLd(), faqJsonLd()]}
>
    <!-- 1. Hero — same wide 2-column layout as the English home, light green tone -->
    <section class="border-b border-neutral-200/80 bg-gradient-to-br from-emerald-200 via-teal-100 to-amber-100 dark:border-neutral-800 dark:from-emerald-950/70 dark:via-teal-950/60 dark:to-neutral-900">
        <div class="mx-auto w-full max-w-7xl px-4 py-5 sm:px-6 sm:py-14 lg:px-8">
            <div class="grid grid-cols-1 items-center gap-5 lg:grid-cols-12 lg:gap-12">
                <!-- Left column: Headline, intro text, & primary actions -->
                <div class="text-left lg:col-span-7">
                    <h1 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl dark:text-white">
                        नेपाली <span class="text-emerald-500">कार्यपत्रहरू</span> (Nepali Worksheets)
                    </h1>
                    <p class="mt-3 hidden max-w-xl text-base font-normal leading-relaxed text-neutral-600 sm:block sm:text-lg dark:text-neutral-300">
                        निःशुल्क डाउनलोड र प्रिन्ट गर्नुहोस् — क ख ग, गन्ती, र शब्द अभ्यास!
                    </p>
                    <div class="mt-3 flex flex-wrap items-center gap-2.5">
                        <a
                            href="/worksheets/nepali"
                            class="inline-flex items-center gap-1.5 rounded-full bg-pink-500 px-4 py-2 text-xs font-bold text-white shadow-sm transition hover:scale-105 hover:bg-pink-600 active:scale-95 sm:px-6 sm:py-2.5 sm:text-sm"
                        >
                            सबै कार्यपत्र हेर्नुहोस्
                            <Icon name="arrow-right" class="h-3.5 w-3.5 sm:h-4 sm:w-4" />
                        </a>
                        {nepaliWorksheets.length > 0 && (
                            <p class="inline-flex items-center gap-1.5 rounded-full border border-white/60 bg-white/70 px-2.5 py-1.5 text-xs font-semibold text-neutral-700 shadow-sm backdrop-blur-sm sm:px-4 sm:py-2 sm:text-sm dark:border-neutral-700 dark:bg-neutral-900/70 dark:text-neutral-200">
                                <Icon name="grid" class="h-3.5 w-3.5 text-emerald-500" />
                                <strong class="font-extrabold text-neutral-900 dark:text-white">{nepaliWorksheets.length}+</strong>
                                <span class="hidden sm:inline"> कार्यपत्रहरू उपलब्ध</span>
                                <span class="sm:hidden">उपलब्ध</span>
                            </p>
                        )}
                    </div>
                </div>

                <!-- Right column: Interactive search & quick popular topics card -->
                <div class="lg:col-span-5">
                    <div class="rounded-3xl border border-neutral-200/80 bg-white/90 p-3 shadow-sm backdrop-blur-sm sm:p-6 dark:border-neutral-800 dark:bg-neutral-900/90">
                        <h2 class="hidden items-center gap-2 text-sm font-bold text-neutral-900 sm:flex dark:text-neutral-100">
                            <Icon name="search" class="h-4 w-4 text-emerald-500" />
                            कार्यपत्र खोज्नुहोस् (Search)
                        </h2>
                        <p class="mt-1 hidden text-xs text-neutral-500 sm:block dark:text-neutral-400">
                            शीर्षक, विषय, वा ४-अंक कोडद्वारा खोज्नुहोस्।
                        </p>

                        <!-- Hero Search Form -->
                        <form action="/search" method="get" role="search" class="mt-3 flex items-center gap-2 rounded-full border border-neutral-300/90 bg-white p-1.5 shadow-2xs transition focus-within:border-emerald-500 focus-within:ring-4 focus-within:ring-emerald-500/10 dark:border-neutral-700 dark:bg-neutral-800">
                            <label for="hero-search" class="sr-only">Search Nepali worksheets</label>
                            <input
                                id="hero-search"
                                type="search"
                                name="q"
                                placeholder="खोज्नुहोस् (e.g., Ka Kha, 2001)..."
                                class="w-full bg-transparent px-3 py-1 text-sm font-medium text-neutral-800 placeholder:text-neutral-400 focus:outline-none dark:text-neutral-100"
                            />
                            <button
                                type="submit"
                                class="inline-flex h-9 shrink-0 items-center justify-center rounded-full bg-pink-500 px-4 text-xs font-bold text-white shadow-2xs transition hover:bg-pink-600 active:scale-95"
                            >
                                खोज्नुहोस्
                            </button>
                        </form>

                        <!-- Popular Topic Chips -->
                        <div class="mt-4 hidden border-t border-neutral-100 pt-3 sm:block dark:border-neutral-800">
                            <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                                लोकप्रिय विषयहरू
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                {['Nepali', 'Tracing', 'Alphabet', 'Numbers', 'Matching', 'Colouring'].map((tag) => (
                                    <a
                                        href={`/search?q=${encodeURIComponent(tag)}`}
                                        class="rounded-full border border-neutral-200 bg-neutral-50/80 px-2.5 py-1 text-xs font-medium text-neutral-700 transition hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:hover:text-emerald-300"
                                    >
                                        {tag}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Nepali Worksheets Feed -->
    <section
        class="w-full max-w-none px-4 py-7 sm:px-6 sm:py-12 lg:px-8"
        aria-labelledby="nepali-heading"
    >
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class={EYEBROW}>Nepali Learning Materials</p>
                <h2
                    id="nepali-heading"
                    class="mt-2 text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100"
                >
                    सबै नेपाली कार्यपत्रहरू (All Nepali Worksheets)
                </h2>
            </div>
            <a href="/worksheets/nepali" class={PILL_SECONDARY}>
                सबै कार्यपत्र हेर्नुहोस् (All Worksheets)
                <Icon name="arrow-right" class="h-4 w-4" />
            </a>
        </div>

        {
            nepaliWorksheets.length > 0 ? (
                <div data-filter-region class="mt-6">
                    <FilterPanel empty="कुनै कार्यपत्र भेटिएन (No worksheets found)." lang="ne" />
                    <div
                        class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4"
                        data-card-grid
                    >
                        {nepaliWorksheets.slice(0, 16).map((entry) => (
                            <WorksheetCard entry={entry} />
                        ))}
                    </div>
                </div>
            ) : (
                <p class="mt-6 rounded-2xl border-2 border-dashed border-emerald-200 bg-emerald-50/50 px-6 py-12 text-center font-medium text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-200">
                    थप नेपाली कार्यपत्रहरू चाँडै आउँदैछन्! More Nepali worksheets are coming soon!
                </p>
            )
        }
    </section>

    <!-- 3. Free Banner -->
    <section class="w-full max-w-none px-4 pb-4 sm:px-6 lg:px-8">
        <div
            class="rounded-3xl border-2 border-yellow-200 bg-amber-50 px-6 py-10 text-center dark:border-yellow-900/50 dark:bg-neutral-900"
        >
            <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-amber-700 dark:text-yellow-400">१००% निःशुल्क (Always Free)</p>
            <h2
                class="mt-2 text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100"
            >
                नेपाली भाषा सिकाइ — सजिलै प्रिन्ट गर्नुहोस्
            </h2>
            <p
                class="mx-auto mt-3 max-w-xl text-base font-medium leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
                नेपाली बालबालिका तथा विदेशमा रहेका नेपाली परिवारका लागि क ख ग, गन्ती र शब्द अभ्यासका उच्च गुणस्तरका कार्यपत्रहरू निःशुल्क उपलब्ध छन्।
            </p>
            <a href="/worksheets/nepali" class={`${PILL_PRIMARY} mt-6`}>
                सबै कार्यपत्रहरू हेर्नुहोस्
                <Icon name="arrow-right" class="h-4 w-4" />
            </a>
        </div>
    </section>

    <!-- 4. FAQ -->
    <section class="w-full max-w-none px-4 pb-16 sm:px-6 lg:px-8">
        <Faq />
    </section>

</Base>

<script>
    import '../scripts/browse-filters';
</script>
