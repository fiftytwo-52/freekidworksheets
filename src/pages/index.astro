---
// index.astro — home page (English worksheets default feed)
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import FilterPanel from '../components/FilterPanel.astro';
import Icon from '../components/Icon.astro';
import WorksheetCard from '../components/WorksheetCard.astro';
import { POPULAR_TOPICS } from '../data/site';
import { getEnglishWorksheets } from '../lib/content';
import { faqJsonLd, websiteJsonLd } from '../lib/seo';

// Build-time data for English feed
const all = await getEnglishWorksheets();
const featured = all.slice(0, 8); // 8 latest english worksheets


const DESCRIPTION =
    'Free printable worksheets for kids — download and print high quality activity worksheet images for nursery through grade 6.';

const EYEBROW =
    'font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500';
const PILL_PRIMARY =
    'inline-flex items-center gap-1.5 rounded-full bg-pink-500 px-6 py-2.5 text-sm font-bold text-white transition-transform hover:scale-105 hover:bg-pink-600 shadow-sm dark:bg-pink-600';
const PILL_SECONDARY =
    'inline-flex items-center gap-1.5 rounded-full border-2 border-yellow-300 bg-yellow-50 px-4 py-2 text-sm font-bold text-yellow-900 transition-transform hover:scale-105 hover:bg-yellow-100 dark:border-yellow-600 dark:bg-yellow-900/40 dark:text-yellow-200';
---

<Base
    pageTitle="Free Printable Worksheets for Kids"
    description={DESCRIPTION}
    path="/"
    jsonLd={[websiteJsonLd(), faqJsonLd()]}
>
    <!-- 1. Hero — Wide 2-column layout with soft low-opacity gradient background -->
    <section class="border-b border-neutral-200/80 bg-gradient-to-br from-pink-200 via-purple-100 to-amber-100 dark:border-neutral-800 dark:from-pink-950/70 dark:via-purple-950/60 dark:to-neutral-900">
        <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
                <!-- Left column: Headline, intro text, & primary actions -->
                <div class="text-left lg:col-span-7">
                    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl dark:text-white">
                        Fun Learning Sheets <span class="text-pink-500">for Kids</span>
                    </h1>
                    <p class="mt-3 max-w-xl text-base font-normal leading-relaxed text-neutral-600 sm:text-lg dark:text-neutral-300">
                        Find printable worksheets for preschool through primary grades, from alphabet tracing and math to coloring and vocabulary.
                    </p>
                    <div class="mt-6 flex flex-wrap items-center gap-3">
                        <a
                            href="/worksheets"
                            class="inline-flex items-center gap-2 rounded-full bg-pink-500 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:scale-105 hover:bg-pink-600 active:scale-95"
                        >
                            Browse All Worksheets
                            <Icon name="arrow-right" class="h-4 w-4" />
                        </a>
                    </div>
                </div>

                <!-- Right column: Interactive search & quick popular topics card -->
                <div class="lg:col-span-5">
                    <div class="rounded-3xl border border-neutral-200/80 bg-white/90 p-5 shadow-sm backdrop-blur-sm sm:p-6 dark:border-neutral-800 dark:bg-neutral-900/90">
                        <h2 class="flex items-center gap-2 text-sm font-bold text-neutral-900 dark:text-neutral-100">
                            <Icon name="search" class="h-4 w-4 text-pink-500" />
                            Search Worksheets
                        </h2>
                        <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
                            Find activities by title, topic, subject, or 4-digit code.
                        </p>

                        <!-- Hero Search Form -->
                        <form action="/search" method="get" role="search" class="mt-3 flex items-center gap-2 rounded-full border border-neutral-300/90 bg-white p-1.5 shadow-2xs transition focus-within:border-pink-500 focus-within:ring-4 focus-within:ring-pink-500/10 dark:border-neutral-700 dark:bg-neutral-800">
                            <label for="hero-search" class="sr-only">Search worksheets</label>
                            <input
                                id="hero-search"
                                type="search"
                                name="q"
                                placeholder="e.g., tracing, math, shapes, 1001..."
                                class="w-full bg-transparent px-3 py-1 text-sm font-medium text-neutral-800 placeholder:text-neutral-400 focus:outline-none dark:text-neutral-100"
                            />
                            <button
                                type="submit"
                                class="inline-flex h-9 shrink-0 items-center justify-center rounded-full bg-pink-500 px-4 text-xs font-bold text-white shadow-2xs transition hover:bg-pink-600 active:scale-95"
                            >
                                Search
                            </button>
                        </form>

                        <!-- Popular Topic Chips -->
                        <div class="mt-4 border-t border-neutral-100 pt-3 dark:border-neutral-800">
                            <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                                Popular Topics
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                {POPULAR_TOPICS.slice(0, 8).map((topic) => (
                                    <a
                                        href={`/search?q=${encodeURIComponent(topic.query)}`}
                                        class="rounded-full border border-neutral-200 bg-neutral-50/80 px-2.5 py-1 text-xs font-medium text-neutral-700 transition hover:border-pink-300 hover:bg-pink-50 hover:text-pink-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:hover:text-pink-300"
                                    >
                                        {topic.label}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Featured worksheets — English feed -->
    <section
        class="w-full max-w-none px-4 py-12 sm:px-6 lg:px-8"
        aria-labelledby="featured-heading"
    >
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class={EYEBROW}>Worksheet Collection</p>
                <h2
                    id="featured-heading"
                    class="mt-2 text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100"
                >
                    Featured Worksheets
                </h2>
            </div>
            <a href="/worksheets" class={PILL_SECONDARY}>
                View all worksheets
                <Icon name="arrow-right" class="h-4 w-4" />
            </a>
        </div>

        {
            featured.length > 0 ? (
                <div data-filter-region class="mt-6">
                    <FilterPanel empty="No worksheets match your filters." />
                    <div
                        class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"
                        data-card-grid
                    >
                        {featured.map((entry) => (
                            <WorksheetCard entry={entry} />
                        ))}
                    </div>
                </div>
            ) : (
                <p class="mt-6 rounded-2xl border-2 border-dashed border-cyan-200 bg-cyan-50/50 px-6 py-12 text-center font-medium text-cyan-800 dark:border-cyan-800 dark:bg-cyan-950/50 dark:text-cyan-200">
                    The worksheet library is being prepared — check back soon!
                </p>
            )
        }
    </section>

    <!-- 3. All-free banner -->
    <section class="w-full max-w-none px-4 pb-4 sm:px-6 lg:px-8">
        <div
            class="rounded-3xl border-2 border-yellow-200 bg-amber-50 px-6 py-10 text-center dark:border-yellow-900/50 dark:bg-neutral-900"
        >
            <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-amber-700 dark:text-yellow-400">Always 100% Free</p>
            <h2
                class="mt-2 text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100"
            >
                No Signup. No Fees. Just Print & Learn!
            </h2>
            <p
                class="mx-auto mt-3 max-w-xl text-base font-medium leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
                Every worksheet on freekidworksheets.com is completely free to download and print — for parents, teachers, and homeschoolers worldwide.
            </p>
            <a href="/worksheets" class={`${PILL_PRIMARY} mt-6`}>
                Browse full library
                <Icon name="arrow-right" class="h-4 w-4" />
            </a>
        </div>
    </section>

    <!-- 4. Popular Worksheet Categories & Learning Topics -->
    <section class="w-full max-w-none px-4 py-8 sm:px-6 lg:px-8" aria-labelledby="topics-heading">
        <div class="rounded-3xl border-2 border-cyan-100 bg-cyan-50/40 p-6 sm:p-8 dark:border-cyan-900/40 dark:bg-neutral-900">
            <div class="text-center sm:text-left">
                <p class={EYEBROW}>Quick Discovery</p>
                <h2 id="topics-heading" class="mt-1 text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100">
                    Explore Popular Topics & Free Worksheets
                </h2>
                <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">
                    Find high-quality printable worksheets and activity sheets across core foundational subjects, early childhood topics, and creative activities.
                </p>
            </div>
            <div class="mt-6 flex flex-wrap gap-2.5">
                {POPULAR_TOPICS.map((topic) => (
                    <a
                        href={`/search?q=${encodeURIComponent(topic.query)}`}
                        class="inline-flex items-center gap-1.5 rounded-2xl border border-neutral-200 bg-white px-4 py-2.5 text-xs font-bold text-neutral-800 shadow-sm transition hover:border-pink-300 hover:bg-pink-50 hover:text-pink-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:border-pink-500/50 dark:hover:bg-neutral-700/50 dark:hover:text-pink-300"
                    >
                        <span class="h-2 w-2 rounded-full bg-pink-500"></span>
                        {topic.label}
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- 5. FAQ -->
    <section class="w-full max-w-none px-4 pb-16 sm:px-6 lg:px-8">
        <Faq />
    </section>

</Base>

<script>
    import '../scripts/browse-filters';
</script>
