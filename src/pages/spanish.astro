---
// spanish.astro — dedicated Spanish worksheets page (grafomotricidad, fichas, dibujos para colorear)
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import FilterPanel from '../components/FilterPanel.astro';
import Icon from '../components/Icon.astro';
import WorksheetCard from '../components/WorksheetCard.astro';
import { getSpanishWorksheets } from '../lib/content';
import { faqJsonLd, websiteJsonLd } from '../lib/seo';

// Build-time data for Spanish feed
const spanishWorksheets = await getSpanishWorksheets();

const DESCRIPTION =
    'Fichas gratis en español para niños — grafomotricidad, grafomotricidad 3 años, fichas grafomotricidad para imprimir, dibujos para colorear, trazos y primeras letras. Descarga e imprime gratis.';

const EYEBROW =
    'font-mono text-[11px] font-medium uppercase tracking-widest text-mute dark:text-neutral-500';
const PILL_PRIMARY =
    'inline-flex items-center gap-1.5 rounded-full bg-pink-500 px-6 py-2.5 text-sm font-bold text-white transition-transform hover:scale-105 hover:bg-pink-600 shadow-sm dark:bg-pink-600';
const PILL_SECONDARY =
    'inline-flex items-center gap-1.5 rounded-full border-2 border-yellow-300 bg-yellow-50 px-4 py-2 text-sm font-bold text-yellow-900 transition-transform hover:scale-105 hover:bg-yellow-100 dark:border-yellow-600 dark:bg-yellow-900/40 dark:text-yellow-200';
---

<Base
    pageTitle="Fichas en Español para Niños — Grafomotricidad y Dibujos para Colorear"
    description={DESCRIPTION}
    path="/spanish"
    keywords="grafomotricidad, grafomotricidad 3 años, fichas grafomotricidad, dibujos colorear, dibujos para colorear, fichas grafomotricidad para imprimir, grafomotricidad para niños, fichas en español para niños, spanish worksheets for kids"
    jsonLd={[websiteJsonLd(), faqJsonLd()]}
>
    <!-- 1. Hero — same wide 2-column layout as the English home, light blue tone -->
    <section class="border-b border-neutral-200/80 bg-gradient-to-br from-sky-200 via-blue-100 to-cyan-100 dark:border-neutral-800 dark:from-sky-950/70 dark:via-blue-950/60 dark:to-neutral-900">
        <div class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
                <!-- Left column: Headline, intro text, & primary actions -->
                <div class="text-left lg:col-span-7">
                    <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl lg:text-5xl dark:text-white">
                        Fichas en Español <span class="text-sky-500">para Niños</span> (Spanish Worksheets)
                    </h1>
                    <p class="mt-3 hidden max-w-xl text-base font-normal leading-relaxed text-neutral-600 sm:block sm:text-lg dark:text-neutral-300">
                        Grafomotricidad, trazos, dibujos para colorear — ¡gratis para descargar e imprimir!
                    </p>
                    <div class="mt-6 flex flex-wrap items-center gap-3">
                        <a
                            href="/worksheets/spanish"
                            class="inline-flex items-center gap-2 rounded-full bg-pink-500 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition hover:scale-105 hover:bg-pink-600 active:scale-95"
                        >
                            Ver todas las fichas
                            <Icon name="arrow-right" class="h-4 w-4" />
                        </a>
                        {spanishWorksheets.length > 0 && (
                            <p class="inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/70 px-4 py-2 text-sm font-semibold text-neutral-700 shadow-sm backdrop-blur-sm dark:border-neutral-700 dark:bg-neutral-900/70 dark:text-neutral-200">
                                <Icon name="grid" class="h-4 w-4 text-sky-500" />
                                <span>
                                    <strong class="font-extrabold text-neutral-900 dark:text-white">{spanishWorksheets.length}+</strong>
                                    fichas disponibles
                                </span>
                            </p>
                        )}
                    </div>
                </div>

                <!-- Right column: Interactive search & quick popular topics card -->
                <div class="lg:col-span-5">
                    <div class="rounded-3xl border border-neutral-200/80 bg-white/90 p-3 shadow-sm backdrop-blur-sm sm:p-6 dark:border-neutral-800 dark:bg-neutral-900/90">
                        <h2 class="hidden items-center gap-2 text-sm font-bold text-neutral-900 sm:flex dark:text-neutral-100">
                            <Icon name="search" class="h-4 w-4 text-sky-500" />
                            Buscar fichas (Search)
                        </h2>
                        <p class="mt-1 hidden text-xs text-neutral-500 sm:block dark:text-neutral-400">
                            Busca por título, tema, o código de 4 dígitos.
                        </p>

                        <!-- Hero Search Form -->
                        <form action="/search" method="get" role="search" class="mt-3 flex items-center gap-2 rounded-full border border-neutral-300/90 bg-white p-1.5 shadow-2xs transition focus-within:border-sky-500 focus-within:ring-4 focus-within:ring-sky-500/10 dark:border-neutral-700 dark:bg-neutral-800">
                            <label for="hero-search" class="sr-only">Buscar fichas en español</label>
                            <input
                                id="hero-search"
                                type="search"
                                name="q"
                                placeholder="Buscar fichas (ej. grafomotricidad, colorear, 5001)..."
                                class="w-full bg-transparent px-3 py-1 text-sm font-medium text-neutral-800 placeholder:text-neutral-400 focus:outline-none dark:text-neutral-100"
                            />
                            <button
                                type="submit"
                                class="inline-flex h-9 shrink-0 items-center justify-center rounded-full bg-pink-500 px-4 text-xs font-bold text-white shadow-2xs transition hover:bg-pink-600 active:scale-95"
                            >
                                Buscar
                            </button>
                        </form>

                        <!-- Popular Topic Chips -->
                        <div class="mt-4 hidden border-t border-neutral-100 pt-3 sm:block dark:border-neutral-800">
                            <p class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                                Temas populares
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                {['Grafomotricidad', 'Grafomotricidad 3 años', 'Fichas grafomotricidad', 'Dibujos colorear', 'Trazos', 'Colorear'].map((tag) => (
                                    <a
                                        href={`/search?q=${encodeURIComponent(tag)}`}
                                        class="rounded-full border border-neutral-200 bg-neutral-50/80 px-2.5 py-1 text-xs font-medium text-neutral-700 transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:hover:text-sky-300"
                                    >
                                        {tag}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Spanish Worksheets Feed -->
    <section
        class="w-full max-w-none px-4 py-12 sm:px-6 lg:px-8"
        aria-labelledby="spanish-heading"
    >
        <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class={EYEBROW}>Material educativo en español</p>
                <h2
                    id="spanish-heading"
                    class="mt-2 text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100"
                >
                    Todas las fichas en español (All Spanish Worksheets)
                </h2>
            </div>
            <a href="/worksheets/spanish" class={PILL_SECONDARY}>
                Ver todas las fichas (All Worksheets)
                <Icon name="arrow-right" class="h-4 w-4" />
            </a>
        </div>

        {
            spanishWorksheets.length > 0 ? (
                <div data-filter-region class="mt-6">
                    <FilterPanel empty="No se encontraron fichas (No worksheets found)." lang="es" />
                    <div
                        class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4"
                        data-card-grid
                    >
                        {spanishWorksheets.slice(0, 16).map((entry) => (
                            <WorksheetCard entry={entry} />
                        ))}
                    </div>
                </div>
            ) : (
                <p class="mt-6 rounded-2xl border-2 border-dashed border-emerald-200 bg-emerald-50/50 px-6 py-12 text-center font-medium text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-200">
                    ¡Más fichas en español muy pronto! More Spanish worksheets are coming soon!
                </p>
            )
        }
    </section>

    <!-- 3. Free Banner -->
    <section class="w-full max-w-none px-4 pb-4 sm:px-6 lg:px-8">
        <div
            class="rounded-3xl border-2 border-yellow-200 bg-amber-50 px-6 py-10 text-center dark:border-yellow-900/50 dark:bg-neutral-900"
        >
            <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-amber-700 dark:text-yellow-400">100% Gratis (Always Free)</p>
            <h2
                class="mt-2 text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl dark:text-neutral-100"
            >
                Grafomotricidad y dibujos para colorear — listos para imprimir
            </h2>
            <p
                class="mx-auto mt-3 max-w-xl text-base font-medium leading-relaxed text-neutral-700 dark:text-neutral-300"
            >
                Fichas de grafomotricidad para niños de 3 años, trazos y líneas, dibujos para colorear y primeras letras en español. Todo gratis, sin registro y listo para imprimir en casa o en el aula.
            </p>
            <a href="/worksheets/spanish" class={`${PILL_PRIMARY} mt-6`}>
                Ver todas las fichas
                <Icon name="arrow-right" class="h-4 w-4" />
            </a>
        </div>
    </section>

    <!-- 4. FAQ -->
    <section class="w-full max-w-none px-4 pb-12 sm:px-6 lg:px-8">
        <Faq />
    </section>
</Base>
