---
// /worksheets/page/{n} — static pagination for the English worksheet library
// (§9.2). Page 1 lives at the bare /worksheets path, so this route only emits
// n ≥ 2. The /worksheets library shows English worksheets only — the Nepali
// and Spanish versions of the site have their own libraries
// (/worksheets/nepali, /worksheets/spanish).
import LibraryPage from '../../../components/LibraryPage.astro';
import { getEnglishWorksheets } from '../../../lib/content';
import { PER_PAGE } from '../../../data/site';

export async function getStaticPaths() {
    const items = await getEnglishWorksheets();
    const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
        params: { page: String(i + 2) },
    }));
}

const { page } = Astro.params;
---

<LibraryPage page={Number(page)} />
