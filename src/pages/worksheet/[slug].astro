---
// /worksheet/[slug] — worksheet detail page (§11.3).
// h1 + meta line, large A4 image (print target #print-worksheet),
// description, download/print actions, related grid, LearningResource JSON-LD.
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedGrid from '../../components/RelatedGrid.astro';
import Icon from '../../components/Icon.astro';
import { getRelated } from '../../lib/content';
import { absoluteUrl, breadcrumbJsonLd, excerpt, learningResourceJsonLd } from '../../lib/seo';
import ShareWorksheet from '../../components/ShareWorksheet.astro';
import { categoryPath } from '../../data/site';

export async function getStaticPaths() {
    const entries = await getCollection('worksheets');
    return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { title, category, ageGroup, code, description, image, tags = [], language, colorType } = entry.data;
const languageLabel = { en: 'English', ne: 'Nepali', es: 'Spanish', pt: 'Portuguese' }[language] ?? language;
const printLabel = colorType === 'colorful' ? 'Colorful' : 'Black & white';
const displayTitle = entry.data.shortTitle?.trim() || title;
// Avoid "worksheet worksheet" when the title already contains the word.
const titleLower = title.toLowerCase();
const altText = `Free printable ${titleLower}${titleLower.includes('worksheet') ? '' : ' worksheet'} for ages ${ageGroup}`;
const path = `/worksheet/${entry.slug}`;
const related = await getRelated(entry.slug);
const isLandscape = image.width > image.height;
const pageUrl = absoluteUrl(path);
const categoryUrl = absoluteUrl(categoryPath(category));

// Dedicated lightweight share image: WhatsApp/Facebook scrapers reject the
// full-size PNG og:image (often 400KB+; WhatsApp caps previews ~300KB),
// showing "unsupported image". A 1000px-wide JPEG stays well under the limit.
const ogWidth = 1000;
const ogHeight = Math.round((image.height / image.width) * ogWidth);
const ogAsset = await getImage({ src: image, width: ogWidth, format: 'jpeg', quality: 78 });

const metaDescription =
    entry.data.metaDescription?.trim() ||
    excerpt(description) ||
    `${title} — free printable worksheet for ${ageGroup}.`;
const aboutText = entry.data.about?.trim() || description;

const pageKeywords = Array.from(
    new Set([
        ...tags,
        category,
        `${category.toLowerCase()} for kids worksheet`,
        `${category.toLowerCase()} kids worksheet`,
        'kids worksheet',
        'kids worksheet pdf',
        'kids worksheets free',
        'kids worksheets printable',
    ])
).join(', ');
---

<Base
    pageTitle={displayTitle}
    description={metaDescription}
    path={path}
    keywords={pageKeywords}
    ogImage={ogAsset.src}
    ogImageMeta={{ width: ogWidth, height: ogHeight, type: 'image/jpeg' }}
    printLandscape={isLandscape}
    lang={language === 'ne' || language === 'es' ? language : 'en'}
    jsonLd={[
        learningResourceJsonLd(entry, pageUrl, aboutText),
        breadcrumbJsonLd(absoluteUrl('/'), absoluteUrl('/worksheets'), category, categoryUrl, title),
    ]}
>
    <div class="mx-auto w-full max-w-7xl px-4 pt-8 sm:px-6 lg:px-8">
    <div class="no-print">
        <!-- Breadcrumb -->
        <nav
            aria-label="Breadcrumb"
            class="text-xs font-semibold text-neutral-500 dark:text-neutral-400"
        >
            <ol class="flex flex-wrap items-center gap-2">
                <li><a href="/" class="hover:text-pink-500 hover:underline">Home</a></li>
                <li aria-hidden="true" class="text-neutral-300 dark:text-neutral-600">›</li>
                <li>
                    <a href="/worksheets" class="hover:text-pink-500 hover:underline">
                        Worksheets
                    </a>
                </li>
                <li aria-hidden="true" class="text-neutral-300 dark:text-neutral-600">›</li>
                <li>
                    <a
                        href={categoryPath(category)}
                        class="hover:text-pink-500 hover:underline"
                    >
                        {category}
                    </a>
                </li>
                <li aria-hidden="true" class="text-neutral-300 dark:text-neutral-600">›</li>
                <li
                    aria-current="page"
                    class="truncate font-bold text-neutral-900 dark:text-neutral-100"
                >
                    {title}
                </li>
            </ol>
        </nav>

        <!-- Header: Title + Meta -->
        <header class="mt-4">
            <h1
                class="text-3xl font-extrabold tracking-tight text-neutral-900 sm:text-4xl dark:text-white"
            >
                {title}
            </h1>
            <div
                class="mt-3 flex flex-wrap items-center gap-2 text-xs font-bold"
            >
                <span class="rounded-full bg-pink-100 px-3 py-1 text-pink-700 dark:bg-pink-900/40 dark:text-pink-300">
                    {category}
                </span>
                <span class="rounded-full bg-cyan-100 px-3 py-1 text-cyan-700 dark:bg-cyan-900/40 dark:text-cyan-300">
                    Ages {ageGroup}
                </span>
                {code && (
                    <span class="rounded-full bg-yellow-100 px-3 py-1 font-mono text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">
                        Code: #{code}
                    </span>
                )}
                <span class="rounded-full bg-emerald-100 px-3 py-1 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                    100% Free
                </span>
            </div>
        </header>

        <!-- Action bar above worksheet preview -->
        <div class="mt-6 flex flex-wrap items-center gap-3">
            <a
                href={image.src}
                download={`${entry.slug}.png`}
                onclick={`if(typeof gtag==='function'){gtag('event','worksheet_download',{worksheet_slug:${JSON.stringify(entry.slug)},worksheet_title:${JSON.stringify(title)},worksheet_category:${JSON.stringify(category)}});}`}
                class="inline-flex items-center gap-2 rounded-full bg-pink-500 px-6 py-3 text-sm font-bold text-white shadow-md transition-all hover:scale-105 hover:bg-pink-600 active:scale-95"
            >
                <Icon name="download" class="h-4 w-4" />
                Download Worksheet
            </a>
            <a
                href={`https://pairpaint.com/?worksheet=${encodeURIComponent(absoluteUrl(image.src))}`}
                target="_blank"
                rel="noopener"
                onclick={`if(typeof gtag==='function'){gtag('event','worksheet_paint_in_pairpaint',{worksheet_slug:${JSON.stringify(entry.slug)},worksheet_title:${JSON.stringify(title)},worksheet_category:${JSON.stringify(category)}});}`}
                class="inline-flex items-center gap-2 rounded-full border-2 border-sky-400 bg-sky-100 px-6 py-2.5 text-sm font-bold text-sky-900 shadow-sm transition-all hover:scale-105 hover:bg-sky-200 dark:bg-sky-900/40 dark:text-sky-200"
            >
                <Icon name="pairpaint" class="h-4 w-4" />
                Paint in pairPaint
            </a>
            <button
                type="button"
                onclick={`if(typeof gtag==='function'){gtag('event','worksheet_print',{worksheet_slug:${JSON.stringify(entry.slug)},worksheet_title:${JSON.stringify(title)},worksheet_category:${JSON.stringify(category)}});}window.print();`}
                class="inline-flex items-center gap-2 rounded-full border-2 border-yellow-400 bg-yellow-100 px-6 py-2.5 text-sm font-bold text-yellow-900 shadow-sm transition-all hover:scale-105 hover:bg-yellow-200 dark:bg-yellow-900/40 dark:text-yellow-200"
            >
                <Icon name="print" class="h-4 w-4" />
                Print Worksheet
            </button>
        </div>
    </div>

        <div class="grid gap-8 pt-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <!-- Worksheet A4 Preview (Print target #print-worksheet) -->
    <section class="min-w-0 pb-6">
        <div
            id="print-worksheet"
            class="overflow-hidden rounded-2xl border-2 border-hairline bg-white p-4 shadow-md dark:border-neutral-800 dark:bg-neutral-900 sm:p-8"
        >
            <Image
                src={image}
                alt={altText}
                class="mx-auto h-auto w-full max-w-3xl rounded-lg object-contain"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                widths={[640, 1024, 1400]}
                sizes="(min-width: 1024px) 768px, 100vw"
            />
        </div>
    </section>

            <!-- Sidebar: about, quick facts, share (sticky on desktop) -->
            <aside class="no-print min-w-0 lg:self-start">
                <div class="space-y-4 lg:sticky lg:top-6 lg:max-h-[calc(100vh-3rem)] lg:overflow-y-auto">
                    <div class="rounded-2xl border-2 border-amber-100 bg-amber-50/60 p-6 dark:border-neutral-800 dark:bg-neutral-900/60">
                        <h2 class="text-xs font-extrabold uppercase tracking-wider text-amber-700 dark:text-amber-400">
                            About this worksheet
                        </h2>
                        <p class="mt-3 text-base font-medium leading-relaxed text-neutral-700 dark:text-neutral-300">
                            {aboutText}
                        </p>
                    </div>

                    <div class="rounded-2xl border border-hairline bg-elevated/80 p-5 shadow-2xs dark:border-neutral-800 dark:bg-neutral-900/80">
                        <h2 class="text-xs font-extrabold uppercase tracking-wider text-neutral-600 dark:text-neutral-400">
                            Worksheet details
                        </h2>
                        <dl class="mt-4 space-y-3 text-sm">
                            <div class="flex items-center justify-between gap-3">
                                <dt class="font-semibold text-neutral-500 dark:text-neutral-400">Category</dt>
                                <dd class="text-right font-bold text-neutral-900 dark:text-neutral-100">
                                    <a href={categoryUrl} class="hover:text-pink-500 hover:underline">{category}</a>
                                </dd>
                            </div>
                            <div class="flex items-center justify-between gap-3">
                                <dt class="font-semibold text-neutral-500 dark:text-neutral-400">Ages</dt>
                                <dd class="text-right font-bold text-neutral-900 dark:text-neutral-100">{ageGroup}</dd>
                            </div>
                            {code && (
                                <div class="flex items-center justify-between gap-3">
                                    <dt class="font-semibold text-neutral-500 dark:text-neutral-400">Code</dt>
                                    <dd class="text-right font-mono font-bold text-neutral-900 dark:text-neutral-100">#{code}</dd>
                                </div>
                            )}
                            <div class="flex items-center justify-between gap-3">
                                <dt class="font-semibold text-neutral-500 dark:text-neutral-400">Language</dt>
                                <dd class="text-right font-bold text-neutral-900 dark:text-neutral-100">{languageLabel}</dd>
                            </div>
                            <div class="flex items-center justify-between gap-3">
                                <dt class="font-semibold text-neutral-500 dark:text-neutral-400">Print</dt>
                                <dd class="text-right font-bold text-neutral-900 dark:text-neutral-100">{printLabel}</dd>
                            </div>
                        </dl>
                    </div>

                    <!-- Share This Worksheet (Facebook, Twitter, Instagram, WhatsApp) -->
                    <ShareWorksheet
                        url={pageUrl}
                        title={displayTitle}
                        lang={language === 'ne' ? 'ne' : 'en'}
                        stacked
                    />
                </div>
            </aside>
        </div>
    </div>

    <!-- Policy-safe ad slot: below the worksheet content, above related items -->
    <AdSlot name="worksheet-below-content" />

    <!-- Related Worksheets -->
    {related.length > 0 && (
        <section class="no-print mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
            <RelatedGrid
                title="Related Worksheets"
                items={related}
            />
        </section>
    )}
</Base>
