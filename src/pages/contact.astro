---
// /contact — clean placeholder with a mailto link driven by CONTACT_EMAIL
// (§11.5). Real contact details are filled in post-dev.
import StaticPage from '../components/StaticPage.astro';
import Icon from '../components/Icon.astro';
import SocialFollow from '../components/SocialFollow.astro';
import { CONTACT_EMAIL } from '../data/site';
---
<StaticPage
    pageTitle="Contact"
    description="Get in touch with freekidworksheets.com — questions, feedback, and content requests are always welcome."
    path="/contact"
    eyebrow="Contact"
    heading="Get in touch"
    lede="Questions, feedback, or a worksheet topic you'd love to see? I'd love to hear from you."
>
    <p>
        The fastest way to reach me is by email. I read every message and
        usually reply within a few days.
    </p>

    {CONTACT_EMAIL ? (
        <p>
            <!-- The address stays out of the visible page; the button opens the visitor's email app. -->
            <a
                href={`mailto:${CONTACT_EMAIL}`}
                class="inline-flex items-center gap-2 rounded-full bg-pink-500 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition-transform hover:scale-105 hover:bg-pink-600 active:scale-95 dark:bg-pink-600"
                aria-label="Email me — opens your email app"
            >
                <Icon name="mail" class="h-4 w-4" />
                Email me
            </a>
        </p>
    ) : (
        <p class="rounded-lg border border-dashed border-hairline p-4 text-sm text-mute dark:border-neutral-700 dark:text-neutral-500">
            My contact email is being finalized — full contact details are
            coming soon. In the meantime, thank you for your patience.
        </p>
    )}

    <div class="my-8 rounded-2xl border border-hairline bg-elevated p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900/60">
        <h2 class="text-base font-bold text-ink dark:text-neutral-100">Follow on social media</h2>
        <p class="mt-1 text-sm text-body dark:text-neutral-400">
            Connect with FreeKidWorksheets for new printables, early learning worksheets, and fun updates:
        </p>
        <div class="mt-4">
            <SocialFollow showHeading={false} showLabels={true} size="md" />
        </div>
    </div>

    <p>
        For content requests, tell me the subject and the age group you have
        in mind — the more specific, the better. For any copyright or content
        concern, please include the page URL and I'll look into it right
        away.
    </p>
</StaticPage>
