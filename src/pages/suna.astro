---
// /suna — "Suna – The Counter": immersive full-screen counting app.
// Auto-count (teacher) mode is primary; tally mode one tap away.
// Speech uses the Web Speech API (speechSynthesis) — no backend, no mic,
// no account. `bare` layout: no site nav/footer, no page scroll.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Flag from '../components/Flag.astro';
import { breadcrumbListJsonLd, faqJsonLd } from '../lib/seo';

const PATH = '/suna';
const TITLE = 'Suna: Free Online Counter with Voice';
const DESCRIPTION =
    'Suna is a free online counter with voice in English, Nepali and Portuguese. Auto-count any range for your class, or tap to tally — no app, no signup.';
const KEYWORDS =
    'online counter, free online counter, tally counter, counter with voice, count aloud, classroom counter, suna counter, digital counter, count to 100, contador online, contagem em voz alta, नेपाली काउन्टर, online tasbih counter';

const SUNA_FAQS = [
    {
        question: 'What is Suna – The Counter?',
        answer: 'Suna is a free online counter from Free Kids Worksheets. It works as a tap-to-tally counter and as an auto-counting teacher tool that reads numbers aloud in a voice you choose. It runs entirely in your browser — nothing to install and no account needed.',
    },
    {
        question: 'How does the voice counting work?',
        answer: 'Your browser reads each number aloud using its built-in voices. Pick any installed voice from the dropdown, adjust the speed, and press play. Voices vary by device — phones, tablets and computers each ship their own set.',
    },
    {
        question: 'Can I use Suna as a classroom counting tool?',
        answer: 'Yes — that is what auto-count mode is for. Set any range (for example 1 to 50), choose a clear voice, and press play. Each number appears huge on screen while it is spoken, so the whole class can follow along.',
    },
    {
        question: 'Does the tally counter save my count?',
        answer: 'Your current count is saved in this browser automatically, so a refresh or a closed tab will not lose it. Clearing your browser data will reset it.',
    },
    {
        question: 'Is Suna free? Do I need an account?',
        answer: 'Completely free, no account, no download. Open the page and start counting.',
    },
    {
        question: 'Can I count by 2s, 5s or 10s?',
        answer: 'Yes. In tally mode, choose a step size of 1, 2, 5 or 10 — auto-count mode has its own step control too, plus a pause-between-numbers timer so you can slow the pace down for young learners. You can also set a target number and watch the progress bar fill as you count toward it.',
    },
    {
        question: 'Is Suna available in other languages?',
        answer: 'Yes. The whole Suna app — buttons, games and instructions — works in English, Nepali (नेपाली) and Brazilian Portuguese. Tap the flag in the top bar to switch languages.',
    },
];

const webAppJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Suna – The Counter',
    url: 'https://freekidworksheets.com/suna',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: DESCRIPTION,
    inLanguage: ['en', 'ne', 'pt-BR'],
};
---

<Base
    pageTitle={TITLE}
    description={DESCRIPTION}
    path={PATH}
    keywords={KEYWORDS}
    bare
    jsonLd={[
        webAppJsonLd,
        breadcrumbListJsonLd([{ name: 'Home', url: '/' }, { name: 'Suna – The Counter' }]),
        faqJsonLd(SUNA_FAQS),
    ]}
>
    <div id="suna-app" class="flex h-dvh flex-col overflow-hidden">
        <!-- ===== app header ===== -->
        <header class="flex shrink-0 items-center justify-between gap-2 px-4 py-3">
            <div class="flex items-center gap-2.5">
                <img
                    src="/assets/suna-icon.svg"
                    alt="Suna — the counting buddy"
                    class="h-11 w-11"
                    width="44"
                    height="44"
                />
                <div class="leading-tight">
                    <p class="text-base font-bold tracking-tight text-ink dark:text-neutral-100">Suna</p>
                    <p class="text-[11px] text-mute dark:text-neutral-500" data-i18n="subtitle">The Counter</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a
                    href="/"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Back to Free Kids Worksheets home" data-i18n-aria="homeBtn"
                    title="Home"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
                </a>
                <details class="relative" id="suna-lang-switcher">
                    <summary
                        class="flex h-9 cursor-pointer list-none items-center gap-1 rounded-full border border-hairline bg-elevated px-2.5 text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100 [&::-webkit-details-marker]:hidden"
                        aria-label="Switch language" title="Language"
                    >
                        <span id="suna-lang-flag" class="flex">
                            <span data-flag="en"><Flag code="en" /></span>
                            <span data-flag="ne" hidden><Flag code="ne" /></span>
                            <span data-flag="pt-br" hidden><Flag code="pt-br" /></span>
                        </span>
                        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <ul class="absolute left-0 top-full z-50 mt-2 w-44 overflow-hidden rounded-xl border border-hairline bg-elevated py-1 shadow-lg dark:border-neutral-700 dark:bg-neutral-900">
                        <li><button type="button" data-suna-lang="en" class="flex w-full items-center gap-2.5 px-4 py-2 text-sm font-medium text-body transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"><Flag code="en" />English</button></li>
                        <li><button type="button" data-suna-lang="ne" class="flex w-full items-center gap-2.5 px-4 py-2 text-sm font-medium text-body transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"><Flag code="ne" />नेपाली</button></li>
                        <li><button type="button" data-suna-lang="pt-br" class="flex w-full items-center gap-2.5 px-4 py-2 text-sm font-medium text-body transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"><Flag code="pt-br" />Português (BR)</button></li>
                    </ul>
                </details>
                <a
                    href="https://pairpaint.com"
                    target="_blank"
                    rel="noopener"
                    class="hidden items-center gap-1.5 rounded-full border border-hairline bg-elevated px-3 py-2 text-xs font-semibold text-body transition-colors hover:bg-neutral-100 sm:inline-flex dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
                    title="Open pairPaint — free kids drawing app"
                >
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 4 6 6-10 10H4v-6z"/><path d="m12 6 6 6"/></svg>
                    pairPaint
                </a>
                <button
                    type="button"
                    id="suna-clean-toggle"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Hide controls for a clean display" data-i18n-aria="cleanBtn"
                    title="Clean display (hide controls)"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 9.5 8 9.5 8a17.6 17.6 0 0 1-2.16 3.19M6.61 6.61A17.5 17.5 0 0 0 2.5 12S5.5 20 12 20a9.6 9.6 0 0 0 4.39-1.06"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="m2 2 20 20"/></svg>
                </button>
                <button
                    type="button"
                    id="suna-fullscreen"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Toggle fullscreen" data-i18n-aria="fsBtn"
                    title="Fullscreen"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
                </button>
                <button
                    type="button"
                    id="suna-info-open"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="How to use Suna" data-i18n-aria="infoBtn"
                    title="How to use"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 1 1 3.6 2.4c-.9.4-1.1 1-1.1 1.8"/><path d="M12 17h.01"/></svg>
                </button>
            </div>
        </header>

        <!-- ===== mode switch ===== -->
        <div class="suna-tabs flex shrink-0 justify-center" role="tablist" aria-label="Counter modes">
            <div class="inline-flex rounded-full border border-hairline bg-elevated p-1 dark:border-neutral-800 dark:bg-neutral-900">
                <button
                    type="button"
                    id="tab-auto"
                    role="tab"
                    aria-selected="true"
                    aria-controls="panel-auto"
                    class="suna-tab rounded-full px-4 py-2 text-sm font-semibold transition-colors sm:px-5" data-i18n="tabAuto"
                >
                    Auto-count
                </button>
                <button
                    type="button"
                    id="tab-tally"
                    role="tab"
                    aria-selected="false"
                    aria-controls="panel-tally"
                    class="suna-tab rounded-full px-4 py-2 text-sm font-semibold transition-colors sm:px-5" data-i18n="tabTally"
                >
                    Tally
                </button>
                <button
                    type="button"
                    id="tab-play"
                    role="tab"
                    aria-selected="false"
                    aria-controls="panel-play"
                    class="suna-tab rounded-full px-4 py-2 text-sm font-semibold transition-colors sm:px-5" data-i18n="tabPlay"
                >
                    🎮 Play
                </button>
            </div>
        </div>

        <!-- ===== AUTO-COUNT (primary) ===== -->
        <section
            id="panel-auto"
            role="tabpanel"
            aria-labelledby="tab-auto"
            class="flex min-h-0 flex-1 flex-col"
        >
            <div class="flex min-h-0 flex-1 flex-col items-center justify-center px-4">
                <div
                    id="auto-display"
                    class="font-mono font-bold tabular-nums text-ink select-none dark:text-neutral-100"
                    style="font-size: clamp(5rem, 26dvh, 11rem); line-height: 1;"
                    aria-live="polite"
                    aria-label="Number being spoken" data-i18n-aria="autoDisplay"
                >–</div>
                <p id="auto-status" data-i18n="autoReady" class="mt-2 min-h-[1.5rem] text-center text-sm text-mute dark:text-neutral-500">
                    Set a range and press play.
                </p>
            </div>
            <div class="suna-controls shrink-0 px-4 pb-5">
                <div class="mx-auto grid max-w-md grid-cols-4 items-end gap-2">
                    <div>
                        <label for="auto-from" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="from">From</label>
                        <input id="auto-from" type="number" value="1" min="0" max="9999"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    </div>
                    <div>
                        <label for="auto-to" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="to">To</label>
                        <input id="auto-to" type="number" value="20" min="0" max="9999"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    </div>
                    <div>
                        <label for="auto-step" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="step">By</label>
                        <select id="auto-step"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                            <option value="1" selected>1</option>
                            <option value="2">2</option>
                            <option value="5">5</option>
                            <option value="10">10</option>
                        </select>
                    </div>
                    <div>
                        <label for="auto-gap" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="gap">Gap</label>
                        <select id="auto-gap"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                            <option value="0">0s</option>
                            <option value="0.5" selected>0.5s</option>
                            <option value="1">1s</option>
                            <option value="2">2s</option>
                        </select>
                    </div>
                </div>
                <div class="mx-auto mt-2.5 flex max-w-md gap-2.5">
                    <button type="button" id="auto-play"
                        class="flex-1 rounded-xl bg-pink-600 px-4 py-3 text-base font-bold text-white shadow-sm transition-transform transition-colors hover:bg-pink-700 active:scale-[0.98]"
                        data-i18n="play">▶ Play</button>
                    <button type="button" id="auto-stop" aria-label="Stop" data-i18n-aria="stop"
                        class="rounded-xl border border-hairline bg-elevated px-5 py-3 text-base font-bold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
                    >■</button>
                </div>
                <div class="mx-auto mt-2.5 grid max-w-md grid-cols-2 gap-2.5">
                    <select id="voice-select-auto" aria-label="Voice" data-i18n-aria="voice"
                        class="rounded-xl border border-hairline bg-elevated px-3 py-2 text-sm text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                        <option value="">Loading voices…</option>
                    </select>
                    <label class="flex items-center gap-2 rounded-xl border border-hairline bg-elevated px-3 py-2 dark:border-neutral-700 dark:bg-neutral-900">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="speed">Speed</span>
                        <input id="auto-rate" type="range" min="0.5" max="1.5" step="0.1" value="1" class="w-full accent-pink-600" aria-label="Speaking speed" data-i18n-aria="speed" />
                        <span id="auto-rate-label" class="font-mono text-xs text-mute dark:text-neutral-500">1.0×</span>
                    </label>
                </div>
            </div>
        </section>

        <!-- ===== TALLY ===== -->
        <section
            id="panel-tally"
            role="tabpanel"
            aria-labelledby="tab-tally"
            hidden
            class="flex min-h-0 flex-1 flex-col"
        >
            <div class="flex min-h-0 flex-1 flex-col items-center justify-center px-4">
                <div
                    id="tally-display"
                    class="font-mono font-bold tabular-nums text-ink select-none dark:text-neutral-100"
                    style="font-size: clamp(5rem, 26dvh, 11rem); line-height: 1;"
                    aria-live="polite"
                    aria-label="Current count" data-i18n-aria="tallyDisplay"
                >0</div>
                <div class="mt-3 w-full max-w-xs">
                    <div id="tally-progress" class="h-2 w-full overflow-hidden rounded-full bg-neutral-200 dark:bg-neutral-800"
                        role="progressbar" aria-label="Progress toward target" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div id="tally-progress-fill" class="h-full w-0 rounded-full bg-pink-500 transition-all duration-200"></div>
                    </div>
                    <p id="tally-target-label" class="mt-1.5 text-center text-xs text-mute dark:text-neutral-500" data-i18n="noTarget">No target set</p>
                </div>
            </div>
            <div class="suna-controls shrink-0 px-4 pb-5">
                <div class="mx-auto grid max-w-md grid-cols-[auto_1fr_auto] items-stretch gap-2.5">
                    <button type="button" id="tally-minus" aria-label="Subtract one step" data-i18n-aria="tallyMinus"
                        class="rounded-xl border border-hairline bg-elevated px-5 text-2xl font-bold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800">−</button>
                    <button type="button" id="tally-plus" aria-label="Add one step (or press spacebar)" data-i18n-aria="tallyPlus"
                        class="rounded-xl bg-pink-600 py-3.5 text-xl font-bold text-white shadow-sm transition-transform transition-colors hover:bg-pink-700 active:scale-[0.98]">+ Tap</button>
                    <button type="button" id="tally-reset" aria-label="Reset counter to zero" data-i18n-aria="tallyReset"
                        class="rounded-xl border border-hairline bg-elevated px-4 text-sm font-semibold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800" data-i18n="reset">Reset</button>
                </div>
                <div class="mx-auto mt-2.5 grid max-w-md grid-cols-3 gap-2.5">
                    <select id="tally-step" aria-label="Count by"
                        class="rounded-xl border border-hairline bg-elevated px-2 py-2 text-center text-sm font-semibold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                        <option value="1" selected>1s</option>
                        <option value="2">2s</option>
                        <option value="5">5s</option>
                        <option value="10">10s</option>
                    </select>
                    <input id="tally-target" type="number" min="1" placeholder="Target" data-i18n-ph="targetPh"
                        aria-label="Target number"
                        class="rounded-xl border border-hairline bg-elevated px-2 py-2 text-center text-sm font-semibold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    <select id="voice-select" aria-label="Voice"
                        class="rounded-xl border border-hairline bg-elevated px-2 py-2 text-sm text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                        <option value="">Voices…</option>
                    </select>
                </div>
                <label class="mx-auto mt-2.5 flex max-w-md cursor-pointer items-center justify-center gap-2 text-sm text-body dark:text-neutral-400">
                    <input id="tally-speak" type="checkbox" class="h-4 w-4 accent-pink-600" />
                    data-i18n="readAloud">Read each count aloud
                </label>
            </div>
        </section>

        <!-- ===== PLAY (interactive tap games) ===== -->
        <section
            id="panel-play"
            role="tabpanel"
            aria-labelledby="tab-play"
            hidden
            class="relative flex min-h-0 flex-1 flex-col"
        >
            <div class="suna-controls flex shrink-0 items-center justify-center gap-3 px-4 pt-1">
                <div class="inline-flex rounded-full border border-hairline bg-elevated p-1 dark:border-neutral-800 dark:bg-neutral-900">
                    <button type="button" id="play-mode-count"
                        class="play-subtab rounded-full bg-pink-600 px-4 py-1.5 text-xs font-bold text-white transition-colors"
                     data-i18n="playCount">Tap &amp; count</button>
                    <button type="button" id="play-mode-hear"
                        class="play-subtab rounded-full px-4 py-1.5 text-xs font-bold text-mute transition-colors dark:text-neutral-400"
                     data-i18n="playHear">Hear &amp; tap</button>
                </div>
                <div class="flex items-center gap-1 text-sm font-bold text-ink dark:text-neutral-100" title="Stars earned">
                    <span aria-hidden="true">⭐</span>
                    <span id="play-score">0</span>
                </div>
            </div>

            <!-- game: tap & count -->
            <div id="play-count-wrap" class="flex min-h-0 flex-1 flex-col">
                <p id="play-count-status" data-i18n="countTapAlong" class="shrink-0 px-4 pt-2 text-center text-sm font-medium text-body dark:text-neutral-300">
                    Tap each one and count along!
                </p>
                <div class="flex min-h-0 flex-1 items-center justify-center overflow-hidden px-4">
                    <div id="play-count-grid" class="flex max-w-lg flex-wrap items-center justify-center gap-2 sm:gap-3" role="group" aria-label="Objects to count"></div>
                </div>
                <div class="suna-controls shrink-0 px-4 pb-5">
                    <div class="mx-auto flex max-w-md items-center justify-center gap-2.5">
                        <select id="voice-select-play" aria-label="Voice"
                            class="rounded-xl border border-hairline bg-elevated px-3 py-2 text-sm text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                            <option value="">Voices…</option>
                        </select>
                        <button type="button" id="play-count-next"
                            class="rounded-xl border border-hairline bg-elevated px-5 py-2 text-sm font-bold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
                         data-i18n="newRound">New round ↻</button>
                    </div>
                </div>
            </div>

            <!-- game: hear & tap -->
            <div id="play-hear-wrap" hidden class="flex min-h-0 flex-1 flex-col">
                <p id="play-hear-status" data-i18n="hearListen" class="shrink-0 px-4 pt-2 text-center text-sm font-medium text-body dark:text-neutral-300">
                    Listen… then tap the number you hear!
                </p>
                <div class="flex min-h-0 flex-1 items-center justify-center px-4">
                    <div id="play-hear-options" class="flex items-center justify-center gap-3 sm:gap-5" role="group" aria-label="Number choices"></div>
                </div>
                <div class="suna-controls shrink-0 px-4 pb-5">
                    <div class="mx-auto flex max-w-md items-center justify-center gap-2.5">
                        <button type="button" id="play-hear-replay"
                            class="rounded-xl bg-pink-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm transition-transform transition-colors hover:bg-pink-700 active:scale-[0.98]"
                         data-i18n="hearAgain">🔊 Hear it again</button>
                        <button type="button" id="play-hear-next"
                            class="rounded-xl border border-hairline bg-elevated px-5 py-2.5 text-sm font-bold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
