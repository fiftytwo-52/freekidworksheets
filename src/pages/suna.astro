---
// /suna — "Suna – The Counter": immersive full-screen counting app.
// Auto-count (teacher) mode is primary; tally mode one tap away.
// Speech uses the Web Speech API (speechSynthesis) — no backend, no mic,
// no account. `bare` layout: no site nav/footer, no page scroll.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Flag from '../components/Flag.astro';
import { breadcrumbListJsonLd, faqJsonLd } from '../lib/seo';

const PATH = '/suna';
const TITLE = 'Suna: Free Online Counter with Voice';
const DESCRIPTION =
    'Suna is a free online counter with voice in English, Nepali and Portuguese. Auto-count any range for your class, or tap to tally — no app, no signup.';
const KEYWORDS =
    'online counter, free online counter, tally counter, counter with voice, count aloud, classroom counter, suna counter, digital counter, count to 100, contador online, contagem em voz alta, नेपाली काउन्टर, online tasbih counter';

const SUNA_FAQS = [
    {
        question: 'What is Suna – The Counter?',
        answer: 'Suna is a free online counter from Free Kids Worksheets. It works as a tap-to-tally counter and as an auto-counting teacher tool that reads numbers aloud in a voice you choose. It runs entirely in your browser — nothing to install and no account needed.',
    },
    {
        question: 'How does the voice counting work?',
        answer: 'Your browser reads each number aloud using its built-in voices. Pick any installed voice from the dropdown, adjust the speed, and press play. Voices vary by device — phones, tablets and computers each ship their own set.',
    },
    {
        question: 'Can I use Suna as a classroom counting tool?',
        answer: 'Yes — that is what auto-count mode is for. Set any range (for example 1 to 50), choose a clear voice, and press play. Each number appears huge on screen while it is spoken, so the whole class can follow along.',
    },
    {
        question: 'Does the tally counter save my count?',
        answer: 'Your current count is saved in this browser automatically, so a refresh or a closed tab will not lose it. Clearing your browser data will reset it.',
    },
    {
        question: 'Is Suna free? Do I need an account?',
        answer: 'Completely free, no account, no download. Open the page and start counting.',
    },
    {
        question: 'Can I count by 2s, 5s or 10s?',
        answer: 'Yes. In tally mode, choose a step size of 1, 2, 5 or 10 — auto-count mode has its own step control too, plus a pause-between-numbers timer so you can slow the pace down for young learners. You can also set a target number and watch the progress bar fill as you count toward it.',
    },
    {
        question: 'What is the Shapes toggle?',
        answer: 'In auto-count mode, turn on Shapes and Suna shows a group of tappable icons matching each number it speaks — three apples when it says three, up to groups of 19. Children can tap an icon to make it fall away. Beyond 19, the big numeral stands alone.',
    },
    {
        question: 'Is Suna available in other languages?',
        answer: 'Yes. The whole Suna app — buttons, counters and instructions — works in English, Nepali (नेपाली) and Brazilian Portuguese. Tap the flag in the top bar to switch languages. In Nepali mode the numbers also display and speak in Nepali.',
    },
];

const webAppJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Suna – The Counter',
    url: 'https://freekidworksheets.com/suna',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: DESCRIPTION,
    inLanguage: ['en', 'ne', 'pt-BR'],
};
---

<Base
    pageTitle={TITLE}
    description={DESCRIPTION}
    path={PATH}
    keywords={KEYWORDS}
    bare
    jsonLd={[
        webAppJsonLd,
        breadcrumbListJsonLd([{ name: 'Home', url: '/' }, { name: 'Suna – The Counter' }]),
        faqJsonLd(SUNA_FAQS),
    ]}
>
    <div id="suna-app" class="flex h-dvh flex-col overflow-hidden">
        <!-- ===== shape icon library (flat SVG icons for the shapes mode) ===== -->
        <svg width="0" height="0" style="position:absolute" aria-hidden="true">
            <defs>
                <symbol id="suna-ic-apple" viewBox="0 0 48 48">
                    <path d="M24 13c-8-5-19-1-19 11 0 9 7 16 12 16 2.4 0 3.6-1.2 7-1.2s4.6 1.2 7 1.2c5 0 12-7 12-16 0-12-11-16-19-11z" fill="#e53935"/>
                    <path d="M24 13c0-4 2-7 6-8.5" stroke="#8d6e63" stroke-width="3" stroke-linecap="round" fill="none"/>
                    <path d="M30 6.5c4.5-2.5 9-.5 10 3.5-4.5 2.5-9 .5-10-3.5z" fill="#43a047"/>
                    <ellipse cx="17.5" cy="25" rx="3" ry="5.5" fill="#ffffff" opacity="0.35"/>
                </symbol>
                <symbol id="suna-ic-banana" viewBox="0 0 48 48">
                    <path d="M9 9c-1 15 8 27 26 30 3.5.6 5.5-1.5 4.5-4-.8-2-2.8-2.6-5-3.2C22 28.6 15 20 14 9c-.3-3-4.7-3-5 0z" fill="#fdd835"/>
                    <path d="M14 12c1 11 7 19 19 22" stroke="#f9a825" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.7"/>
                    <rect x="6.5" y="4.5" width="7" height="7" rx="2.5" fill="#8d6e63"/>
                </symbol>
                <symbol id="suna-ic-orange" viewBox="0 0 48 48">
                    <circle cx="24" cy="28" r="15" fill="#fb8c00"/>
                    <path d="M24 13c-1-4 1-7.5 4.5-8.5" stroke="#8d6e63" stroke-width="3" stroke-linecap="round" fill="none"/>
                    <path d="M28.5 6.5c5-2.5 9.5.5 10.5 4.5-5 2.5-9.5-.5-10.5-4.5z" fill="#43a047"/>
                    <circle cx="18" cy="23" rx="4" ry="3" fill="#ffffff" opacity="0.35"/>
                </symbol>
                <symbol id="suna-ic-strawberry" viewBox="0 0 48 48">
                    <path d="M24 44C14.5 36.5 8 28.5 8 20.5 8 17.5 10 15.5 13 15.5h22c3 0 5 2 5 5 0 8-6.5 16-16 23.5z" fill="#e53935"/>
                    <path d="M8 16.5c4-6.5 9.5-9 16-9s12 2.5 16 9c-4 2.2-10 3.2-16 3.2s-12-1-16-3.2z" fill="#43a047"/>
                    <g fill="#ffcdd2">
                        <circle cx="18" cy="26" r="1.7"/><circle cx="26.5" cy="24" r="1.7"/><circle cx="30.5" cy="30.5" r="1.7"/><circle cx="22" cy="33.5" r="1.7"/><circle cx="14.5" cy="32" r="1.7"/>
                    </g>
                </symbol>
                <symbol id="suna-ic-star" viewBox="0 0 48 48">
                    <path d="M24 4.5l5.6 11.4 12.6 1.8-9.1 8.9 2.1 12.6L24 33.4l-11.2 5.8 2.1-12.6-9.1-8.9 12.6-1.8z" fill="#fdd835" stroke="#f9a825" stroke-width="2" stroke-linejoin="round"/>
                </symbol>
                <symbol id="suna-ic-heart" viewBox="0 0 48 48">
                    <path d="M24 42.5S6 30.5 6 17.5C6 11.5 11 6.5 17 6.5c3.8 0 6 1.9 7 3.9 1-2 3.2-3.9 7-3.9 6 0 11 5 11 11 0 13-18 25-18 25z" fill="#ec407a"/>
                    <circle cx="16.5" cy="15" r="3" fill="#ffffff" opacity="0.35"/>
                </symbol>
                <symbol id="suna-ic-ball" viewBox="0 0 48 48">
                    <circle cx="24" cy="24" r="16.5" fill="#ffffff" stroke="#1967d2" stroke-width="3"/>
                    <path d="M24 7.5v33M7.5 24h33" stroke="#1967d2" stroke-width="3"/>
                    <path d="M12.3 12.3c4 3 4 20.4 0 23.4M35.7 12.3c-4 3-4 20.4 0 23.4" stroke="#90caf9" stroke-width="2.5" fill="none"/>
                </symbol>
                <symbol id="suna-ic-dog" viewBox="0 0 48 48">
                    <ellipse cx="11.5" cy="14" rx="7" ry="10" fill="#8d6e63"/>
                    <ellipse cx="36.5" cy="14" rx="7" ry="10" fill="#8d6e63"/>
                    <circle cx="24" cy="26.5" r="13.5" fill="#d7a86e"/>
                    <circle cx="18.5" cy="24.5" r="2.6" fill="#3e2723"/>
                    <circle cx="29.5" cy="24.5" r="2.6" fill="#3e2723"/>
                    <ellipse cx="24" cy="31.5" rx="4" ry="3" fill="#3e2723"/>
                    <path d="M24 34.5v2.5M24 37c-2 2-5 2-6.5-.5M24 37c2 2 5 2 6.5-.5" stroke="#3e2723" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                </symbol>
                <symbol id="suna-ic-cat" viewBox="0 0 48 48">
                    <path d="M14.5 5.5L10 18h12.5z" fill="#78909c"/>
                    <path d="M33.5 5.5L38 18H25.5z" fill="#78909c"/>
                    <path d="M14 10l-1.8 5h6.5z" fill="#f8bbd0"/>
                    <path d="M34 10l1.8 5h-6.5z" fill="#f8bbd0"/>
                    <circle cx="24" cy="28.5" r="13" fill="#90a4ae"/>
                    <circle cx="19" cy="26.5" r="2.5" fill="#263238"/>
                    <circle cx="29" cy="26.5" r="2.5" fill="#263238"/>
                    <circle cx="19.8" cy="25.7" r="0.9" fill="#ffffff"/>
                    <circle cx="29.8" cy="25.7" r="0.9" fill="#ffffff"/>
                    <path d="M21.8 32.5h4.4L24 35z" fill="#f8bbd0"/>
                </symbol>
                <symbol id="suna-ic-fish" viewBox="0 0 48 48">
                    <path d="M33 24l11-9v18z" fill="#fb8c00"/>
                    <ellipse cx="20" cy="24" rx="14" ry="10.5" fill="#ffb74d"/>
                    <path d="M25 15.5c3.5 3.5 3.5 13.5 0 17" stroke="#fb8c00" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                    <circle cx="14" cy="21.5" r="2.6" fill="#3e2723"/>
                    <circle cx="14.9" cy="20.6" r="0.9" fill="#ffffff"/>
                </symbol>
                <symbol id="suna-ic-flower" viewBox="0 0 48 48">
                    <g fill="#f48fb1">
                        <circle cx="24" cy="10.5" r="7"/><circle cx="37.5" cy="24" r="7"/><circle cx="24" cy="37.5" r="7"/><circle cx="10.5" cy="24" r="7"/>
                    </g>
                    <circle cx="24" cy="24" r="7" fill="#fdd835"/>
                    <circle cx="21.5" cy="21.5" r="2.2" fill="#fff8e1"/>
                </symbol>
                <symbol id="suna-ic-balloon" viewBox="0 0 48 48">
                    <path d="M24 35c-1 4-3.5 6-3.5 9.5" stroke="#78909c" stroke-width="2" fill="none" stroke-linecap="round"/>
                    <ellipse cx="24" cy="18.5" rx="12" ry="14" fill="#42a5f5"/>
                    <path d="M21.8 31h4.4L24 35.5z" fill="#1e88e5"/>
                    <ellipse cx="19" cy="13" rx="3" ry="5" fill="#ffffff" opacity="0.45"/>
                </symbol>
            </defs>
        </svg>
        <!-- ===== app header ===== -->
        <header class="flex shrink-0 items-center justify-between gap-2 px-4 py-3">
            <div class="flex items-center gap-2.5">
                <img
                    src="/assets/suna-icon.svg"
                    alt="Suna — the counting buddy"
                    class="h-11 w-11"
                    width="44"
                    height="44"
                />
                <div class="leading-tight">
                    <p class="text-base font-bold tracking-tight text-ink dark:text-neutral-100">Suna</p>
                    <p class="text-[11px] text-mute dark:text-neutral-500" data-i18n="subtitle">The Counter</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a
                    href="/"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-all duration-300 ease hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Back to Free Kids Worksheets home" data-i18n-aria="homeBtn"
                    title="Home"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h5v-6h4v6h5V9.5"/></svg>
                </a>
                <details class="relative" id="suna-lang-switcher">
                    <summary
                        class="flex h-9 cursor-pointer list-none items-center gap-1 rounded-full border border-hairline bg-elevated px-2.5 text-mute transition-all duration-300 ease hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100 [&::-webkit-details-marker]:hidden"
                        aria-label="Switch language" title="Language"
                    >
                        <span id="suna-lang-flag" class="flex">
                            <span data-flag="en"><Flag code="en" /></span>
                            <span data-flag="ne" hidden><Flag code="ne" /></span>
                            <span data-flag="pt-br" hidden><Flag code="pt-br" /></span>
                        </span>
                        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <ul class="absolute left-0 top-full z-50 mt-2 w-44 overflow-hidden rounded-xl border border-hairline bg-elevated py-1 shadow-lg dark:border-neutral-700 dark:bg-neutral-900">
                        <li><button type="button" data-suna-lang="en" class="flex w-full items-center gap-2.5 px-4 py-2 text-sm font-medium text-body transition-all duration-300 ease hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"><Flag code="en" />English</button></li>
                        <li><button type="button" data-suna-lang="ne" class="flex w-full items-center gap-2.5 px-4 py-2 text-sm font-medium text-body transition-all duration-300 ease hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"><Flag code="ne" />नेपाली</button></li>
                        <li><button type="button" data-suna-lang="pt-br" class="flex w-full items-center gap-2.5 px-4 py-2 text-sm font-medium text-body transition-all duration-300 ease hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"><Flag code="pt-br" />Português (BR)</button></li>
                    </ul>
                </details>
                <a
                    href="https://pairpaint.com"
                    target="_blank"
                    rel="noopener"
                    class="hidden items-center gap-1.5 rounded-full border border-hairline bg-elevated px-3 py-2 text-xs font-semibold text-body transition-all duration-300 ease hover:bg-neutral-100 sm:inline-flex dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
                    title="Open pairPaint — free kids drawing app"
                >
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 4 6 6-10 10H4v-6z"/><path d="m12 6 6 6"/></svg>
                    pairPaint
                </a>
                <button
                    type="button"
                    id="suna-clean-toggle"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-all duration-300 ease hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Hide controls for a clean display" data-i18n-aria="cleanBtn"
                    title="Clean display (hide controls)"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 9.5 8 9.5 8a17.6 17.6 0 0 1-2.16 3.19M6.61 6.61A17.5 17.5 0 0 0 2.5 12S5.5 20 12 20a9.6 9.6 0 0 0 4.39-1.06"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="m2 2 20 20"/></svg>
                </button>
                <button
                    type="button"
                    id="suna-fullscreen"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-all duration-300 ease hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Toggle fullscreen" data-i18n-aria="fsBtn"
                    title="Fullscreen"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
                </button>
                <button
                    type="button"
                    id="suna-info-open"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-all duration-300 ease hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="How to use Suna" data-i18n-aria="infoBtn"
                    title="How to use"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 1 1 3.6 2.4c-.9.4-1.1 1-1.1 1.8"/><path d="M12 17h.01"/></svg>
                </button>
            </div>
        </header>

        <!-- ===== mode switch ===== -->
        <div class="suna-tabs flex shrink-0 justify-center" role="tablist" aria-label="Counter modes">
            <div class="inline-flex rounded-full border border-hairline bg-elevated p-1 dark:border-neutral-800 dark:bg-neutral-900">
                <button
                    type="button"
                    id="tab-auto"
                    role="tab"
                    aria-selected="true"
                    aria-controls="panel-auto"
                    class="suna-tab rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 ease sm:px-5" data-i18n="tabAuto"
                >
                    Auto-count
                </button>
                <button
                    type="button"
                    id="tab-tally"
                    role="tab"
                    aria-selected="false"
                    aria-controls="panel-tally"
                    class="suna-tab rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 ease sm:px-5" data-i18n="tabTally"
                >
                    Tally
                </button>
            </div>
        </div>

        <!-- ===== AUTO-COUNT (primary) ===== -->
        <section
            id="panel-auto"
            role="tabpanel"
            aria-labelledby="tab-auto"
            class="flex min-h-0 flex-1 flex-col"
        >
            <div id="auto-stage" class="relative flex min-h-0 flex-1 flex-col items-center justify-center overflow-hidden px-4">
                <div
                    id="auto-display"
                    class="relative z-10 font-mono font-bold tabular-nums text-ink select-none dark:text-neutral-100"
                    style="font-size: clamp(5rem, 26dvh, 11rem); line-height: 1;"
                    aria-live="polite"
                    aria-label="Number being spoken" data-i18n-aria="autoDisplay"
                >–</div>
                <div id="auto-shapes" class="relative z-10 flex min-h-[96px] w-full max-w-md flex-wrap items-center justify-center gap-1.5 px-2 py-1" aria-hidden="true"></div>
                <p id="auto-status" data-i18n="autoReady" class="relative z-10 mt-2 min-h-[1.5rem] text-center text-sm text-mute dark:text-neutral-500">
                    Set a range and press play.
                </p>
            </div>
            <div class="suna-controls shrink-0 px-4 pb-5">
                <div class="mx-auto grid max-w-md grid-cols-4 items-end gap-2">
                    <div>
                        <label for="auto-from" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="from">From</label>
                        <input id="auto-from" type="number" value="1" min="0" max="9999"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    </div>
                    <div>
                        <label for="auto-to" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="to">To</label>
                        <input id="auto-to" type="number" value="20" min="0" max="9999"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    </div>
                    <div>
                        <label for="auto-step" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="step">By</label>
                        <select id="auto-step"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                            <option value="1" selected>1</option>
                            <option value="2">2</option>
                            <option value="5">5</option>
                            <option value="10">10</option>
                        </select>
                    </div>
                    <div>
                        <label for="auto-gap" class="mb-1 block text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="gap">Gap</label>
                        <select id="auto-gap"
                            class="w-full rounded-xl border border-hairline bg-elevated px-2 py-2.5 text-center text-base font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                            <option value="0">0s</option>
                            <option value="0.5" selected>0.5s</option>
                            <option value="1">1s</option>
                            <option value="1.5">1.5s</option>
                            <option value="2">2s</option>
                            <option value="3">3s</option>
                            <option value="5">5s</option>
                        </select>
                    </div>
                </div>
                <div class="mx-auto mt-2.5 flex max-w-md gap-2.5">
                    <button type="button" id="auto-play"
                        class="flex-1 rounded-full bg-[#1967d2] px-4 py-3 text-base font-bold text-white transition-all duration-300 ease hover:bg-[#174ea6] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1a73e8] active:bg-[#174ea6]"
                        data-i18n="play">▶ Play</button>
                    <button type="button" id="auto-stop" aria-label="Stop" data-i18n-aria="stop"
                        class="rounded-xl border border-hairline bg-elevated px-5 py-3 text-base font-bold text-body transition-all duration-300 ease hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
                    >■</button>
                </div>
                <div class="mx-auto mt-2.5 grid max-w-md grid-cols-2 gap-2.5">
                    <select id="voice-select-auto" aria-label="Voice" data-i18n-aria="voice"
                        class="rounded-xl border border-hairline bg-elevated px-3 py-2 text-sm text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                        <option value="">Loading voices…</option>
                    </select>
                    <label class="flex items-center gap-2 rounded-xl border border-hairline bg-elevated px-3 py-2 dark:border-neutral-700 dark:bg-neutral-900">
                        <span class="text-[10px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500" data-i18n="speed">Speed</span>
