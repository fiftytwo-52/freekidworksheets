---
// /suna — "Suna – The Counter": playful, immersive counting and recital app.
// Auto-count (teacher/classroom) mode & tally counter mode.
// Web Speech API (speechSynthesis) with interactive game mode & floating shape objects.
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { breadcrumbListJsonLd, faqJsonLd } from '../lib/seo';

const PATH = '/suna';
const TITLE = 'Suna: Free Online Counter with Voice';
const DESCRIPTION =
    'Suna is a free online counter with voice in English, Nepali and Portuguese. Auto-count any range for your class, or tap to tally — no app, no signup.';
const KEYWORDS =
    'online counter, free online counter, tally counter, counter with voice, count aloud, classroom counter, suna counter, digital counter, count to 100, contador online, contagem em voz alta, नेपाली काउन्टर, online tasbih counter';

const SUNA_FAQS = [
    {
        question: 'What is Suna – The Counter?',
        answer: 'A free online counter from Free Kids Worksheets. It works as a tap-to-tally counter and as an auto-counting teacher tool that reads numbers and letters aloud. It runs in your browser, with nothing to install and no account.',
    },
    {
        question: 'How does the voice counting work?',
        answer: 'Your browser reads each number or letter aloud with its built-in voices. Pick any installed voice, adjust the speed and press play. Voices vary by device.',
    },
    {
        question: 'Can I use Suna as a classroom counting tool?',
        answer: 'Yes. The default is 1 to 100 with a 1.5 second gap. Press play and the page goes fullscreen. Use Pause, Stop or Hide to control it.',
    },
    {
        question: 'Does the tally counter save my count?',
        answer: 'Yes. Your count is saved in this browser, so a refresh will not lose it. Clearing browser data resets it.',
    },
    {
        question: 'Is Suna free? Do I need an account?',
        answer: 'Completely free, no account, no download.',
    },
    {
        question: 'Can I count by 2s, 5s or 10s?',
        answer: 'Yes. Both tally and auto-count have a step control (1, 2, 5, 10). Auto-count also has a gap timer to slow things down for young learners.',
    },
    {
        question: 'What is the Shapes toggle?',
        answer: 'It is off at first. Switch it on and, for every number, that many objects float around the screen (up to 30). In Alphabet mode you get pictures that start with the letter. Tap one and it falls away.',
    },
    {
        question: 'Is Suna available in other languages?',
        answer: 'Yes: English, Nepali (नेपाली) and Brazilian Portuguese. In Nepali mode numbers run १ to १०० and letters क to ज्ञ, displayed and spoken in Nepali.',
    },
    {
        question: 'What if there is no voice or sound coming from the counter?',
        answer: 'Modern browsers require you to tap Play, Test or the counter button before playing audio. Make sure your device volume is turned up and not muted (on iPhones, check that the silent switch on the side is turned off). If your phone or computer does not have a Nepali voice installed, Suna smoothly uses Hindi or English voices as a fallback. You can also install voices in your device system Text-to-Speech settings.',
    },
    {
        question: 'Does Suna have background music (BGM)?',
        answer: 'Yes! Turn on Background Music to hear peaceful ambient melodies, deep learning flow, gentle marimba, or calm lofi study beats while counting or tallying. You can adjust the BGM volume anytime so the counting voice stays clear.',
    },
];

const webAppJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Suna – The Counter',
    url: 'https://freekidworksheets.com/suna',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: DESCRIPTION,
    inLanguage: ['en', 'ne', 'pt-BR'],
};
---

<Base
    pageTitle={TITLE}
    description={DESCRIPTION}
    path={PATH}
    keywords={KEYWORDS}
    bare
    jsonLd={[
        webAppJsonLd,
        breadcrumbListJsonLd([{ name: 'Home', url: '/' }, { name: 'Suna – The Counter' }]),
        faqJsonLd(SUNA_FAQS),
    ]}
>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@600;800&display=swap" rel="stylesheet" />

    <style is:inline>
        :root {
            --bg: #fff4e0;
            --ink: #2b1d4a;
            --pink: #ff416c;
            --sun: #ffc93c;
            --mint: #2ec4a6;
            --sky: #4cc9f0;
            --card: #ffffffe6;
            --display: 'Fredoka', 'Trebuchet MS', sans-serif;
            --body: 'Nunito', 'Segoe UI', sans-serif;
            box-sizing: border-box;
            padding-top: env(safe-area-inset-top, 0px);
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                --bg: #1e1538;
                --ink: #fff4e0;
                --card: #2c2050e6;
            }
        }
        [data-theme="dark"] {
            --bg: #1e1538;
            --ink: #fff4e0;
            --card: #2c2050e6;
        }
        [data-theme="light"] {
            --bg: #fff4e0;
            --ink: #2b1d4a;
            --card: #ffffffe6;
        }

        #app {
            position: relative;
            min-height: 100vh;
            background: var(--bg);
            color: var(--ink);
            font-family: var(--body);
            font-weight: 800;
        }
        :focus-visible { outline: 4px solid var(--sky); outline-offset: 3px; }
        [hidden] { display: none !important; }

        .ic {
            display: inline-block;
            vertical-align: middle;
            flex-shrink: 0;
            pointer-events: none;
        }

        /* floating objects (behind content, clickable) */
        #sky { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
        #sky i {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
            line-height: 1;
            font-style: normal;
            cursor: pointer;
            pointer-events: auto;
            animation: pop .5s cubic-bezier(.3,1.6,.5,1) backwards, drift var(--t) ease-in-out infinite alternate;
            animation-delay: var(--p), var(--d);
            filter: drop-shadow(0 6px 0 rgba(43,29,74,.12));
            transition: transform .7s ease-in, opacity .7s;
        }
        #sky i img { width: 1em; height: 1em; object-fit: contain; pointer-events: none; }
        #sky i small { font: 800 .24em var(--body); margin-top: .2em; color: var(--ink); white-space: nowrap; }

        /* Floating game tiles — alphabet and number tiles */
        #sky i.tile {
            min-width: 1.4em;
            padding: .18em .36em;
            background: hsl(var(--h) 92% 88%);
            border: 2.5px solid #2b1d4a;
            border-radius: .55em;
            box-shadow: 0 4px 0 #2b1d4a;
            font-family: var(--display);
            font-weight: 700;
            color: #2b1d4a;
            font-size: clamp(1.3rem, 4vmin, 2.5rem) !important;
            transition: transform .2s ease, opacity .5s ease;
            cursor: pointer;
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            line-height: 1;
            user-select: none;
        }
        /* In alphabet game: pictures/emojis are distinctly BIGGER than letters */
        #sky i.tile .tile-pic {
            font-size: 1.6em;
            line-height: 1.05;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 2px;
            filter: drop-shadow(0 2px 3px rgba(43,29,74,.14));
        }
        #sky i.tile .tile-pic img {
            width: 1.6em;
            height: 1.6em;
            object-fit: contain;
            display: block;
        }
        #sky i.tile .tile-letter {
            font-family: var(--display);
            font-size: 0.6em;
            font-weight: 800;
            color: #2b1d4a;
            background: rgba(255, 255, 255, 0.88);
            padding: 1px 7px;
            border-radius: 999px;
            line-height: 1.25;
            letter-spacing: 0.4px;
            border: 1px solid rgba(43,29,74,.18);
        }
        #sky i.tile .tile-letter.solo {
            font-size: 1.15em;
            background: none;
            border: none;
            padding: 0;
        }
        #sky i.fall { animation: none; transform: translateY(110vh) rotate(90deg); opacity: 0; }
        #sky i.ok { animation: ok .65s ease forwards; z-index: 3; }
        #sky i.wrong { animation: shake .4s, none; opacity: .4; pointer-events: none; }
        @keyframes drift { from { transform: translate(0,0) rotate(var(--r0)); } to { transform: translate(var(--dx),var(--dy)) rotate(var(--r1)); } }
        @keyframes pop { from { transform: scale(0); } to { transform: scale(1); } }
        @keyframes ok { 0% { transform: scale(1); } 50% { transform: scale(1.4) rotate(8deg); } 100% { transform: scale(1.2); } }
        @keyframes shake { 25% { transform: translateX(-10px); } 75% { transform: translateX(10px); } }
        @media (prefers-reduced-motion: reduce) { #sky i { animation: none; } }

        header, main, .about, footer { position: relative; z-index: 1; }
        /* The language menu drops down over <main>: the header must paint
           above main, otherwise the menu renders behind the tab buttons
           (the menu's own z-index can't escape the header's stacking context). */
        header { z-index: 5; }
        header {
            display: flex;
            align-items: center;
            gap: clamp(8px, 2vw, 14px);
            padding: clamp(10px, 2.5vw, 16px) clamp(12px, 4vw, 40px);
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: var(--display);
            font-weight: 700;
            font-size: clamp(1.25rem, 3.5vw, 1.6rem);
            color: var(--ink);
            text-decoration: none;
            min-width: 0;
        }
        .brand img {
            width: clamp(34px, 4.5vw, 42px);
            height: clamp(34px, 4.5vw, 42px);
            flex-shrink: 0;
        }
        .brand span {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }
        .brand small {
            font: 800 clamp(0.72rem, 2vw, 0.85rem) var(--body);
            opacity: .75;
        }
        @media (max-width: 480px) {
            .brand small { display: none; }
            header .pill.ext-link { display: none; }
        }
        .sp { flex: 1; }
        .pill {
            font: inherit;
            font-size: clamp(0.82rem, 2vw, 0.95rem);
            font-weight: 800;
            border: 3px solid var(--ink);
            background: var(--card);
            color: var(--ink);
            border-radius: 999px;
            padding: 6px clamp(10px, 2vw, 14px);
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 38px;
            box-sizing: border-box;
            transition: transform .1s ease, background .15s ease;
        }
        .pill[aria-pressed=true] { background: var(--sun); color: #2b1d4a; }
        .pill:active { transform: translateY(1px); }
        .lm { position: relative; }
        .lm ul {
            position: absolute;
            right: 0;
            top: calc(100% + 6px);
            margin: 0;
            padding: 6px;
            list-style: none;
            background: var(--card);
            border: 3px solid var(--ink);
            border-radius: 16px;
            min-width: 160px;
            box-shadow: 0 5px 0 var(--ink);
            z-index: 5;
        }
        .lm li button {
            width: 100%;
            text-align: left;
            font: inherit;
            font-weight: 800;
            color: var(--ink);
            background: none;
            border: 0;
            border-radius: 10px;
            padding: 8px 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .lm li button:hover, .lm li button[aria-current=true] { background: var(--sun); color: #2b1d4a; }

        .stage {
            max-width: 880px;
            margin: 0 auto;
            padding: 6px clamp(10px, 3vw, 18px) 40px;
        }
        .tabs {
            display: flex;
            justify-content: center;
            gap: clamp(6px, 1.8vw, 10px);
            margin: 6px 0 16px;
        }
        .tabs button {
            font: 600 clamp(1rem, 2.8vw, 1.18rem) var(--display);
            border: 3px solid var(--ink);
            background: var(--card);
            color: var(--ink);
            border-radius: 18px;
            padding: clamp(6px, 1.8vw, 9px) clamp(14px, 3.5vw, 24px);
            cursor: pointer;
            box-shadow: 0 4px 0 var(--ink);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 44px;
            transition: transform .1s ease, box-shadow .1s ease;
        }
        .tabs button[aria-selected=true] { background: var(--pink); color: #fff; }
        .tabs button:active { transform: translateY(2px); box-shadow: 0 2px 0 var(--ink); }

        .panel {
            background: var(--card);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 3px solid var(--ink);
            border-radius: clamp(20px, 4vw, 32px);
            box-shadow: 0 8px 0 var(--ink);
            padding: clamp(14px, 3.5vw, 30px);
        }

        /* Counting number/letter: BIGGEST focal element on the entire screen */
        .display {
            font-family: var(--display);
            font-weight: 700;
            text-align: center;
            font-size: clamp(4.8rem, 23vmin, 16rem);
            line-height: 1;
            color: var(--pink);
            min-height: 1.1em;
            text-shadow: 0 clamp(4px, 1.2vw, 8px) 0 var(--ink);
            pointer-events: none;
            word-break: break-all;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            max-width: 100%;
            transition: font-size 0.2s ease;
        }
        .display.long {
            font-size: clamp(3.2rem, 16vmin, 10.5rem);
        }
        .display.pop { animation: pop .35s cubic-bezier(.3,1.6,.5,1); }
        .msg {
            text-align: center;
            margin: 0 0 14px;
            opacity: .85;
            pointer-events: none;
            font-size: clamp(0.95rem, 2.5vw, 1.15rem);
            min-height: 1.5em;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(clamp(115px, 22vw, 160px), 1fr));
            gap: clamp(8px, 2vw, 14px);
            margin: 14px 0;
        }
        #abcRange {
            grid-template-columns: repeat(3, 1fr);
        }
        label {
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: clamp(0.82rem, 2vw, 0.92rem);
            font-weight: 800;
        }
        label span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        input, select {
            font: inherit;
            font-weight: 800;
            font-size: 16px;
            color: #2b1d4a;
            background: #fff;
            border: 3px solid var(--ink);
            border-radius: 14px;
            padding: 8px 12px;
            width: 100%;
            min-height: 44px;
            box-sizing: border-box;
        }
        .row {
            display: flex;
            flex-wrap: wrap;
            gap: clamp(8px, 1.8vw, 12px);
            align-items: center;
            justify-content: center;
            margin-top: 14px;
        }
        .btn {
            font: 600 clamp(1.1rem, 2.8vw, 1.35rem) var(--display);
            border: 3px solid var(--ink);
            background: var(--mint);
            color: #143d35;
            border-radius: 20px;
            padding: 9px clamp(18px, 4vw, 30px);
            cursor: pointer;
            box-shadow: 0 5px 0 var(--ink);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 48px;
            transition: transform .1s ease, box-shadow .1s ease;
        }
        .btn.stop { background: var(--sun); color: #2b1d4a; padding: 9px clamp(14px, 3vw, 22px); }
        .btn:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--ink); }

        /* Media queries for phone, tablet, ipad, desktop */
        @media (max-width: 640px) {
            .tabs { width: 100%; gap: 6px; }
            .tabs button { flex: 1; justify-content: center; padding: 8px 10px; font-size: 0.98rem; }
            .panel { padding: 14px 10px; border-radius: 20px; }
            #numRange { grid-template-columns: 1fr 1fr; gap: 8px; }
            #abcRange { grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
            #voiceGrid, #bgmGrid { grid-template-columns: 1fr; gap: 10px; }
            .row { gap: 6px; }
            .row .btn#play { width: 100%; min-height: 52px; font-size: 1.3rem; }
            .row .pill { flex: 1 1 calc(50% - 6px); justify-content: center; }
            #tallyCtl .grid { grid-template-columns: 1fr 1fr; }
            #tallyCtl .chips#step { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
            #fsbar { padding: 8px 8px calc(8px + env(safe-area-inset-bottom, 0px)); flex-wrap: wrap; gap: 6px; }
            #fsbar .pill { font-size: 0.8rem; padding: 6px 10px; min-height: 38px; }
        }
        @media (min-width: 641px) and (max-width: 1024px) {
            .stage { padding: 10px 18px 40px; }
            .panel { padding: 22px 18px; }
            #numRange { grid-template-columns: repeat(4, 1fr); gap: 10px; }
            #abcRange { grid-template-columns: repeat(3, 1fr); gap: 10px; }
            #voiceGrid, #bgmGrid { grid-template-columns: 1fr 1fr; gap: 12px; }
        }
        @media (min-width: 1025px) {
            #numRange { grid-template-columns: repeat(4, 1fr); gap: 12px; }
            #abcRange { grid-template-columns: repeat(3, 1fr); gap: 12px; }
            #voiceGrid, #bgmGrid { grid-template-columns: 1fr 1fr; gap: 14px; }
        }

        .chips {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            width: 100%;
        }
        .chips button {
            font: inherit;
            font-weight: 800;
            font-size: clamp(0.85rem, 2vw, 0.95rem);
            border: 3px solid var(--ink);
            background: #fff;
            color: #2b1d4a;
            border-radius: 12px;
            padding: 6px 12px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 42px;
            flex: 1 1 auto;
            transition: background .15s ease, transform .1s ease;
        }
        .chips button[aria-pressed=true] { background: var(--sky); }
        .chips button:active { transform: translateY(1px); }

        .big {
            width: min(56vw, 210px);
            aspect-ratio: 1;
            border-radius: 50%;
            border: 5px solid var(--ink);
            background: var(--pink);
            color: #fff;
            font: 700 clamp(1.5rem, 5vw, 1.85rem) var(--display);
            cursor: pointer;
            box-shadow: 0 8px 0 var(--ink);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin: 10px auto 18px;
            min-height: 44px;
            transition: transform .1s ease, box-shadow .1s ease;
        }
        .big:active { transform: translateY(6px); box-shadow: 0 2px 0 var(--ink); }
        .bar {
            height: clamp(14px, 2vw, 18px);
            border: 3px solid var(--ink);
            border-radius: 99px;
            overflow: hidden;
            background: #fff;
        }
        .bar i { display: block; height: 100%; width: 0; background: var(--mint); transition: width .25s ease; }

        /* Fullscreen view */
        body.fs { overflow: hidden; }
        body.fs #app { position: fixed; inset: 0; z-index: 50; overflow: hidden; }
        body.fs header, body.fs .tabs, body.fs .about, body.fs footer, body.fs .panel > :not(.display):not(.msg) { display: none !important; }
        body.fs [data-ad-slot] { display: none !important; } /* ad slots never appear in fullscreen mode */
        body.fs .stage { height: 100vh; height: 100dvh; max-width: none; display: flex; flex-direction: column; justify-content: center; padding: 0; pointer-events: none; }
        body.fs .panel { background: none; border: 0; box-shadow: none; backdrop-filter: none; padding: 0; }
        body.fs .display { font-size: clamp(8rem, 42vmin, 34rem); }

        /* Fullscreen Game mode — counting number/letter is unmistakably the BIGGEST element */
        body.fs.game .stage { justify-content: flex-start; padding-top: 2.5vh; }
        body.fs.game .display {
            font-size: clamp(7.5rem, 32vmin, 24rem);
            margin-bottom: 4px;
            text-shadow: 0 clamp(6px, 1.4vw, 10px) 0 var(--ink);
            filter: drop-shadow(0 4px 14px rgba(43,29,74,0.12));
        }

        #fsbar {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 10;
            display: none;
            justify-content: center;
            gap: clamp(8px, 2vw, 14px);
            padding: 12px 14px calc(12px + env(safe-area-inset-bottom, 0px));
        }
        #mini {
            position: fixed;
            right: 12px;
            bottom: calc(12px + env(safe-area-inset-bottom, 0px));
            z-index: 10;
            display: none;
            gap: 8px;
        }
        #mini .pill { opacity: .6; padding: 6px 12px; }
        #mini .pill:hover { opacity: 1; }
        body.fs #fsbar { display: flex; }
        body.fs.hideui #fsbar { display: none; }
        body.fs.hideui #mini { display: flex; }

        .about {
            max-width: 880px;
            margin: 0 auto;
            padding: 20px clamp(12px, 3vw, 24px) 50px;
        }
        .about h2 { font: 600 clamp(1.6rem, 3.8vw, 2rem) var(--display); margin: 34px 0 12px; }
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
            gap: 16px;
        }
        .card, details {
            background: var(--card);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border: 3px solid var(--ink);
            border-radius: 22px;
            padding: clamp(12px, 2.5vw, 18px);
        }
        .card h3 { font: 600 1.25rem var(--display); margin: 0 0 6px; }
        .card p, details p { margin: 0; font-weight: 600; line-height: 1.55; }
        details { margin-bottom: 10px; border-radius: 18px; }
        summary { cursor: pointer; font-weight: 800; }
        details p { margin-top: 8px; }
        footer {
            text-align: center;
            padding: 10px clamp(12px, 3vw, 24px) 40px;
            font-weight: 600;
        }
        footer a { color: inherit; }
    </style>

    <div id="app">
        <div id="sky" aria-hidden="true"></div>

        <header>
            <a class="brand" href="/suna">
                <img src="/assets/suna-icon.svg" alt="Suna — The Counter mascot" width="42" height="42" />
                <span>Suna <small data-i="sub">The Counter</small></span>
            </a>
            <a class="pill" href="/" title="Home" aria-label="Home">
                <svg class="ic" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
