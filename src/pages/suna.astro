---
// /suna — "Suna – The Counter": immersive full-screen counting app.
// Auto-count (teacher) mode is primary; tally mode one tap away.
// Speech uses the Web Speech API (speechSynthesis) — no backend, no mic,
// no account. `bare` layout: no site nav/footer, no page scroll.
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { breadcrumbListJsonLd, faqJsonLd } from '../lib/seo';

const PATH = '/suna';
const TITLE = 'Suna: Free Online Counter with Voice';
const DESCRIPTION =
    'Suna is a free online counter that counts out loud. Set any range and let it auto-count 1 to 100 for your class, or tap to tally — no app, no signup.';
const KEYWORDS =
    'online counter, free online counter, tally counter, counter with voice, count aloud, classroom counter, suna counter, digital counter, count to 100';

const SUNA_FAQS = [
    {
        question: 'What is Suna – The Counter?',
        answer: 'Suna is a free online counter from Free Kids Worksheets. It works as a tap-to-tally counter and as an auto-counting teacher tool that reads numbers aloud in a voice you choose. It runs entirely in your browser — nothing to install and no account needed.',
    },
    {
        question: 'How does the voice counting work?',
        answer: 'Your browser reads each number aloud using its built-in voices. Pick any installed voice from the dropdown, adjust the speed, and press play. Voices vary by device — phones, tablets and computers each ship their own set.',
    },
    {
        question: 'Can I use Suna as a classroom counting tool?',
        answer: 'Yes — that is what auto-count mode is for. Set any range (for example 1 to 50), choose a clear voice, and press play. Each number appears huge on screen while it is spoken, so the whole class can follow along.',
    },
    {
        question: 'Does the tally counter save my count?',
        answer: 'Your current count is saved in this browser automatically, so a refresh or a closed tab will not lose it. Clearing your browser data will reset it.',
    },
    {
        question: 'Is Suna free? Do I need an account?',
        answer: 'Completely free, no account, no download. Open the page and start counting.',
    },
    {
        question: 'Can I count by 2s, 5s or 10s?',
        answer: 'Yes. In tally mode, choose a step size of 1, 2, 5 or 10. You can also set a target number and watch the progress bar fill as you count toward it.',
    },
];

const webAppJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Suna – The Counter',
    url: 'https://freekidworksheets.com/suna',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: DESCRIPTION,
    inLanguage: 'en',
};
---

<Base
    pageTitle={TITLE}
    description={DESCRIPTION}
    path={PATH}
    keywords={KEYWORDS}
    bare
    jsonLd={[
        webAppJsonLd,
        breadcrumbListJsonLd([{ name: 'Home', url: '/' }, { name: 'Suna – The Counter' }]),
        faqJsonLd(SUNA_FAQS),
    ]}
>
    <div id="suna-app" class="flex h-dvh flex-col overflow-hidden">
        <!-- ===== app header ===== -->
        <header class="flex shrink-0 items-center justify-between gap-2 px-4 py-3">
            <div class="flex items-center gap-2.5">
                <img
                    src="/assets/suna-icon.svg"
                    alt="Suna — the counting buddy"
                    class="h-11 w-11"
                    width="44"
                    height="44"
                />
                <div class="leading-tight">
                    <p class="text-base font-bold tracking-tight text-ink dark:text-neutral-100">Suna</p>
                    <p class="text-[11px] text-mute dark:text-neutral-500">The Counter</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <a
                    href="https://pairpaint.com"
                    target="_blank"
                    rel="noopener"
                    class="hidden items-center gap-1.5 rounded-full border border-hairline bg-elevated px-3 py-2 text-xs font-semibold text-body transition-colors hover:bg-neutral-100 sm:inline-flex dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
                    title="Open pairPaint — free kids drawing app"
                >
                    <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 4 6 6-10 10H4v-6z"/><path d="m12 6 6 6"/></svg>
                    pairPaint
                </a>
                <button
                    type="button"
                    id="suna-fullscreen"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="Toggle fullscreen"
                    title="Fullscreen"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
                </button>
                <button
                    type="button"
                    id="suna-info-open"
                    class="grid h-9 w-9 place-items-center rounded-full border border-hairline bg-elevated text-mute transition-colors hover:bg-neutral-100 hover:text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
                    aria-label="How to use Suna"
                    title="How to use"
                >
                    <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 1 1 3.6 2.4c-.9.4-1.1 1-1.1 1.8"/><path d="M12 17h.01"/></svg>
                </button>
            </div>
        </header>

        <!-- ===== mode switch ===== -->
        <div class="flex shrink-0 justify-center" role="tablist" aria-label="Counter modes">
            <div class="inline-flex rounded-full border border-hairline bg-elevated p-1 dark:border-neutral-800 dark:bg-neutral-900">
                <button
                    type="button"
                    id="tab-auto"
                    role="tab"
                    aria-selected="true"
                    aria-controls="panel-auto"
                    class="suna-tab rounded-full px-5 py-2 text-sm font-semibold transition-colors"
                >
                    Auto-count
                </button>
                <button
                    type="button"
                    id="tab-tally"
                    role="tab"
                    aria-selected="false"
                    aria-controls="panel-tally"
                    class="suna-tab rounded-full px-5 py-2 text-sm font-semibold transition-colors"
                >
                    Tally
                </button>
            </div>
        </div>

        <!-- ===== AUTO-COUNT (primary) ===== -->
        <section
            id="panel-auto"
            role="tabpanel"
            aria-labelledby="tab-auto"
            class="flex min-h-0 flex-1 flex-col"
        >
            <div class="flex min-h-0 flex-1 flex-col items-center justify-center px-4">
                <div
                    id="auto-display"
                    class="font-mono font-bold tabular-nums text-ink select-none dark:text-neutral-100"
                    style="font-size: clamp(5rem, 26dvh, 11rem); line-height: 1;"
                    aria-live="polite"
                    aria-label="Number being spoken"
                >–</div>
                <p id="auto-status" class="mt-2 min-h-[1.5rem] text-center text-sm text-mute dark:text-neutral-500">
                    Set a range and press play.
                </p>
            </div>
            <div class="shrink-0 px-4 pb-5">
                <div class="mx-auto grid max-w-md grid-cols-[1fr_1fr_auto] items-end gap-2.5">
                    <div>
                        <label for="auto-from" class="mb-1 block text-[11px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500">From</label>
                        <input id="auto-from" type="number" value="1" min="0" max="9999"
                            class="w-full rounded-xl border border-hairline bg-elevated px-3 py-2.5 text-center text-lg font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    </div>
                    <div>
                        <label for="auto-to" class="mb-1 block text-[11px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500">To</label>
                        <input id="auto-to" type="number" value="20" min="0" max="9999"
                            class="w-full rounded-xl border border-hairline bg-elevated px-3 py-2.5 text-center text-lg font-bold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    </div>
                    <div class="flex gap-2">
                        <button type="button" id="auto-play"
                            class="rounded-xl bg-pink-600 px-6 py-2.5 text-base font-bold text-white shadow-sm transition-transform transition-colors hover:bg-pink-700 active:scale-[0.98]"
                        >▶ Play</button>
                        <button type="button" id="auto-stop" aria-label="Stop"
                            class="rounded-xl border border-hairline bg-elevated px-4 py-2.5 text-base font-bold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800"
                        >■</button>
                    </div>
                </div>
                <div class="mx-auto mt-2.5 grid max-w-md grid-cols-2 gap-2.5">
                    <select id="voice-select-auto" aria-label="Voice"
                        class="rounded-xl border border-hairline bg-elevated px-3 py-2 text-sm text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                        <option value="">Loading voices…</option>
                    </select>
                    <label class="flex items-center gap-2 rounded-xl border border-hairline bg-elevated px-3 py-2 dark:border-neutral-700 dark:bg-neutral-900">
                        <span class="text-[11px] font-medium uppercase tracking-wider text-mute dark:text-neutral-500">Speed</span>
                        <input id="auto-rate" type="range" min="0.5" max="1.5" step="0.1" value="1" class="w-full accent-pink-600" aria-label="Speaking speed" />
                        <span id="auto-rate-label" class="font-mono text-xs text-mute dark:text-neutral-500">1.0×</span>
                    </label>
                </div>
            </div>
        </section>

        <!-- ===== TALLY ===== -->
        <section
            id="panel-tally"
            role="tabpanel"
            aria-labelledby="tab-tally"
            hidden
            class="flex min-h-0 flex-1 flex-col"
        >
            <div class="flex min-h-0 flex-1 flex-col items-center justify-center px-4">
                <div
                    id="tally-display"
                    class="font-mono font-bold tabular-nums text-ink select-none dark:text-neutral-100"
                    style="font-size: clamp(5rem, 26dvh, 11rem); line-height: 1;"
                    aria-live="polite"
                    aria-label="Current count"
                >0</div>
                <div class="mt-3 w-full max-w-xs">
                    <div id="tally-progress" class="h-2 w-full overflow-hidden rounded-full bg-neutral-200 dark:bg-neutral-800"
                        role="progressbar" aria-label="Progress toward target" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div id="tally-progress-fill" class="h-full w-0 rounded-full bg-pink-500 transition-all duration-200"></div>
                    </div>
                    <p id="tally-target-label" class="mt-1.5 text-center text-xs text-mute dark:text-neutral-500">No target set</p>
                </div>
            </div>
            <div class="shrink-0 px-4 pb-5">
                <div class="mx-auto grid max-w-md grid-cols-[auto_1fr_auto] items-stretch gap-2.5">
                    <button type="button" id="tally-minus" aria-label="Subtract one step"
                        class="rounded-xl border border-hairline bg-elevated px-5 text-2xl font-bold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800">−</button>
                    <button type="button" id="tally-plus" aria-label="Add one step (or press spacebar)"
                        class="rounded-xl bg-pink-600 py-3.5 text-xl font-bold text-white shadow-sm transition-transform transition-colors hover:bg-pink-700 active:scale-[0.98]">+ Tap</button>
                    <button type="button" id="tally-reset" aria-label="Reset counter to zero"
                        class="rounded-xl border border-hairline bg-elevated px-4 text-sm font-semibold text-body transition-colors hover:bg-neutral-100 dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800">Reset</button>
                </div>
                <div class="mx-auto mt-2.5 grid max-w-md grid-cols-3 gap-2.5">
                    <select id="tally-step" aria-label="Count by"
                        class="rounded-xl border border-hairline bg-elevated px-2 py-2 text-center text-sm font-semibold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                        <option value="1" selected>1s</option>
                        <option value="2">2s</option>
                        <option value="5">5s</option>
                        <option value="10">10s</option>
                    </select>
                    <input id="tally-target" type="number" min="1" placeholder="Target"
                        aria-label="Target number"
                        class="rounded-xl border border-hairline bg-elevated px-2 py-2 text-center text-sm font-semibold text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100" />
                    <select id="voice-select" aria-label="Voice"
                        class="rounded-xl border border-hairline bg-elevated px-2 py-2 text-sm text-ink dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-100">
                        <option value="">Voices…</option>
                    </select>
                </div>
                <label class="mx-auto mt-2.5 flex max-w-md cursor-pointer items-center justify-center gap-2 text-sm text-body dark:text-neutral-400">
                    <input id="tally-speak" type="checkbox" class="h-4 w-4 accent-pink-600" />
                    Read each count aloud
                </label>
            </div>
        </section>

        <!-- ===== info overlay (how-to + FAQ; keeps content in DOM for SEO) ===== -->
        <div id="suna-info" hidden class="fixed inset-0 z-[60]">
            <div id="suna-info-backdrop" class="absolute inset-0 bg-black/50"></div>
            <div class="absolute inset-x-0 bottom-0 top-[8dvh] overflow-y-auto rounded-t-3xl border-t border-hairline bg-canvas p-6 shadow-2xl sm:inset-x-auto sm:left-1/2 sm:w-full sm:max-w-2xl sm:-translate-x-1/2 dark:border-neutral-800 dark:bg-[#111]">
                <div class="mb-4 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <img src="/assets/suna-icon.svg" alt="Suna mascot" class="h-9 w-9" width="36" height="36" />
                        <h2 class="text-lg font-bold text-ink dark:text-neutral-100">About Suna</h2>
                    </div>
                    <button type="button" id="suna-info-close"
                        class="grid h-9 w-9 place-items-center rounded-full border border-hairline text-mute hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-400 dark:hover:bg-neutral-800"
                        aria-label="Close">
                        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                    </button>
                </div>
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="rounded-xl border border-hairline bg-elevated p-4 dark:border-neutral-800 dark:bg-neutral-900">
                        <h3 class="text-sm font-semibold text-ink dark:text-neutral-100">Auto-count for class</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-body dark:text-neutral-400">Enter any range, pick a clear voice and press play. Suna recites every number with a giant display — perfect for circle time and number drills. Voices come from your device.</p>
                    </div>
                    <div class="rounded-xl border border-hairline bg-elevated p-4 dark:border-neutral-800 dark:bg-neutral-900">
                        <h3 class="text-sm font-semibold text-ink dark:text-neutral-100">Tally counter</h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-body dark:text-neutral-400">Tap the big button (or press spacebar) to count anything. Set a step size, add a target, switch on read-aloud — your count autosaves in this browser.</p>
                    </div>
                </div>
                <div class="suna-faq-slim">
                    <Faq faqs={SUNA_FAQS} heading="Counter questions, answered" />
                </div>
                <p class="mt-8 pb-4 text-center text-xs text-mute dark:text-neutral-500">
                    Suna – The Counter is part of
                    <a href="/" class="underline hover:text-pink-600">Free Kids Worksheets</a> —
                    free printables and playful learning tools for early learners.
                </p>
            </div>
        </div>
    </div>

    <style>
        .suna-tab { color: var(--color-mute, #6b7280); }
        .suna-tab[aria-selected='true'] { background: #db2777; color: #fff; }
        .suna-tab[aria-selected='false']:hover { background: rgba(0,0,0,.05); }
        .suna-faq-slim section { margin-top: 1.75rem; }
        .suna-faq-slim h2 { font-size: 1.15rem !important; }
        #suna-info[hidden] { display: none; }
    </style>

    <script>
        (function () {
            'use strict';

            /* ---------------- tabs (auto-count is primary) ---------------- */
            var tabTally = document.getElementById('tab-tally');
            var tabAuto = document.getElementById('tab-auto');
            var panelTally = document.getElementById('panel-tally');
            var panelAuto = document.getElementById('panel-auto');

            function selectTab(which) {
                var isAuto = which === 'auto';
                tabAuto.setAttribute('aria-selected', String(isAuto));
                tabTally.setAttribute('aria-selected', String(!isAuto));
                panelAuto.hidden = !isAuto;
                panelTally.hidden = isAuto;
                if (isAuto) { stopSpeech(); } else { stopAuto(); }
            }
            tabTally.addEventListener('click', function () { selectTab('tally'); });
            tabAuto.addEventListener('click', function () { selectTab('auto'); });

            /* ---------------- fullscreen ---------------- */
            var fsBtn = document.getElementById('suna-fullscreen');
            fsBtn.addEventListener('click', function () {
                try {
                    if (document.fullscreenElement) { document.exitFullscreen(); }
                    else { document.documentElement.requestFullscreen(); }
                } catch (e) {}
            });

            /* ---------------- info overlay ---------------- */
            var info = document.getElementById('suna-info');
            document.getElementById('suna-info-open').addEventListener('click', function () {
                info.hidden = false;
                document.body.style.overflow = 'hidden';
            });
            function closeInfo() {
                info.hidden = true;
                document.body.style.overflow = '';
            }
            document.getElementById('suna-info-close').addEventListener('click', closeInfo);
            document.getElementById('suna-info-backdrop').addEventListener('click', closeInfo);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !info.hidden) closeInfo();
            });

            /* ---------------- speech helpers ---------------- */
            var synth = window.speechSynthesis || null;
            var voiceSelects = [
                document.getElementById('voice-select'),
                document.getElementById('voice-select-auto'),
            ];
            var currentVoice = null;

            function englishFirst(a, b) {
                var al = (a.lang || '').toLowerCase();
                var bl = (b.lang || '').toLowerCase();
                var ae = al.indexOf('en') === 0 ? 0 : 1;
                var be = bl.indexOf('en') === 0 ? 0 : 1;
                if (ae !== be) return ae - be;
                return (a.name || '').localeCompare(b.name || '');
            }
            function allVoices() {
                if (!synth) return [];
                return synth.getVoices().slice().sort(englishFirst);
            }
            function populateVoices() {
                if (!synth) {
                    voiceSelects.forEach(function (sel) {
                        sel.innerHTML = '<option value="">No voice support</option>';
                    });
                    return;
                }
                var voices = allVoices();
                if (!voices.length) return;
                voiceSelects.forEach(function (sel) {
                    var prev = sel.value;
                    sel.innerHTML = '';
                    voices.forEach(function (v, i) {
                        var opt = document.createElement('option');
                        opt.value = String(i);
                        opt.textContent = v.name + ' (' + v.lang + ')';
                        sel.appendChild(opt);
                    });
                    sel.value = prev && voices[parseInt(prev, 10)] ? prev : '0';
                });
                syncVoiceFromSelect(voiceSelects[0]);
            }
            function syncVoiceFromSelect(sel) {
                var voices = allVoices();
                currentVoice = voices[parseInt(sel.value, 10)] || null;
                voiceSelects.forEach(function (s) {
                    if (s !== sel) s.value = sel.value;
                });
            }
            voiceSelects.forEach(function (sel) {
                sel.addEventListener('change', function () { syncVoiceFromSelect(sel); });
            });
            if (synth) {
                populateVoices();
                if (typeof synth.onvoiceschanged !== 'undefined') {
                    synth.onvoiceschanged = populateVoices;
                }
            }
            function stopSpeech() {
                if (synth) { try { synth.cancel(); } catch (e) {} }
            }
            function speakNumber(n, rate, onend) {
                if (!synth) { if (onend) onend(); return; }
                stopSpeech();
                var u = new SpeechSynthesisUtterance(String(n));
                if (currentVoice) u.voice = currentVoice;
                u.rate = rate || 1;
                u.onend = function () { if (onend) onend(); };
                u.onerror = function () { if (onend) onend(); };
                synth.speak(u);
            }

            /* ---------------- tally mode ---------------- */
            var tallyDisplay = document.getElementById('tally-display');
            var tallyStep = document.getElementById('tally-step');
            var tallyTarget = document.getElementById('tally-target');
            var tallySpeak = document.getElementById('tally-speak');
            var tallyProgress = document.getElementById('tally-progress');
            var tallyProgressFill = document.getElementById('tally-progress-fill');
            var tallyTargetLabel = document.getElementById('tally-target-label');

            var count = 0;
            try {
                var saved = localStorage.getItem('suna-tally-count');
                if (saved !== null && !isNaN(parseInt(saved, 10))) count = parseInt(saved, 10);
            } catch (e) {}

            function renderTally(announce) {
                tallyDisplay.textContent = String(count);
                try { localStorage.setItem('suna-tally-count', String(count)); } catch (e) {}
                var target = parseInt(tallyTarget.value, 10);
                if (target > 0) {
                    var pct = Math.max(0, Math.min(100, (count / target) * 100));
                    tallyProgressFill.style.width = pct + '%';
                    tallyProgress.setAttribute('aria-valuenow', String(Math.round(pct)));
                    tallyTargetLabel.textContent = count >= target ? ('Target reached: ' + target + ' 🎉') : (count + ' of ' + target);
                } else {
                    tallyProgressFill.style.width = '0%';
                    tallyProgress.setAttribute('aria-valuenow', '0');
                    tallyTargetLabel.textContent = 'No target set';
                }
                if (announce && tallySpeak.checked) speakNumber(count, 1);
            }
            function bump(dir) {
                var step = parseInt(tallyStep.value, 10) || 1;
                var before = count;
                count = Math.max(0, count + dir * step);
                var target = parseInt(tallyTarget.value, 10);
                renderTally(true);
                if (target > 0 && before < target && count >= target) {
                    setTimeout(function () { speakNumber('Target reached! ' + target, 1); }, 350);
                }
            }
            document.getElementById('tally-plus').addEventListener('click', function () { bump(1); });
            document.getElementById('tally-minus').addEventListener('click', function () { bump(-1); });
            document.getElementById('tally-reset').addEventListener('click', function () {
                stopSpeech(); count = 0; renderTally(false);
            });
            tallyTarget.addEventListener('input', function () { renderTally(false); });
            tallyStep.addEventListener('change', function () { renderTally(false); });
            document.addEventListener('keydown', function (e) {
                if (panelTally.hidden || !info.hidden) return;
                var tag = (e.target && e.target.tagName) || '';
                if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
                if (e.code === 'Space') { e.preventDefault(); bump(1); }
            });
            renderTally(false);

            /* ---------------- auto-count mode ---------------- */
            var autoDisplay = document.getElementById('auto-display');
            var autoStatus = document.getElementById('auto-status');
            var autoFrom = document.getElementById('auto-from');
            var autoTo = document.getElementById('auto-to');
            var autoPlay = document.getElementById('auto-play');
            var autoStop = document.getElementById('auto-stop');
            var autoRate = document.getElementById('auto-rate');
            var autoRateLabel = document.getElementById('auto-rate-label');

            var autoState = { playing: false, paused: false, current: 0, from: 1, to: 20 };

            autoRate.addEventListener('input', function () {
                autoRateLabel.textContent = parseFloat(autoRate.value).toFixed(1) + '×';
            });
            function setAutoStatus(msg) { autoStatus.textContent = msg; }
            function stopAuto() {
                autoState.playing = false;
                autoState.paused = false;
                stopSpeech();
                autoPlay.innerHTML = '▶ Play';
                setAutoStatus('Set a range and press play.');
            }
            function stepAuto() {
                if (!autoState.playing || autoState.paused) return;
                var n = autoState.current;
                autoDisplay.textContent = String(n);
                var total = autoState.to - autoState.from + 1;
                setAutoStatus('Counting… ' + (n - autoState.from + 1) + ' of ' + total);
                var rate = parseFloat(autoRate.value) || 1;
                speakNumber(n, rate, function () {
                    if (!autoState.playing || autoState.paused) return;
                    if (n >= autoState.to) {
                        autoState.playing = false;
                        autoPlay.innerHTML = '▶ Play';
                        setAutoStatus('Finished counting to ' + autoState.to + '. 🎉');
                        return;
                    }
                    autoState.current = n + 1;
                    stepAuto();
                });
            }
            autoPlay.addEventListener('click', function () {
                if (autoState.playing && !autoState.paused) {
                    autoState.paused = true;
                    stopSpeech();
                    autoPlay.innerHTML = '⏸ Paused — tap to resume';
                    setAutoStatus('Paused at ' + autoState.current + '.');
                    return;
                }
                if (autoState.playing && autoState.paused) {
                    autoState.paused = false;
                    autoPlay.innerHTML = '⏸ Pause';
                    stepAuto();
                    return;
                }
                var from = parseInt(autoFrom.value, 10);
                var to = parseInt(autoTo.value, 10);
                if (isNaN(from)) from = 1;
                if (isNaN(to)) to = 20;
                if (from > to) {
                    var tmp = from; from = to; to = tmp;
                    autoFrom.value = String(from);
                    autoTo.value = String(to);
                }
                if (to - from > 999) {
                    setAutoStatus('Please keep the range under 1,000 numbers.');
                    return;
                }
                autoState = { playing: true, paused: false, current: from, from: from, to: to };
                autoPlay.innerHTML = '⏸ Pause';
                stepAuto();
            });
            autoStop.addEventListener('click', stopAuto);
            document.addEventListener('visibilitychange', function () {
                if (document.hidden) {
                    stopSpeech();
                    if (autoState.playing) {
                        autoState.paused = true;
                        autoPlay.innerHTML = '⏸ Paused — tap to resume';
                    }
                }
            });
        })();
    </script>
</Base>
