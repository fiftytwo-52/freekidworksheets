            var sunaLang = 'en';
            try { sunaLang = localStorage.getItem('suna-lang') || 'en'; } catch (e) {}
            if (!SUNA_STR[sunaLang]) sunaLang = 'en';

            function T(key) {
                var v = SUNA_STR[sunaLang][key];
                if (v === undefined) v = SUNA_STR.en[key];
                return v === undefined ? key : v;
            }
            function Ts(key) {
                var v = T(key);
                var args = Array.prototype.slice.call(arguments, 1);
                return typeof v === 'function' ? v.apply(null, args) : v;
            }

            var autoStatusState = { key: 'autoReady', args: [] };
            var countStatusState = { key: 'countTapAlong', args: [] };
            var hearStatusState = { key: 'hearListen', args: [] };

            function renderStatus(el, state) {
                el.textContent = Ts.apply(null, [state.key].concat(state.args));
            }
            function setStatus(el, state, key) {
                var args = Array.prototype.slice.call(arguments, 3);
                state.key = key;
                state.args = args;
                renderStatus(el, state);
            }

            function refreshVoicePlaceholders() {
                var pairs = [
                    ['voice-select', 'voicesShort'],
                    ['voice-select-auto', 'voicesLoading'],
                    ['voice-select-play', 'voicesShort']
                ];
                pairs.forEach(function (pair) {
                    var sel = document.getElementById(pair[0]);
                    if (sel && sel.options.length === 1 && sel.options[0].value === '') {
                        sel.options[0].textContent = T(pair[1]);
                    }
                });
            }

            function applySunaLang() {
                document.querySelectorAll('[data-i18n]').forEach(function (el) {
                    var v = T(el.getAttribute('data-i18n'));
                    if (typeof v === 'string') el.textContent = v;
                });
                document.querySelectorAll('[data-i18n-ph]').forEach(function (el) {
                    var v = T(el.getAttribute('data-i18n-ph'));
                    if (typeof v === 'string') el.setAttribute('placeholder', v);
                });
                document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
                    var v = T(el.getAttribute('data-i18n-aria'));
                    if (typeof v === 'string') el.setAttribute('aria-label', v);
                });
                document.querySelectorAll('#suna-lang-flag [data-flag]').forEach(function (el) {
                    el.hidden = el.getAttribute('data-flag') !== sunaLang;
                });
                document.documentElement.setAttribute('lang', sunaLang === 'pt-br' ? 'pt-BR' : sunaLang);
                refreshVoicePlaceholders();
                renderStatus(autoStatus, autoStatusState);
                renderStatus(countStatus, countStatusState);
                renderStatus(hearStatus, hearStatusState);
                renderTally(false);
                try { localStorage.setItem('suna-lang', sunaLang); } catch (e) {}
            }

            document.querySelectorAll('[data-suna-lang]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    sunaLang = btn.getAttribute('data-suna-lang');
                    var details = document.getElementById('suna-lang-switcher');
                    if (details) details.removeAttribute('open');
                    applySunaLang();
                });
            });

            /* ---------------- fullscreen ---------------- */
            var fsBtn = document.getElementById('suna-fullscreen');
            fsBtn.addEventListener('click', function () {
                try {
                    if (document.fullscreenElement) { document.exitFullscreen(); }
                    else { document.documentElement.requestFullscreen(); }
                } catch (e) {}
            });

            /* ---------------- info overlay ---------------- */
            var info = document.getElementById('suna-info');
            document.getElementById('suna-info-open').addEventListener('click', function () {
                info.hidden = false;
                document.body.style.overflow = 'hidden';
            });
            function closeInfo() {
                info.hidden = true;
                document.body.style.overflow = '';
            }
            document.getElementById('suna-info-close').addEventListener('click', closeInfo);
            document.getElementById('suna-info-backdrop').addEventListener('click', closeInfo);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !info.hidden) closeInfo();
            });

            /* ---------------- speech helpers ---------------- */
            var synth = window.speechSynthesis || null;
            var voiceSelects = [
                document.getElementById('voice-select'),
                document.getElementById('voice-select-auto'),
                document.getElementById('voice-select-play'),
            ];
            var currentVoice = null;

            function englishFirst(a, b) {
                var al = (a.lang || '').toLowerCase();
                var bl = (b.lang || '').toLowerCase();
                var ae = al.indexOf('en') === 0 ? 0 : 1;
                var be = bl.indexOf('en') === 0 ? 0 : 1;
                if (ae !== be) return ae - be;
                return (a.name || '').localeCompare(b.name || '');
            }
            function allVoices() {
                if (!synth) return [];
                return synth.getVoices().slice().sort(englishFirst);
            }
            function populateVoices() {
                if (!synth) {
                    voiceSelects.forEach(function (sel) {
                        sel.innerHTML = '<option value="">' + T('voicesNone') + '</option>';
                    });
                    return;
                }
                var voices = allVoices();
                if (!voices.length) return;
                voiceSelects.forEach(function (sel) {
                    var prev = sel.value;
                    sel.innerHTML = '';
                    voices.forEach(function (v, i) {
                        var opt = document.createElement('option');
                        opt.value = String(i);
                        opt.textContent = v.name + ' (' + v.lang + ')';
                        sel.appendChild(opt);
                    });
                    sel.value = prev && voices[parseInt(prev, 10)] ? prev : '0';
                });
                syncVoiceFromSelect(voiceSelects[0]);
            }
            function syncVoiceFromSelect(sel) {
                var voices = allVoices();
                currentVoice = voices[parseInt(sel.value, 10)] || null;
                voiceSelects.forEach(function (s) {
                    if (s !== sel) s.value = sel.value;
                });
            }
            voiceSelects.forEach(function (sel) {
                sel.addEventListener('change', function () { syncVoiceFromSelect(sel); });
            });
            if (synth) {
                populateVoices();
                if (typeof synth.onvoiceschanged !== 'undefined') {
                    synth.onvoiceschanged = populateVoices;
                }
            }
            function stopSpeech() {
                if (synth) { try { synth.cancel(); } catch (e) {} }
            }
            function speakNumber(n, rate, onend) {
                if (!synth) { if (onend) onend(); return; }
                stopSpeech();
                var u = new SpeechSynthesisUtterance(String(n));
                if (currentVoice) u.voice = currentVoice;
                u.rate = rate || 1;
                u.onend = function () { if (onend) onend(); };
                u.onerror = function () { if (onend) onend(); };
                synth.speak(u);
            }

            /* ---------------- tally mode ---------------- */
            var tallyDisplay = document.getElementById('tally-display');
            var tallyStep = document.getElementById('tally-step');
            var tallyTarget = document.getElementById('tally-target');
            var tallySpeak = document.getElementById('tally-speak');
            var tallyProgress = document.getElementById('tally-progress');
            var tallyProgressFill = document.getElementById('tally-progress-fill');
            var tallyTargetLabel = document.getElementById('tally-target-label');

            var count = 0;
            try {
                var saved = localStorage.getItem('suna-tally-count');
                if (saved !== null && !isNaN(parseInt(saved, 10))) count = parseInt(saved, 10);
            } catch (e) {}

            function renderTally(announce) {
                tallyDisplay.textContent = String(count);
                try { localStorage.setItem('suna-tally-count', String(count)); } catch (e) {}
                var target = parseInt(tallyTarget.value, 10);
                if (target > 0) {
                    var pct = Math.max(0, Math.min(100, (count / target) * 100));
                    tallyProgressFill.style.width = pct + '%';
                    tallyProgress.setAttribute('aria-valuenow', String(Math.round(pct)));
                    tallyTargetLabel.textContent = count >= target ? Ts('targetReached', target) : Ts('progressOf', count, target);
                } else {
                    tallyProgressFill.style.width = '0%';
                    tallyProgress.setAttribute('aria-valuenow', '0');
                    tallyTargetLabel.textContent = T('noTarget');
                }
                if (announce && tallySpeak.checked) speakNumber(count, 1);
            }
            function bump(dir) {
                var step = parseInt(tallyStep.value, 10) || 1;
                var before = count;
                count = Math.max(0, count + dir * step);
                var target = parseInt(tallyTarget.value, 10);
                renderTally(true);
                if (target > 0 && before < target && count >= target) {
                    setTimeout(function () { speakNumber(Ts('targetSpoken', target), 1); }, 350);
                }
            }
            document.getElementById('tally-plus').addEventListener('click', function () { bump(1); });
            document.getElementById('tally-minus').addEventListener('click', function () { bump(-1); });
            document.getElementById('tally-reset').addEventListener('click', function () {
                stopSpeech(); count = 0; renderTally(false);
            });
            tallyTarget.addEventListener('input', function () { renderTally(false); });
            tallyStep.addEventListener('change', function () { renderTally(false); });
            document.addEventListener('keydown', function (e) {
                if (panelTally.hidden || !info.hidden) return;
                var tag = (e.target && e.target.tagName) || '';
                if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
                if (e.code === 'Space') { e.preventDefault(); bump(1); }
            });
            renderTally(false);

            /* ---------------- auto-count mode ---------------- */
            var autoDisplay = document.getElementById('auto-display');
            var autoStatus = document.getElementById('auto-status');
            var autoFrom = document.getElementById('auto-from');
            var autoTo = document.getElementById('auto-to');
            var autoPlay = document.getElementById('auto-play');
            var autoStop = document.getElementById('auto-stop');
            var autoRate = document.getElementById('auto-rate');
            var autoRateLabel = document.getElementById('auto-rate-label');

            var autoStep = document.getElementById('auto-step');
            var autoGap = document.getElementById('auto-gap');

            var autoState = { playing: false, paused: false, current: 0, from: 1, to: 20, step: 1 };

            autoRate.addEventListener('input', function () {
                autoRateLabel.textContent = parseFloat(autoRate.value).toFixed(1) + '×';
            });
            function setAutoStatus(key) {
                var args = Array.prototype.slice.call(arguments, 1);
                setStatus(autoStatus, autoStatusState, key, ...args);
            }
            function stopAuto() {
                autoState.playing = false;
                autoState.paused = false;
                stopSpeech();
                autoPlay.textContent = T('play');
                setAutoStatus('autoReady');
            }
            function stepAuto() {
                if (!autoState.playing || autoState.paused) return;
                var n = autoState.current;
                autoDisplay.textContent = String(n);
                var total = Math.ceil((autoState.to - autoState.from + 1) / autoState.step);
                var done = Math.floor((n - autoState.from) / autoState.step) + 1;
                setAutoStatus('autoCounting', done, total);
                var rate = parseFloat(autoRate.value) || 1;
                var gapMs = (parseFloat(autoGap.value) || 0) * 1000;
                speakNumber(n, rate, function () {
                    if (!autoState.playing || autoState.paused) return;
                    var next = n + autoState.step;
                    if (next > autoState.to) {
                        autoState.playing = false;
                        autoPlay.textContent = T('play');
                        setAutoStatus('autoFinished', autoState.to);
                        return;
                    }
                    autoState.current = next;
                    if (gapMs > 0) {
                        setTimeout(function () { stepAuto(); }, gapMs);
                    } else {
                        stepAuto();
                    }
                });
            }
            autoPlay.addEventListener('click', function () {
                if (autoState.playing && !autoState.paused) {
                    autoState.paused = true;
                    stopSpeech();
                    autoPlay.textContent = T('pausedResume');
                    setAutoStatus('autoPausedAt', autoState.current);
                    return;
                }
                if (autoState.playing && autoState.paused) {
                    autoState.paused = false;
                    autoPlay.textContent = T('pause');
                    stepAuto();
                    return;
                }
                var from = parseInt(autoFrom.value, 10);
                var to = parseInt(autoTo.value, 10);
                var step = parseInt(autoStep.value, 10) || 1;
                if (isNaN(from)) from = 1;
                if (isNaN(to)) to = 20;
                if (from > to) {
                    var tmp = from; from = to; to = tmp;
                    autoFrom.value = String(from);
                    autoTo.value = String(to);
                }
                if (Math.ceil((to - from + 1) / step) > 1000) {
                    setAutoStatus('autoRangeError');
                    return;
                }
                autoState = { playing: true, paused: false, current: from, from: from, to: to, step: step };
                autoPlay.textContent = T('pause');
                stepAuto();
            });
            autoStop.addEventListener('click', stopAuto);
            document.addEventListener('visibilitychange', function () {
                if (document.hidden) {
                    stopSpeech();
                    if (autoState.playing) {
                        autoState.paused = true;
                        autoPlay.textContent = T('pausedResume');
                    }
                }
            });

            /* ---------------- play: interactive tap games ---------------- */
            var playScore = 0;
            var playScoreEl = document.getElementById('play-score');
            var celebrateBox = document.getElementById('play-celebrate');
            var celebrateMsg = document.getElementById('play-celebrate-msg');
            var confettiBox = document.getElementById('play-confetti');
            var celebrateTimer = null;

            function addStar() {
                playScore++;
                playScoreEl.textContent = String(playScore);
            }

            function confettiBurst() {
                var bits = ['🎉', '⭐', '🎊', '✨', '🌟', '💛'];
                for (var i = 0; i < 26; i++) {
                    var s = document.createElement('span');
                    s.className = 'confetti-bit';
                    s.textContent = bits[Math.floor(Math.random() * bits.length)];
                    s.style.left = (Math.random() * 100) + '%';
                    s.style.animationDuration = (1.6 + Math.random() * 1.6) + 's';
                    s.style.animationDelay = (Math.random() * 0.4) + 's';
                    confettiBox.appendChild(s);
                    (function (el) {
                        setTimeout(function () { el.remove(); }, 3800);
                    })(s);
                }
            }

            function celebrate(msg) {
                celebrateMsg.textContent = msg;
                celebrateBox.hidden = false;
                // retrigger pop animation
                var card = celebrateBox.firstElementChild;
                card.classList.remove('suna-pop');
                void card.offsetWidth;
                card.classList.add('suna-pop');
                confettiBurst();
                speakNumber(msg, 1);
                if (celebrateTimer) clearTimeout(celebrateTimer);
                celebrateTimer = setTimeout(function () {
                    celebrateBox.hidden = true;
                }, 2100);
            }

            /* sub-tabs */
            var playModeCount = document.getElementById('play-mode-count');
            var playModeHear = document.getElementById('play-mode-hear');
            var playCountWrap = document.getElementById('play-count-wrap');
            var playHearWrap = document.getElementById('play-hear-wrap');

            function setSubTab(el, on) {
                el.className = 'play-subtab rounded-full px-4 py-1.5 text-xs font-bold transition-colors ' +
                    (on ? 'bg-pink-600 text-white' : 'text-mute dark:text-neutral-400');
            }

            function selectPlayMode(which) {
                var isCount = which === 'count';
                setSubTab(playModeCount, isCount);
                setSubTab(playModeHear, !isCount);
                playCountWrap.hidden = !isCount;
                playHearWrap.hidden = isCount;
                stopSpeech();
                if (isCount) newCountRound(); else newHearRound();
            }
            playModeCount.addEventListener('click', function () { selectPlayMode('count'); });
            playModeHear.addEventListener('click', function () { selectPlayMode('hear'); });

            /* game 1: tap & count the objects */
            var OBJECTS = ['🍎', '🍌', '🍇', '🍊', '🍉', '🐶', '🐱', '🐰', '🦁', '🐘', '⭐', '🎈', '🐠', '🦋'];
            var countGrid = document.getElementById('play-count-grid');
            var countStatus = document.getElementById('play-count-status');
            var countTarget = 0, countTapped = 0, countLock = false;

            function setCountStatus(key) {
                var args = Array.prototype.slice.call(arguments, 1);
                setStatus(countStatus, countStatusState, key, ...args);
            }
            function setHearStatus(key) {
                var args = Array.prototype.slice.call(arguments, 1);
                setStatus(hearStatus, hearStatusState, key, ...args);
            }

            function newCountRound() {
                stopSpeech();
                countLock = false;
                countTarget = 3 + Math.floor(Math.random() * 6); // 3..8
                countTapped = 0;
                var emoji = OBJECTS[Math.floor(Math.random() * OBJECTS.length)];
                countGrid.innerHTML = '';
                for (var i = 0; i < countTarget; i++) {
                    (function () {
                        var b = document.createElement('button');
                        b.type = 'button';
                        b.className = 'play-obj';
                        b.textContent = emoji;
                        b.setAttribute('aria-label', T('countMe'));
                        b.addEventListener('click', function () {
                            if (countLock || b.classList.contains('tapped')) return;
                            b.classList.add('tapped');
                            countTapped++;
                            if (countTapped >= countTarget) {
                                countLock = true;
                                setCountStatus('countDone', countTarget);
                                addStar();
                                setTimeout(function () { celebrate(Ts('celebrateCounted', countTarget)); }, 250);
                                setTimeout(newCountRound, 2600);
                            } else {
                                setCountStatus('countKeepGoing', countTapped);
                                speakNumber(countTapped, 1.1);
                            }
                        });
                        countGrid.appendChild(b);
                    })();
                }
                setCountStatus('countTapAlong');
            }
            document.getElementById('play-count-next').addEventListener('click', newCountRound);

            /* game 2: hear the number, tap it */
            var hearOptions = document.getElementById('play-hear-options');
            var hearStatus = document.getElementById('play-hear-status');
            var hearAnswer = 0, hearLock = false;

            function shuffle(arr) {
                for (var i = arr.length - 1; i > 0; i--) {
                    var j = Math.floor(Math.random() * (i + 1));
                    var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
                }
                return arr;
            }

            function newHearRound() {
                stopSpeech();
                hearLock = false;
                hearAnswer = 1 + Math.floor(Math.random() * 10); // 1..10
                var pool = [];
                for (var n = 1; n <= 10; n++) { if (n !== hearAnswer) pool.push(n); }
                // prefer near-miss distractors so it teaches, not guesses
                pool.sort(function (a, b) {
                    return Math.abs(a - hearAnswer) - Math.abs(b - hearAnswer);
                });
                var options = shuffle([hearAnswer, pool[0], pool[1]]);
                hearOptions.innerHTML = '';
                options.forEach(function (num) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'play-opt text-ink dark:text-neutral-100 bg-elevated dark:bg-neutral-900';
                    b.textContent = String(num);
                    b.setAttribute('aria-label', Ts('numberN', num));
                    b.addEventListener('click', function () {
                        if (hearLock) return;
                        if (num === hearAnswer) {
                            hearLock = true;
                            b.classList.add('correct');
                            addStar();
                            setTimeout(function () { celebrate(Ts('celebrateCorrect', hearAnswer)); }, 200);
                            setTimeout(newHearRound, 2400);
                        } else {
                            b.classList.remove('wrong');
                            void b.offsetWidth;
                            b.classList.add('wrong');
                            setHearStatus('hearTryAgain');
                            speakNumber(T('spokenTryAgain'), 1);
                        }
                    });
                    hearOptions.appendChild(b);
                });
                setHearStatus('hearListen');
                setTimeout(function () {
                    if (!panelPlay.hidden && !playHearWrap.hidden && !hearLock) speakNumber(hearAnswer, 0.95);
                }, 600);
            }
            document.getElementById('play-hear-replay').addEventListener('click', function () {
                if (!hearLock) speakNumber(hearAnswer, 0.95);
            });
            document.getElementById('play-hear-next').addEventListener('click', newHearRound);

            // start the default play game when the tab first opens
            var playStarted = false;
            tabPlay.addEventListener('click', function () {
                if (!playStarted) { playStarted = true; newCountRound(); }
            });

            // apply saved language (also re-renders all dynamic statuses)
            applySunaLang();
        })();
    </script>
</Base>
