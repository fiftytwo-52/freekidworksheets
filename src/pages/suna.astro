        <AdSlot name="suna-below-stage" minHeight="120px" />

        <section class="about">
            <div class="cards">
                <div class="card">
                    <h3>Auto-count for class</h3>
                    <p>Choose Numbers or Alphabet, pick a range and press play. Suna goes fullscreen and says every number or letter on a giant display. Turn on Shapes to see that many objects (or pictures for the letter) float across the screen.</p>
                </div>
                <div class="card">
                    <h3>Game mode</h3>
                    <p>Switch on Game and pictures or numbers float around the screen. When Suna shows 21, kids tap the 21; when it shows A, they tap the apple.</p>
                </div>
                <div class="card">
                    <h3>Tally counter</h3>
                    <p>Tap the big button (or press spacebar) to count anything. Set a step, add a target, switch on read-aloud. Your count saves in this browser.</p>
                </div>
            </div>
            <h2>Counter questions, answered</h2>
            {SUNA_FAQS.map((faq) => (
                <details>
                    <summary>{faq.question}</summary>
                    <p>{faq.answer}</p>
                </details>
            ))}
