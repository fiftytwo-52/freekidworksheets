                    fsBtn: 'पूर्ण स्क्रिन', infoBtn: 'Suna कसरी प्रयोग गर्ने', restoreBtn: 'नियन्त्रण फेरि देखाऊ',
                    countMe: 'मलाई गन',
                    numberN: function (n) { return 'सङ्ख्या ' + n; }
                },
                'pt-br': {
                    subtitle: 'O Contador',
                    tabAuto: 'Contagem auto', tabTally: 'Contador', tabPlay: '🎮 Jogar',
                    from: 'De', to: 'Até', step: 'Passo', gap: 'Pausa',
                    play: '▶ Tocar', pause: '⏸ Pausar', pausedResume: '⏸ Pausado — toque para continuar',
                    stop: 'Parar', voice: 'Voz', speed: 'Velocidade',
                    autoReady: 'Defina um intervalo e aperte o play.',
                    autoCounting: function (d, t) { return 'Contando… ' + d + ' de ' + t; },
                    autoPausedAt: function (n) { return 'Pausado em ' + n + '.'; },
                    autoFinished: function (n) { return 'Contagem até ' + n + ' concluída! 🎉'; },
                    autoRangeError: 'Use um intervalo menor que 1.000 números.',
                    autoDisplay: 'Número sendo falado', tallyDisplay: 'Contagem atual',
                    tallyMinus: 'Diminuir um passo', tallyPlus: 'Aumentar um passo (ou espaço)', tallyReset: 'Zerar o contador',
                    reset: 'Zerar', targetPh: 'Meta', readAloud: 'Falar cada contagem',
                    noTarget: 'Sem meta',
                    targetReached: function (n) { return 'Meta alcançada: ' + n + ' 🎉'; },
                    targetSpoken: function (n) { return 'Meta alcançada! ' + n; },
                    progressOf: function (c, t) { return c + ' de ' + t; },
                    voicesLoading: 'Carregando vozes…', voicesShort: 'Vozes…', voicesNone: 'Sem voz',
                    playCount: 'Toque e conte', playHear: 'Ouça e toque',
                    newRound: 'Nova rodada ↻', hearAgain: '🔊 Ouvir de novo', skip: 'Pular →',
                    countTapAlong: 'Toque em cada um e conte junto!',
                    countKeepGoing: function (t) { return 'Continue… ' + t + ' tocados'; },
                    countDone: function (n) { return 'Você contou até ' + n + '! 🎉'; },
                    hearListen: 'Ouça… e toque no número que ouviu!',
                    hearTryAgain: 'Ops — tente de novo! Ouça…',
                    spokenTryAgain: 'Tente de novo!',
                    celebrateCounted: function (n) { return 'Demais! Você contou até ' + n + '!'; },
                    celebrateCorrect: function (n) { return 'Certo! Era o ' + n + '!'; },
                    aboutSuna: 'Sobre o Suna',
                    howAutoH: 'Contagem automática para a aula',
                    howAutoP: 'Digite um intervalo, escolha uma voz clara e aperte o play. O Suna recita cada número em tela cheia — perfeito para a rodinha e treinos de números. As vozes vêm do seu aparelho.',
                    howTallyH: 'Contador manual',
                    howTallyP: 'Toque no botão grande (ou aperte espaço) para contar qualquer coisa. Escolha o passo, defina uma meta, ative a leitura em voz alta — sua contagem é salva neste navegador.',
                    homeBtn: 'Voltar à página inicial', cleanBtn: 'Ocultar controles',
                    fsBtn: 'Tela cheia', infoBtn: 'Como usar o Suna', restoreBtn: 'Mostrar controles',
                    countMe: 'Conte comigo',
                    numberN: function (n) { return 'Número ' + n; }
