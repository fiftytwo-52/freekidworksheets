                    if (timeoutTimer) clearTimeout(timeoutTimer);
                    if (activeAudio === a) activeAudio = null;
                    resolve(ok);
                }

                a.onended = function () { finish(true); };
                a.onerror = function () { finish(false); };

                // If playback was stopped while audio is loading or playing, abort immediately
                checkInterval = setInterval(function () {
                    if (!playing || done) {
                        finish(false);
                    }
                }, 60);

                timeoutTimer = setTimeout(function () { finish(true); }, 2500);

                var playPromise = a.play();
                if (playPromise !== undefined) {
                    playPromise.catch(function () { finish(false); });
                }
            });
        }

        window.__sunaUtterance = null;
        async function speak(raw) {
            var vChoice = voiceSel ? voiceSel.value : 'mp3-female';
            if (vChoice === 'mp3-female' || vChoice === 'mp3-male') {
                var gender = vChoice === 'mp3-male' ? 'male' : 'female';
                var langTag = lang === 'ne' ? 'ne' : lang === 'pt' ? 'pt' : 'en';
                var played = await playMp3(langTag, gender, raw);
                if (played) return;
            }

            // Fallback to SpeechSynthesis if mp3 not available or device voice chosen
            return new Promise(function (res) {
                if (!window.speechSynthesis) return res();
                try {
                    if (speechSynthesis.paused) speechSynthesis.resume();
                } catch (e) {}

                var v = (voiceSel && voiceSel.value !== '' && voiceSel.value !== 'default' && voiceSel.value.indexOf('mp3') < 0) ? voices[+voiceSel.value] : null;
                var spokenTxt = textToSpeak(raw, v);

                var u = new SpeechSynthesisUtterance(spokenTxt);
                window.__sunaUtterance = u;

                if (v) {
                    u.voice = v;
                    u.lang = v.lang || (lang === 'pt' ? 'pt-BR' : (lang === 'ne' ? 'ne-NP' : 'en-US'));
                } else {
                    u.lang = lang === 'ne' ? 'ne-NP' : (lang === 'pt' ? 'pt-BR' : 'en-US');
                }
                var speedVal = +$('speed').value;
                u.rate = speedVal > 0 ? speedVal : 1;
                u.pitch = 1.0;
                u.volume = 1.0;

                var finished = false;
                function done() {
                    if (finished) return;
                    finished = true;
                    window.__sunaUtterance = null;
                    res();
                }

                u.onend = done;
                u.onerror = done;

                var maxWait = Math.max(1200, (String(spokenTxt).length * 280) / u.rate + 800);
                setTimeout(done, maxWait);

                try {
                    speechSynthesis.speak(u);
                } catch (err) {
                    done();
                }
            });
        }

        $('testVoiceBtn').onclick = async function () {
            var vChoice = voiceSel ? voiceSel.value : 'mp3-female';
            if (vChoice === 'mp3-female' || vChoice === 'mp3-male') {
                var gender = vChoice === 'mp3-male' ? 'male' : 'female';
                var langTag = lang === 'ne' ? 'ne' : lang === 'pt' ? 'pt' : 'en';
                var ok = await playMp3(langTag, gender, 1);
                if (ok) return;
            }

            if (!window.speechSynthesis) {
                alert(lang === 'ne' ? 'यो ब्राउजरमा आवाज सुविधा उपलब्ध छैन।' : 'Speech synthesis is not supported on this browser.');
                return;
            }
            try {
                speechSynthesis.resume();
                if (speechSynthesis.speaking) speechSynthesis.cancel();
            } catch (e) {}
            var v = (voiceSel && voiceSel.value !== '' && voiceSel.value !== 'default' && voiceSel.value.indexOf('mp3') < 0) ? voices[+voiceSel.value] : null;
            var sample = lang === 'ne'
                ? (isDevaVoice(v) ? 'एक, दुई, तीन' : '1, 2, 3')
                : (lang === 'pt' ? 'Um, dois, três' : 'One, two, three');
            speak(sample);
        };

        function show(t) {
            disp.textContent = t;
            disp.classList.toggle('long', String(t).length > 2);
            disp.classList.remove('pop');
            void disp.offsetWidth;
            disp.classList.add('pop');
        }
        function chipVal(id) {
            var active = document.querySelector('#' + id + ' [aria-pressed=true]');
            return active ? +active.textContent : 1;
        }

        ['by', 'step', 'kind'].forEach(function (id) {
            $(id).addEventListener('click', function (e) {
                var b = e.target.closest('button');
                if (!b) return;
                this.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b); });
                if (id === 'kind') {
                    kind = b.dataset.k;
                    $('numRange').hidden = kind !== 'num';
                    $('abcRange').hidden = kind !== 'abc';
                }
            });
        });
        function getGapMs() {
            var g = (kind === 'abc') ? $('aGap') : $('gap');
            if (!g) g = $('gap') || $('aGap');
            var v = g ? parseFloat(g.value) : 1500;
            return isNaN(v) ? 1500 : v;
        }
        function setGapMs(val) {
            var str = String(val);
            if ($('gap')) $('gap').value = str;
            if ($('aGap')) $('aGap').value = str;
            try { localStorage.setItem('suna-gap', str); } catch (e) {}
        }
        if ($('gap')) $('gap').addEventListener('change', function () { setGapMs(this.value); });
        if ($('aGap')) $('aGap').addEventListener('change', function () { setGapMs(this.value); });
        try {
            var savedGap = localStorage.getItem('suna-gap');
            if (savedGap !== null) setGapMs(savedGap);
        } catch (e) {}

        $('speed').oninput = function () { $('spv').textContent = (+this.value).toFixed(1) + '×'; };

        /* ---- fullscreen ---- */
        function enterFS() {
            document.body.classList.add('fs');
            document.body.classList.remove('hideui');
            document.body.classList.toggle('game', gameOn);
            var el = $('app');
            try { (el.requestFullscreen || el.webkitRequestFullscreen || function () {}).call(el); } catch (e) {}
        }
        function leaveFS() {
            document.body.classList.remove('fs', 'hideui', 'game');
            if (document.fullscreenElement || document.webkitFullscreenElement) {
                try { (document.exitFullscreen || document.webkitExitFullscreen || function () {}).call(document); } catch (e) {}
            }
        }
        /* ---- BGM (Background Music) manager with smooth ambient synth ---- */
        var BGM = (function () {
            var ctx = null;
            var timer = null;
            var currentTrack = 'off';
            var volume = 0.3;
            var masterGain = null;
            var step = 0;
            var isPlaying = false;

            var TRACKS = {
                deepfocus: {
                    bpm: 52,
                    waveform: 'sine',
                    attack: 0.28,
                    decay: 1.1,
                    cutoff: 880,
                    gain: 0.16,
                    pattern: [
                        [-7, 0, 4, 7],
                        [-5, 2, 5, 9],
                        [-8, -1, 4, 7],
                        [-3, 0, 4, 7],
                        [-7, 0, 7, 12],
                        [-5, 4, 7, 11],
                        [-8, 2, 7, 9],
                        [-3, 0, 9, 12]
                    ]
                },
                peaceful: {
                    bpm: 46,
                    waveform: 'sine',
                    attack: 0.35,
                    decay: 1.3,
                    cutoff: 750,
                    gain: 0.15,
                    pattern: [
                        [0, 7, 12],
                        [4, 9, 16],
                        [2, 7, 14],
                        [-5, 2, 7],
                        [0, 4, 11],
                        [5, 9, 14],
                        [2, 7, 12],
                        [-3, 4, 9]
                    ]
                },
                zen: {
                    bpm: 38,
                    waveform: 'sine',
                    attack: 0.42,
                    decay: 1.6,
                    cutoff: 640,
                    gain: 0.14,
                    pattern: [
                        [-12, 0, 7],
                        [-5, 7, 14],
                        [-12, 4, 11],
                        [-7, 5, 12],
                        [-12, 2, 9],
                        [-5, 0, 7]
                    ]
                },
                lofi: {
                    bpm: 68,
                    waveform: 'sine',
                    attack: 0.08,
                    decay: 0.55,
                    cutoff: 1050,
                    gain: 0.16,
                    pattern: [
                        [0, 4, 7, 11], [-12], [7], [-12],
                        [-3, 0, 4, 9], [-15], [4], [-15],
                        [-5, -1, 2, 7], [-17], [2], [-17],
                        [-7, -3, 0, 5], [-19], [0], [-19]
                    ]
                },
                marimba: {
                    bpm: 104,
                    waveform: 'sine',
                    attack: 0.01,
                    decay: 0.24,
                    cutoff: 2400,
                    gain: 0.18,
                    pattern: [
                        [0], [4], [7], [12], [9], [7], [4], [2],
                        [0], [7], [9], [14], [12], [9], [7], [4]
                    ]
                },
                musicbox: {
                    bpm: 82,
                    waveform: 'sine',
                    attack: 0.01,
                    decay: 0.6,
                    cutoff: 3200,
                    gain: 0.15,
                    pattern: [
                        [12], [16], [19], [24], [19], [16],
                        [14], [17], [21], [26], [21], [17],
                        [12], [16], [19], [24], [19], [16],
                        [11], [14], [17], [23], [17], [14]
                    ]
                }
            };

            function initContext() {
                if (!ctx) {
                    ctx = new (window.AudioContext || window.webkitAudioContext)();
                    masterGain = ctx.createGain();
                    masterGain.gain.value = volume;
                    masterGain.connect(ctx.destination);
                }
                if (ctx.state === 'suspended') {
                    ctx.resume();
                }
            }

            function playStep() {
                var track = TRACKS[currentTrack];
                if (!track || !track.pattern || !track.pattern.length) return;
                initContext();

                var notes = track.pattern[step % track.pattern.length];
                step++;
                var decay = track.decay || 0.35;
                var attack = track.attack || 0.02;
                var targetGain = track.gain || 0.16;

                var filter = ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(track.cutoff || 1400, ctx.currentTime);
                filter.connect(masterGain);

                notes.forEach(function (n) {
                    try {
                        var o = ctx.createOscillator();
                        var g = ctx.createGain();
                        o.type = track.waveform || 'sine';
                        o.frequency.setValueAtTime(261.63 * Math.pow(2, n / 12), ctx.currentTime);

                        var now = ctx.currentTime;
                        g.gain.setValueAtTime(0.0001, now);
                        g.gain.linearRampToValueAtTime(targetGain, now + attack);
                        g.gain.exponentialRampToValueAtTime(0.0001, now + attack + decay);

                        o.connect(g);
                        g.connect(filter);

                        o.start(now);
                        o.stop(now + attack + decay + 0.05);
                    } catch (e) {}
                });
            }

            function startTimer() {
                stopTimer();
                var track = TRACKS[currentTrack];
                if (!track) return;
                var intervalMs = (60 / (track.bpm || 100)) * 500;
                timer = setInterval(playStep, intervalMs);
                playStep();
            }

            function stopTimer() {
                if (timer) {
                    clearInterval(timer);
                    timer = null;
                }
                step = 0;
            }

            function updateUI() {
                var btn = $('bgmTestBtn');
                var label = $('bgmTestLabel');
                var fsBtn = $('bgmFsBtn');
                if (label) label.textContent = isPlaying ? (T().bgmStop || 'Stop') : (T().bgmPlay || 'Play');
                if (btn) {
                    btn.setAttribute('aria-pressed', String(isPlaying));
                    var icon = $('bgmTestIcon');
                    if (icon) {
                        icon.innerHTML = isPlaying
                            ? '<rect x="6" y="6" width="12" height="12" rx="1.5"></rect>'
                            : '<polygon points="6 4 20 12 6 20 6 4"></polygon>';
                    }
                }
                if (fsBtn) {
                    fsBtn.setAttribute('aria-pressed', String(isPlaying));
                    fsBtn.style.background = isPlaying ? 'var(--mint)' : '';
                    fsBtn.style.color = isPlaying ? '#143d35' : '';
                }
            }

            return {
                setTrack: function (t) {
                    currentTrack = t;
                    try { localStorage.setItem('suna-bgm-track', t); } catch (e) {}
                    if (currentTrack === 'off') {
                        this.stop();
                    } else if (isPlaying) {
                        this.start();
                    }
                },
                getTrack: function () {
                    return currentTrack;
                },
                setVolume: function (v) {
                    volume = Math.max(0, Math.min(1, v));
                    if (masterGain) masterGain.gain.value = volume;
                    try { localStorage.setItem('suna-bgm-vol', volume); } catch (e) {}
                },
                start: function () {
                    if (currentTrack === 'off') return;
                    initContext();
                    isPlaying = true;
                    startTimer();
                    updateUI();
                },
                pause: function () {
                    stopTimer();
                    updateUI();
                },
                resume: function () {
                    if (isPlaying && currentTrack !== 'off') {
                        initContext();
                        startTimer();
                        updateUI();
                    }
                },
                stop: function () {
                    isPlaying = false;
                    stopTimer();
                    updateUI();
                },
                toggle: function () {
                    if (isPlaying) {
                        this.stop();
                    } else {
                        if (currentTrack === 'off') {
                            currentTrack = 'deepfocus';
                            if ($('bgmTrack')) $('bgmTrack').value = 'deepfocus';
                            try { localStorage.setItem('suna-bgm-track', 'deepfocus'); } catch (e) {}
                        }
                        this.start();
                    }
                },
                isPlaying: function () {
                    return isPlaying;
                }
            };
        })();

        if ($('bgmTrack')) {
            $('bgmTrack').onchange = function () {
                BGM.setTrack(this.value);
            };
        }
        if ($('bgmVol')) {
            $('bgmVol').oninput = function () {
                var v = +this.value;
                BGM.setVolume(v);
                $('bgmVolVal').textContent = Math.round(v * 100) + '%';
            };
        }
        if ($('bgmTestBtn')) {
            $('bgmTestBtn').onclick = function () {
                BGM.toggle();
            };
        }
        if ($('bgmFsBtn')) {
            $('bgmFsBtn').onclick = function () {
                BGM.toggle();
            };
        }

        try {
            var savedBgmTrack = localStorage.getItem('suna-bgm-track') || 'off';
            if ($('bgmTrack')) $('bgmTrack').value = savedBgmTrack;
            BGM.setTrack(savedBgmTrack);
            var savedBgmVol = parseFloat(localStorage.getItem('suna-bgm-vol'));
            if (!isNaN(savedBgmVol) && $('bgmVol')) {
                $('bgmVol').value = savedBgmVol;
                $('bgmVolVal').textContent = Math.round(savedBgmVol * 100) + '%';
                BGM.setVolume(savedBgmVol);
            }
        } catch (e) {}

        function stop() {
            run++;
            playing = false;
            paused = false;
            updatePauseIcon();
            if (activeAudio) {
                try {
                    activeAudio.pause();
                    activeAudio.currentTime = 0;
                } catch (e) {}
                activeAudio = null;
            }
            if (window.speechSynthesis) speechSynthesis.cancel();
            BGM.stop();
            leaveFS();
            sky.innerHTML = '';
            if (mode !== 'tally') { msg.textContent = T().hint; }
        }

        function updatePauseIcon() {
            var btn = $('pauseBtn');
            if (!btn) return;
            btn.innerHTML = paused
                ? '<svg class="ic" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>'
                : '<svg class="ic" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect></svg>';
            btn.setAttribute('aria-label', paused ? 'Resume' : 'Pause');
        }

        document.addEventListener('fullscreenchange', function () {
            if (!document.fullscreenElement && document.body.classList.contains('fs')) stop();
        });
        $('stopBtn').onclick = stop;
        $('exitMini').onclick = stop;
        $('pauseBtn').onclick = function () {
            paused = !paused;
            updatePauseIcon();
            if (activeAudio) {
                try {
                    if (paused) activeAudio.pause();
                    else activeAudio.play();
                } catch (e) {}
            }
            if (window.speechSynthesis) {
                paused ? speechSynthesis.pause() : speechSynthesis.resume();
            }
            paused ? BGM.pause() : BGM.resume();
        };
        $('hideBtn').onclick = function () { document.body.classList.add('hideui'); };
        $('showui').onclick = function () { document.body.classList.remove('hideui'); };

        async function play() {
            var id = ++run, items = [];
            paused = false;
            updatePauseIcon();
            if (window.speechSynthesis) {
                try {
                    speechSynthesis.resume();
                    if (speechSynthesis.speaking) speechSynthesis.cancel();
                } catch (e) {}
            }
            BGM.start();
            if (kind === 'abc') {
                items = letters().slice(+$('aFrom').value, +$('aTo').value + 1);
            } else {
                var f = +$('from').value, to = +$('to').value, by = chipVal('by');
                for (var n = f; n <= to && items.length < 2000; n += by) items.push(n);
            }
            if (!items.length) return;
            playing = true;
            enterFS();
            for (var i = 0; i < items.length && run === id; i++) {
                var it = items[i];
                show(kind === 'abc' ? it : num(it));
                lastV = it;

                if (gameOn) {
                    game(it);
                    msg.textContent = kind === 'abc' ? T().ga : T().gn;
                } else {
                    msg.textContent = '';
                    if (shapesOn) objects(it); else sky.innerHTML = '';
                }

                await speak(it);
                if (run !== id) return;

                // Dynamic gap countdown responding immediately to changes
                var waitMs = getGapMs();
                if (waitMs <= 0 && gameOn) waitMs = 800; // minimum game reaction time

                var elapsed = 0;
                while (elapsed < waitMs && run === id) {
                    while (paused && run === id) await wait(100);
                    await wait(100);
                    elapsed += 100;
                    waitMs = getGapMs();
                    if (waitMs <= 0 && gameOn) waitMs = 800;
                }
                if (run !== id) return;
            }
            if (run === id) {
                await wait(1200);
                if (run === id) { stop(); }
            }
        }
        $('play').onclick = play;

        /* ---- tally ---- */
        var count = 0;
        try { count = +localStorage.getItem('suna-count') || 0; } catch (e) {}
        function tallyShow() {
            show(num(count));
            view(count);
            var tg = +$('target').value;
            $('prog').style.width = tg > 0 ? Math.min(100, count / tg * 100) + '%' : '0';
            try { localStorage.setItem('suna-count', count); } catch (e) {}
        }
        function add(d) {
            count = Math.max(0, count + d);
            tallyShow();
            if ($('say').getAttribute('aria-pressed') === 'true') {
                if (window.speechSynthesis) {
                    try {
                        speechSynthesis.resume();
                        if (speechSynthesis.speaking) speechSynthesis.cancel();
                    } catch (e) {}
                }
                speak(count);
            }
        }
        $('tap').onclick = function () { add(chipVal('step')); };
        $('undo').onclick = function () { add(-chipVal('step')); };
        $('reset').onclick = function () { count = 0; tallyShow(); };
        $('say').onclick = function () {
            var curr = this.getAttribute('aria-pressed') === 'true';
            this.setAttribute('aria-pressed', String(!curr));
            if (!curr && window.speechSynthesis) {
                try { speechSynthesis.resume(); } catch (e) {}
            }
        };
        $('target').oninput = tallyShow;
        document.addEventListener('keydown', function (e) {
            if (mode === 'tally' && e.code === 'Space' && !/INPUT|SELECT|BUTTON/.test(e.target.tagName)) {
                e.preventDefault();
                add(chipVal('step'));
            }
            if (document.body.classList.contains('fs') && e.key === 'Escape') stop();
        });

        document.querySelectorAll('.tabs button').forEach(function (b) {
            b.onclick = function () {
                run++;
                playing = false;
                if (window.speechSynthesis) speechSynthesis.cancel();
                mode = b.dataset.m;
                document.querySelectorAll('.tabs button').forEach(function (x) { x.setAttribute('aria-selected', x === b); });
                $('autoCtl').hidden = mode === 'tally';
                $('tallyCtl').hidden = mode !== 'tally';
                sky.innerHTML = '';
                if (mode === 'tally') {
                    tallyShow();
                    msg.textContent = '';
                } else {
                    show('–');
                    msg.textContent = T().hint;
                }
            };
        });

        applyLang();
    </script>
</Base>
