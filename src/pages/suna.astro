        .suna-tab { transition: all 0.3s ease; }
        .suna-tab[aria-selected='false']:hover { background: rgba(0,0,0,.05); }
        .suna-faq-slim section { margin-top: 1.75rem; }
        .suna-faq-slim h2 { font-size: 1.15rem !important; }
        #suna-info[hidden] { display: none; }
        /* clean display mode: only the big number stays */
        #suna-app.suna-clean header,
        #suna-app.suna-clean .suna-tabs,
        #suna-app.suna-clean .suna-controls { display: none !important; }
        /* shapes: tappable icon groups matching the spoken number */
        #auto-shapes:empty { display: none; }
        .suna-shape {
            padding: 0;
            background: none;
            border: none;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
            animation: suna-burst 0.3s ease backwards, suna-float var(--float-dur, 4.2s) ease-in-out infinite;
            animation-delay: var(--burst-delay, 0s), var(--float-delay, 0s);
            transition: transform 0.3s ease;
        }
        .suna-shape:hover { transform: scale(1.12); }
        .suna-shape svg { display: block; filter: drop-shadow(0 2px 3px rgba(0,0,0,0.15)); }
        .suna-shape.falling { animation: suna-fall-hide 0.55s ease-in forwards; pointer-events: none; }
        @keyframes suna-burst { from { transform: scale(0); } to { transform: scale(1); } }
        @keyframes suna-float {
            0%, 100% { translate: 0 0; }
            50% { translate: 0 -12px; }
        }
        @keyframes suna-fall-hide {
            to { transform: translateY(70dvh) rotate(20deg); opacity: 0; }
        }
        @media (prefers-reduced-motion: reduce) {
            .suna-shape { animation: suna-burst 0.3s ease backwards; }
            .suna-shape.falling { animation: suna-fall-hide 0.01s forwards; }
        }
