                var hi = Math.max(+$('from').value, +$('to').value, 12);
                var pool = [];
                for (var x = Math.max(1, lo); x <= hi; x++) if (x !== v) pool.push(x);
                items = shuffle(shuffle(pool).slice(0, 5).concat([v])).map(function (x) {
                    return { h: '<span class="tile-letter solo">' + num(x) + '</span>', tile: 1, ok: x === v };
                });
            } else {
                // Alphabet game: floating tiles where images/pictures are prominently larger than the letters
                var pool = letters().filter(function (l) { return l !== v; });
                var picks = shuffle(pool).slice(0, 5).concat([v]);
                items = shuffle(picks).map(function (l) {
                    var w = words(l);
                    var icon = w.length ? pic(w[0].e) : '';
                    var content = icon
                        ? '<span class="tile-pic">' + icon + '</span><span class="tile-letter">' + l + '</span>'
                        : '<span class="tile-letter solo">' + l + '</span>';
                    return {
                        h: content,
                        tile: 1,
                        ok: l === v
                    };
                });
            }
            items.forEach(function (it) {
                it.fn = function (el) {
                    if (el.classList.contains('ok') || el.classList.contains('fall')) return;
                    if (!it.ok) {
                        el.classList.add('wrong');
                        beep(180, .25);
                        return;
                    }
                    beep(660, .12);
