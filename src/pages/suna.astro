            function selectTab(which) {
                var tabs = { auto: [tabAuto, panelAuto], tally: [tabTally, panelTally], play: [tabPlay, panelPlay] };
                Object.keys(tabs).forEach(function (k) {
                    var on = k === which;
                    tabs[k][0].setAttribute('aria-selected', String(on));
                    tabs[k][1].hidden = !on;
                });
                stopSpeech();
                if (which !== 'auto') stopAuto();
