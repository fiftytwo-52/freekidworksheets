# Build-time only environment placeholders (see postdev.md for the launch plan).
# All values here are "empty-safe": with them unset the site builds and runs fine.

# Canonical base URL — used for canonical/OG/sitemap links.
# Production domain: https://freekidworksheets.com
SITE_URL=https://freekidworksheets.com

# Site name / domain (constant).
SITE_NAME=freekidworksheets.com

# Google AdSense publisher id — bare numeric id (code auto-prefixes "pub-").
ADSENSE_PUBLISHER_ID=6972199969440681

# Google Analytics measurement id.
GA_ID=G-FMLYPZZFLQ

# Public contact email.
CONTACT_EMAIL=gun-yes@proton.me
