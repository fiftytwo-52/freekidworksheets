# Build-time only environment placeholders (see postdev.md for the launch plan).
# All values here are "empty-safe": with them unset the site builds and runs fine.

# Canonical base URL — used for canonical/OG/sitemap links.
# Real domain (https://freekidworksheet.com) is set POST-DEVELOPMENT.
SITE_URL=http://localhost:4321

# Site name / domain (constant).
SITE_NAME=freekidworksheet.com

# Google AdSense publisher id — empty until AdSense is enabled (postdev.md).
# Format: the full "pub-XXXXXXXXXXXXXXXX" id.
ADSENSE_PUBLISHER_ID=

# Google Analytics measurement id — empty until GA is enabled (postdev.md).
GA_ID=

# Public contact email — empty until real contact details are added (postdev.md).
CONTACT_EMAIL=
