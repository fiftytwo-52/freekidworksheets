{
    "name": "freekidworksheet",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Free Kid Worksheets — free printable worksheet library for kids (static Astro + Tailwind v4).",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "check": "astro check",
        "build": "astro build",
        "preview": "astro preview",
        "preview:pages": "wrangler pages dev dist --port 4322",
        "deploy": "npm run build && wrangler pages deploy dist --project-name=freekidworksheet --commit-dirty=true",
        "verify": "node tests/verify.mjs",
        "postbuild": "npm run verify"
    },
    "engines": {
        "node": ">=18.17.1"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.10",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^5.18.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "wrangler": "^4.129.0"
    }
}