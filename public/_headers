# noindex for the *.pages.dev preview/production-subdomain host so search
# engines never index it as duplicate content. The _middleware.js also sets
# this header for ALL *.pages.dev hosts (per-deployment previews included),
# since _headers can only match paths, not hostnames.
https://freekidworksheet.pages.dev/*
  X-Robots-Tag: noindex

# Revalidate HTML on the production domain so every Pages deployment is
# visible immediately (the zone-level Cache Rule otherwise pins cached HTML
# for 7 days with s-maxage=604800). Hashed static assets are unaffected in
# practice — their URLs are unique per build and revalidation is cheap.
https://freekidworksheets.com/*
  Cache-Control: no-cache
  